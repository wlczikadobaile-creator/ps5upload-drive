+size_t cloud_prune(const char *const *stamps, size_t n, size_t keep, size_t *del) {
+    /* the newer of two stamps sorts after it: count, for each, how many are newer */
+    size_t out = 0;
+    for (size_t i = 0; i < n; i++) {
+        size_t newer = 0;
+        for (size_t j = 0; j < n; j++) {
+            int c = strcmp(stamps[j], stamps[i]);
+            if (c > 0 || (c == 0 && j > i)) newer++;
+        }
+        if (newer >= keep) del[out++] = i;
+    }
+    /* oldest first */
+    for (size_t i = 1; i < out; i++) {
+        size_t v = del[i], j = i;
+        while (j > 0 && strcmp(stamps[del[j - 1]], stamps[v]) > 0) {
+            del[j] = del[j - 1];
+            j--;
+        }
+        del[j] = v;
+    }
+    return out;
+}
