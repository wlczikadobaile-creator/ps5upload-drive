+    struct stat st;
+    char *b;
+    ssize_t k;
+    if (fd < 0) return NULL;
+    if (fstat(fd, &st) != 0 || st.st_size < 0 || st.st_size > 512 * 1024) {
+        close(fd);
+        return NULL;
+    }
+    b = malloc((size_t)st.st_size + 1);
+    if (!b) {
+        close(fd);
+        return NULL;
+    }
+    k = read(fd, b, (size_t)st.st_size);
+    close(fd);
+    if (k < 0) {
+        free(b);
+        return NULL;
+    }
+    b[k] = '\0';
+    *n = (size_t)k;
+    return b;
+}
+
+/* Writes `len` bytes as `path` through a temporary file renamed over it. */
+static int write_atomic(const char *path, const char *data, size_t len) {
+    char tmp[P];
+    int fd, rc = -1;
+    snprintf(tmp, sizeof tmp, "%s.tmp", path);
+    fd = open(tmp, O_WRONLY | O_CREAT | O_TRUNC, 0600);
+    if (fd < 0) return -1;
+    if (write(fd, data, len) == (ssize_t)len && fsync(fd) == 0) rc = 0;
+    close(fd);
+    if (rc == 0 && rename(tmp, path) != 0) rc = -1;
+    if (rc != 0) unlink(tmp);
+    return rc;
+}
+
+/* ---- settings and state ---- */
+
+static int clampi(int v, int lo, int hi) { return v < lo ? lo : v > hi ? hi : v; }
+
+static void settings_load(void) {
+    size_t n = 0;
+    char *b = read_small(CLOUD_SETTINGS_PATH, &n);
+    uint64_t v;
+    int on;
+    if (!b) return;
+    pthread_mutex_lock(&g_mu);
+    if (webui_json_bool(b, n, "enabled", &on) == 1) g_set.enabled = on;
+    if (webui_json_u64(b, n, "interval_min", &v) == 1) g_set.interval_min = clampi((int)(v > 10080 ? 10080 : v), 5, 1440);
+    if (webui_json_u64(b, n, "keep_cloud", &v) == 1) g_set.keep_cloud = clampi((int)(v > 100 ? 100 : v), 1, 100);
+    if (webui_json_u64(b, n, "keep_local", &v) == 1) g_set.keep_local = clampi((int)(v > 50 ? 50 : v), 1, 50);
+    pthread_mutex_unlock(&g_mu);
+    free(b);
+}
+
+/* With g_mu held. */
+static int settings_save_locked(void) {
+    char b[256];
+    int n = snprintf(b, sizeof b, "{\"enabled\":%s,\"interval_min\":%d,\"keep_cloud\":%d,\"keep_local\":%d}\n",
+                     g_set.enabled ? "true" : "false", g_set.interval_min, g_set.keep_cloud, g_set.keep_local);
+    (void)mkdir_p(CLOUD_DIR);
+    return write_atomic(CLOUD_SETTINGS_PATH, b, (size_t)n);
+}
+
+static void state_load(void) {
+    size_t n = 0;
+    char *b = read_small(CLOUD_STATE_PATH, &n), *line, *save = NULL;
+    if (!b) return;
+    pthread_mutex_lock(&g_mu);
+    for (line = strtok_r(b, "\n", &save); line && g_nentries < MAX_ENTRIES; line = strtok_r(NULL, "\n", &save)) {
+        entry_t e;
+        char stamp[32];
+        unsigned long long cf, lf;
+        memset(&e, 0, sizeof e);
+        if (sscanf(line, "%8s %9s %llx %llx %31s", e.user, e.title, &cf, &lf, stamp) != 5) continue;
+        if (!cloud_user_ok(e.user) || !cloud_title_ok(e.title)) continue;
+        e.cloud_fp = cf;
+        e.local_fp = lf;
+        if (cloud_stamp_ok(stamp)) snprintf(e.local_stamp, sizeof e.local_stamp, "%s", stamp);
+        g_entries[g_nentries++] = e;
+    }
+    pthread_mutex_unlock(&g_mu);
+    free(b);
+}
+
+static void state_save(void) {
+    size_t cap = (size_t)MAX_ENTRIES * 80, at = 0;
+    char *b = malloc(cap);
+    if (!b) return;
+    pthread_mutex_lock(&g_mu);
+    for (size_t i = 0; i < g_nentries && at + 80 < cap; i++) {
+        const entry_t *e = &g_entries[i];
+        at += (size_t)snprintf(b + at, cap - at, "%s %s %016llx %016llx %s\n", e->user, e->title,
+                               (unsigned long long)e->cloud_fp, (unsigned long long)e->local_fp,
+                               e->local_stamp[0] ? e->local_stamp : "-");
+    }
+    pthread_mutex_unlock(&g_mu);
+    (void)mkdir_p(CLOUD_DIR);
+    if (write_atomic(CLOUD_STATE_PATH, b, at) != 0) fprintf(stderr, "cloud: could not save %s\n", CLOUD_STATE_PATH);
+    free(b);
+}
+
+/* A copy of the entry for user/title (zeroed and added when there is none). With g_mu held. */
+static entry_t *entry_locked(const char *user, const char *title) {
+    for (size_t i = 0; i < g_nentries; i++)
+        if (strcmp(g_entries[i].user, user) == 0 && strcmp(g_entries[i].title, title) == 0) return &g_entries[i];
+    if (g_nentries >= MAX_ENTRIES) return NULL;
+    memset(&g_entries[g_nentries], 0, sizeof g_entries[0]);
+    snprintf(g_entries[g_nentries].user, sizeof g_entries[0].user, "%s", user);
+    snprintf(g_entries[g_nentries].title, sizeof g_entries[0].title, "%s", title);
+    return &g_entries[g_nentries++];
+}
+
+/* ---- the saves on the console ---- */
+
+static void live_path(char *out, size_t cap, const char *user, int kind, const char *title) {
+    snprintf(out, cap, HOME_ROOT "/%s/%s%s/%s", user, cloud_kinds[kind], cloud_kind_is_meta(kind) ? "/user" : "",
+             title);
+}
+
+static void title_dir(char *out, size_t cap, const char *user, const char *title) {
+    snprintf(out, cap, CLOUD_BACKUP_ROOT "/%s/%s", user, title);
+}
+
+/* Adds every file below `dir` to the fingerprint (`rel` its path inside the save). */
+static void fp_walk(const char *dir, const char *rel, int depth, uint64_t *sum, uint64_t *count) {
+    DIR *d = opendir(dir);
+    struct dirent *de;
+    if (!d) return;
+    while ((de = readdir(d)) != NULL) {
+        char p[P], r[P];
+        struct stat st;
+        if (!strcmp(de->d_name, ".") || !strcmp(de->d_name, "..")) continue;
+        if (snprintf(p, sizeof p, "%s/%s", dir, de->d_name) >= (int)sizeof p ||
+            snprintf(r, sizeof r, "%s/%s", rel, de->d_name) >= (int)sizeof r || lstat(p, &st) != 0)
+            continue;
+        if (S_ISDIR(st.st_mode)) {
+            if (depth > 0) fp_walk(p, r, depth - 1, sum, count);
+        } else if (S_ISREG(st.st_mode)) {
+            *sum += cloud_fp_part(r, (uint64_t)st.st_size, (int64_t)st.st_mtime);
+            (*count)++;
+        }
+    }
+    closedir(d);
+}
+
+/* The save's fingerprint across its folders (`mask`: which kinds it has); 0 when it holds no file. */
+static uint64_t fingerprint(const char *user, const char *title, unsigned mask) {
+    uint64_t sum = 0, count = 0;
+    for (int k = 0; k < CLOUD_KINDS; k++) {
+        char p[P];
+        if (!(mask & (1u << k))) continue;
+        live_path(p, sizeof p, user, k, title);
+        fp_walk(p, cloud_kinds[k], WALK_DEPTH, &sum, &count);
+    }
+    if (!count) return 0;
+    return sum + count * 0x9e3779b97f4a7c15ull;
+}
+
+static int copy_tree(const char *src, const char *dst, int depth) {
+    DIR *d;
+    struct dirent *de;
+    int rc = 0;
+    if (mkdir(dst, 0777) != 0 && errno != EEXIST) return -1;
+    d = opendir(src);
+    if (!d) return -1;
+    while (rc == 0 && (de = readdir(d)) != NULL) {
+        char s[P], t[P];
+        struct stat st;
+        if (!strcmp(de->d_name, ".") || !strcmp(de->d_name, "..")) continue;
+        if (snprintf(s, sizeof s, "%s/%s", src, de->d_name) >= (int)sizeof s ||
+            snprintf(t, sizeof t, "%s/%s", dst, de->d_name) >= (int)sizeof t || lstat(s, &st) != 0) {
+            rc = -1;
+            break;
+        }
+        if (S_ISDIR(st.st_mode)) {
+            if (depth > 0) rc = copy_tree(s, t, depth - 1);
+        } else if (S_ISREG(st.st_mode)) {
+            rc = fsj_copy_atomic(s, t, NULL) == 0 ? 0 : -1;
+        }
+    }
+    closedir(d);
+    return rc;
+}
+
+/* The local copy: see cloud_sync.h, step 1. `stamp` (CLOUD_STAMP_LEN + 1) and *fp are the copy's. */
+static int snapshot(const char *user, const char *title, unsigned mask, uint64_t *fp, char *stamp, char *err,
+                    size_t ecap) {
+    char tdir[P], part[P], final[P];
+    title_dir(tdir, sizeof tdir, user, title);
+    say(err, ecap, "the copy could not be made");
+    for (int attempt = 0; attempt < SNAP_TRIES; attempt++) {
+        uint64_t f1 = fingerprint(user, title, mask), f3;
+        time_t now = time(NULL);
+        int ok = 1;
+        sleep(QUIET_S);
+        if (fingerprint(user, title, mask) != f1) {
+            say(err, ecap, "the game kept saving");
+            continue;
+        }
+        for (int i = 0; i < 60; i++, now++) {
+            if (cloud_stamp(stamp, CLOUD_STAMP_LEN + 1, now) != 0) return -1;
+            snprintf(final, sizeof final, "%s/%s" CLOUD_SYNC_SUFFIX, tdir, stamp);
+            if (!is_dir(final)) break;
+        }
+        snprintf(part, sizeof part, "%s/.%s" CLOUD_SYNC_SUFFIX ".part", tdir, stamp);
+        rm_rf(part);
+        if (mkdir_p(part) != 0) {
+            say(err, ecap, "cannot make %s", part);
+            return -1;
+        }
+        for (int k = 0; k < CLOUD_KINDS && ok; k++) {
+            char live[P], dst[P];
+            if (!(mask & (1u << k))) continue;
+            live_path(live, sizeof live, user, k, title);
+            snprintf(dst, sizeof dst, "%s/%s", part, cloud_kinds[k]);
+            if (copy_tree(live, dst, WALK_DEPTH) != 0) ok = 0;
+        }
+        f3 = fingerprint(user, title, mask);
+        if (!ok || f3 != f1) {
+            rm_rf(part);
+            say(err, ecap, "%s", ok ? "the game saved while it was copied" : "a file could not be copied");
+            continue;
+        }
+        if (rename(part, final) != 0) {
+            rm_rf(part);
+            say(err, ecap, "rename: %s", strerror(errno));
+            return -1;
+        }
+        *fp = f1;
+        return 0;
+    }
+    return -1;
+}
+
+/* Every "_sync" backup of the title on the console; their stamps (malloc'd array of strings). */
+static size_t local_stamps(const char *user, const char *title, char (*out)[CLOUD_STAMP_LEN + 1], size_t max,
+                           int clean_parts) {
+    char tdir[P];
+    DIR *d;
+    struct dirent *de;
+    size_t n = 0;
+    title_dir(tdir, sizeof tdir, user, title);
+    d = opendir(tdir);
+    if (!d) return 0;
+    while ((de = readdir(d)) != NULL) {
+        size_t l = strlen(de->d_name);
+        if (n < max && cloud_local_name_stamp(de->d_name, out[n], sizeof out[n]) == 0) {
+            n++;
+        } else if (clean_parts && de->d_name[0] == '.' && l > 5 && strcmp(de->d_name + l - 5, ".part") == 0 &&
+                   strstr(de->d_name, CLOUD_SYNC_SUFFIX)) {
+            /* a copy a stopped helper left half-made (an hour old: never one being written now, by
+             * the other thread's fetch) */
+            char p[P];
+            struct stat st;
+            if (snprintf(p, sizeof p, "%s/%s", tdir, de->d_name) < (int)sizeof p && stat(p, &st) == 0 &&
+                time(NULL) - st.st_mtime > 3600)
+                rm_rf(p);
+        }
+    }
+    closedir(d);
+    return n;
+}
+
+static void prune_local(const char *user, const char *title, int keep) {
+    char (*st)[CLOUD_STAMP_LEN + 1] = malloc(256 * sizeof *st);
+    const char *ptr[256];
+    size_t del[256], n, k;
+    if (!st) return;
+    n = local_stamps(user, title, st, 256, 1);
+    for (size_t i = 0; i < n; i++) ptr[i] = st[i];
+    k = cloud_prune(ptr, n, (size_t)keep, del);
+    for (size_t i = 0; i < k; i++) {
+        char tdir[P], p[P];
+        title_dir(tdir, sizeof tdir, user, title);
+        snprintf(p, sizeof p, "%s/%s" CLOUD_SYNC_SUFFIX, tdir, st[del[i]]);
+        rm_rf(p);
+    }
+    free(st);
+}
+
+/* ---- tar ---- */
+
+static int tar_write_tree(FILE *f, const char *dir, const char *rel, int depth, uint8_t *hdr, uint8_t *buf) {
+    DIR *d = opendir(dir);
+    struct dirent *de;
+    int rc = 0;
+    if (!d) return -1;
+    while (rc == 0 && (de = readdir(d)) != NULL) {
+        char p[P], r[P];
+        struct stat st;
+        size_t hl;
+        if (!strcmp(de->d_name, ".") || !strcmp(de->d_name, "..")) continue;
+        if (snprintf(p, sizeof p, "%s/%s", dir, de->d_name) >= (int)sizeof p ||
+            snprintf(r, sizeof r, "%s/%s", rel, de->d_name) >= (int)sizeof r || lstat(p, &st) != 0)
+            return closedir(d), -1;
+        if (S_ISDIR(st.st_mode)) {
+            if (depth <= 0) continue;
+            hl = wf_tar_header(hdr, WF_TAR_HEADER_MAX, r, 1, 0, (unsigned)st.st_mode & 07777, (uint64_t)st.st_mtime);
+            if (!hl || fwrite(hdr, 1, hl, f) != hl) rc = -1;
+            else rc = tar_write_tree(f, p, r, depth - 1, hdr, buf);
+        } else if (S_ISREG(st.st_mode)) {
+            uint64_t left = (uint64_t)st.st_size, pad;
+            FILE *in = fopen(p, "rb");
+            if (!in) {
+                rc = -1;
+                break;
+            }
+            hl = wf_tar_header(hdr, WF_TAR_HEADER_MAX, r, 0, left, (unsigned)st.st_mode & 07777, (uint64_t)st.st_mtime);
+            if (!hl || fwrite(hdr, 1, hl, f) != hl) rc = -1;
+            while (rc == 0 && left) {
+                size_t want = left < 65536 ? (size_t)left : 65536, got = fread(buf, 1, want, in);
+                if (got == 0) {
+                    /* it shrank: zeros up to the size the header gave */
+                    memset(buf, 0, want);
+                    got = want;
+                }
+                if (fwrite(buf, 1, got, f) != got) rc = -1;
+                left -= got;
+            }
+            fclose(in);
+            pad = (512 - ((uint64_t)st.st_size % 512)) % 512;
+            memset(buf, 0, 512);
+            if (rc == 0 && pad && fwrite(buf, 1, (size_t)pad, f) != pad) rc = -1;
+        }
+    }
+    closedir(d);
+    return rc;
+}
+
+/* The local backup folder `dir` (holding <kind>/ folders) as the tar `out`. */
+static int tar_dir(const char *dir, const char *out) {
+    uint8_t *hdr = malloc(WF_TAR_HEADER_MAX), *buf = malloc(65536);
+    FILE *f = NULL;
+    int rc = -1;
+    if (!hdr || !buf) goto done;
+    f = fopen(out, "wb");
+    if (!f) goto done;
+    rc = 0;
+    for (int k = 0; k < CLOUD_KINDS && rc == 0; k++) {
+        char p[P];
+        struct stat st;
+        size_t hl;
+        snprintf(p, sizeof p, "%s/%s", dir, cloud_kinds[k]);
+        if (stat(p, &st) != 0 || !S_ISDIR(st.st_mode)) continue;
+        hl = wf_tar_header(hdr, WF_TAR_HEADER_MAX, cloud_kinds[k], 1, 0, 0777, (uint64_t)st.st_mtime);
+        if (!hl || fwrite(hdr, 1, hl, f) != hl) rc = -1;
+        else rc = tar_write_tree(f, p, cloud_kinds[k], WALK_DEPTH, hdr, buf);
+    }
+    memset(buf, 0, 1024);
+    if (rc == 0 && fwrite(buf, 1, 1024, f) != 1024) rc = -1;
+    if (fflush(f) != 0 || fsync(fileno(f)) != 0) rc = -1;
+done:
+    if (f && fclose(f) != 0) rc = -1;
+    if (rc != 0) unlink(out);
+    free(hdr);
+    free(buf);
+    return rc;
+}
+
+/* Unpacks the tar `path` (written by tar_dir) into the folder `dest`. Only <kind>/... entries. */
+static int untar(const char *path, const char *dest, char *err, size_t ecap) {
+    FILE *f = fopen(path, "rb");
+    uint8_t h[512];
+    uint8_t *buf = malloc(65536);
+    char name[P], pax[P], full[P];
+    int rc = -1, have_pax = 0;
+    if (!f || !buf) {
+        say(err, ecap, "cannot read the download");
+        goto done;
+    }
+    for (;;) {
+        uint64_t size, pad;
+        int kind;
+        if (fread(h, 1, 512, f) != 512) {
+            say(err, ecap, "the backup is cut short");
+            goto done;
+        }
+        kind = cloud_tar_parse(h, name, sizeof name, &size);
+        if (kind == CLOUD_TAR_END) break;
+        if (kind < 0) {
+            say(err, ecap, "the backup is damaged");
+            goto done;
+        }
+        pad = (512 - size % 512) % 512;
+        if (kind == CLOUD_TAR_PAX) {
+            char *data;
+            if (size > 65536) {
+                say(err, ecap, "the backup is damaged");
+                goto done;
+            }
+            data = (char *)buf;
+            if (fread(data, 1, (size_t)(size + pad), f) != size + pad) {
+                say(err, ecap, "the backup is cut short");
+                goto done;
+            }
+            have_pax = cloud_tar_pax_path(data, (size_t)size, pax, sizeof pax) == 1;
+            continue;
+        }
+        if (have_pax) {
+            snprintf(name, sizeof name, "%s", pax);
+            have_pax = 0;
+        }
+        if (!cloud_tar_name_ok(name) || snprintf(full, sizeof full, "%s/%s", dest, name) >= (int)sizeof full) {
+            say(err, ecap, "the backup holds an unexpected entry");
+            goto done;
+        }
+        if (kind == CLOUD_TAR_DIR) {
+            if (mkdir_p(full) != 0) {
+                say(err, ecap, "cannot make %s", full);
+                goto done;
+            }
+            continue;
+        }
+        if (kind == CLOUD_TAR_FILE) {
+            char parent[P];
+            char *slash;
+            int fd;
+            uint64_t left = size;
+            snprintf(parent, sizeof parent, "%s", full);
+            slash = strrchr(parent, '/');
+            if (slash) {
+                *slash = '\0';
+                (void)mkdir_p(parent);
+            }
+            fd = open(full, O_WRONLY | O_CREAT | O_TRUNC, 0600);
+            if (fd < 0) {
+                say(err, ecap, "cannot write %s: %s", full, strerror(errno));
+                goto done;
+            }
+            while (left) {
+                size_t want = left < 65536 ? (size_t)left : 65536;
+                if (fread(buf, 1, want, f) != want || write(fd, buf, want) != (ssize_t)want) {
+                    close(fd);
+                    say(err, ecap, "the backup is cut short");
+                    goto done;
+                }
+                left -= want;
+            }
+            if (fsync(fd) != 0) {
+                close(fd);
+                say(err, ecap, "write: %s", strerror(errno));
+                goto done;
+            }
+            close(fd);
+            if (pad && fread(buf, 1, (size_t)pad, f) != pad) {
+                say(err, ecap, "the backup is cut short");
+                goto done;
+            }
+            continue;
+        }
+        /* anything else: skipped */
+        if (fseeko(f, (off_t)(size + pad), SEEK_CUR) != 0) {
+            say(err, ecap, "the backup is cut short");
+            goto done;
+        }
+    }
+    rc = 0;
+done:
+    if (f) fclose(f);
+    free(buf);
+    return rc;
+}
+
+/* ---- Drive folders ---- */
+
+static void folders_forget(void) {
+    pthread_mutex_lock(&g_fmu);
+    g_nfolders = 0;
+    pthread_mutex_unlock(&g_fmu);
+}
+
+static int folder_cached(const char *key, char *id, size_t cap) {
+    int found = 0;
+    pthread_mutex_lock(&g_fmu);
+    for (size_t i = 0; i < g_nfolders; i++)
+        if (strcmp(g_folders[i].key, key) == 0) {
+            snprintf(id, cap, "%s", g_folders[i].id);
+            found = 1;
+            break;
+        }
+    pthread_mutex_unlock(&g_fmu);
+    return found;
+}
+
+static void folder_remember(const char *key, const char *id) {
+    pthread_mutex_lock(&g_fmu);
+    if (g_nfolders >= sizeof g_folders / sizeof g_folders[0]) g_nfolders = 0;
+    snprintf(g_folders[g_nfolders].key, sizeof g_folders[0].key, "%s", key);
+    snprintf(g_folders[g_nfolders].id, sizeof g_folders[0].id, "%s", id);
+    g_nfolders++;
+    pthread_mutex_unlock(&g_fmu);
+}
+
+/* The Drive folder of `user`/`title` (title NULL: the user's): 1 found or made, 0 missing (create
+ * 0), -1 failed. */
+static int drive_folder_of(const char *user, const char *title, int create, char *id, size_t cap, char *err,
+                           size_t ecap) {
+    char root[CLOUD_ID_MAX], uid[CLOUD_ID_MAX], key[20];
+    int r;
+    if (!folder_cached("", root, sizeof root)) {
+        r = cloud_drive_folder(NULL, CLOUD_ROOT_FOLDER, create, root, sizeof root, err, ecap);
+        if (r != 1) return r;
+        folder_remember("", root);
+    }
+    if (!folder_cached(user, uid, sizeof uid)) {
+        r = cloud_drive_folder(root, user, create, uid, sizeof uid, err, ecap);
+        if (r != 1) return r;
+        folder_remember(user, uid);
+    }
+    if (!title) {
+        snprintf(id, cap, "%s", uid);
+        return 1;
+    }
+    snprintf(key, sizeof key, "%s/%s", user, title);
+    if (folder_cached(key, id, cap)) return 1;
+    r = cloud_drive_folder(uid, title, create, id, cap, err, ecap);
+    if (r == 1) folder_remember(key, id);
+    return r;
+}
+
+static void prune_cloud(const char *folder, const char *title, int keep) {
+    cloud_file_t *files = malloc(MAX_LIST * sizeof *files);
+    char (*st)[CLOUD_STAMP_LEN + 1] = malloc(MAX_LIST * sizeof *st);
+    const char *ptr[MAX_LIST];
+    size_t idx[MAX_LIST], del[MAX_LIST], n = 0, m = 0, k;
+    char err[300];
+    if (!files || !st) goto out;
+    if (cloud_drive_list(folder, files, MAX_LIST, &n, err, sizeof err) != 0) goto out;
+    for (size_t i = 0; i < n; i++) {
+        if (cloud_drive_name_stamp(files[i].name, title, st[m], sizeof st[m]) != 0) continue;
+        ptr[m] = st[m];
+        idx[m++] = i;
+    }
+    k = cloud_prune(ptr, m, (size_t)keep, del);
+    for (size_t i = 0; i < k; i++)
+        if (cloud_drive_delete(files[idx[del[i]]].id, err, sizeof err) != 0)
+            fprintf(stderr, "cloud: prune %s: %s\n", files[idx[del[i]]].name, err);
+out:
+    free(files);
+    free(st);
+}
+
+/* Sends the local backup <stamp>_sync of user/title to Drive. */
+static int upload(const char *user, const char *title, const char *stamp, int keep_cloud, char *err, size_t ecap) {
+    char dir[P], tar[P], folder[CLOUD_ID_MAX], name[64];
+    int rc = -1;
+    snprintf(dir, sizeof dir, CLOUD_BACKUP_ROOT "/%s/%s/%s" CLOUD_SYNC_SUFFIX, user, title, stamp);
+    snprintf(tar, sizeof tar, CLOUD_TMP_DIR "/up-%s-%s.tar", user, title);
+    if (cloud_drive_name(name, sizeof name, title, stamp) != 0) return -1;
+    (void)mkdir_p(CLOUD_TMP_DIR);
+    if (tar_dir(dir, tar) != 0) {
+        say(err, ecap, "could not pack the copy");
+        return -1;
+    }
+    if (drive_folder_of(user, title, 1, folder, sizeof folder, err, ecap) != 1) goto out;
+    if (cloud_drive_upload(folder, name, tar, NULL, err, ecap) != 0) {
+        /* the folder may have been deleted on Drive: look it up again next time */
+        folders_forget();
+        goto out;
+    }
+    prune_cloud(folder, title, keep_cloud);
+    rc = 0;
+out:
+    unlink(tar);
+    return rc;
+}
+
+/* ---- the profiles file ---- */
+
+#define PROFILES_FP_PATH CLOUD_DIR "/profiles.fp"
+#define PROFILES_KEEP 30
+#define PROFILES_MAX 16
+#define PROFILES_TEXT (16u * 1024u)
+
+/* Each /user/home profile with its name, and the account slots. The Sony calls go one at a time
+ * with everyone else's (sony_api_lock.h). */
+static void read_profiles(cloud_user_t *users, size_t *nu, cloud_slot_t *slots, size_t *ns) {
+    DIR *d = opendir(HOME_ROOT);
+    struct dirent *de;
+    *nu = *ns = 0;
+    pthread_mutex_lock(&sony_api_lock);
+    while (d && (de = readdir(d)) != NULL && *nu < PROFILES_MAX) {
+        cloud_user_t *u = &users[*nu];
+        if (!cloud_user_ok(de->d_name)) continue;
+        snprintf(u->uid, sizeof u->uid, "%s", de->d_name);
+        (void)profile_user_name((uint32_t)strtoul(u->uid, NULL, 16), u->name, sizeof u->name);
+        (*nu)++;
+    }
+    for (int s = 1; s <= PROFILE_SLOT_COUNT && *ns < PROFILES_MAX; s++) {
+        cloud_slot_t *c = &slots[*ns];
+        char name[PROFILE_NAME_MAX] = "", type[PROFILE_TYPE_MAX] = "";
+        memset(c, 0, sizeof *c);
+        if (profile_slot_get_name(s, name, NULL) != 0) name[0] = '\0';
+        (void)profile_slot_get_id(s, &c->id, NULL);
+        if (!name[0] && !c->id) continue;
+        (void)profile_slot_get_type(s, type, NULL);
+        (void)profile_slot_get_flags(s, &c->flags, NULL);
+        c->slot = s;
+        snprintf(c->name, sizeof c->name, "%s", name);
+        snprintf(c->type, sizeof c->type, "%s", type);
+        (*ns)++;
+    }
+    usleep(SONY_API_POST_SLEEP_US);
+    pthread_mutex_unlock(&sony_api_lock);
+    if (d) closedir(d);
+}
+
+/* Sends PS5 Saves/perfis_<stamp>.txt when Drive has none yet or the profiles changed since the last
+ * one sent. Older ones stay (up to PROFILES_KEEP): a profile lost later is still in an older file.
+ * 1 sent, 0 nothing to do, -1 failed (`err`). */
+static int backup_profiles(char *err, size_t ecap) {
+    cloud_user_t users[PROFILES_MAX];
+    cloud_slot_t slots[PROFILES_MAX];
+    cloud_file_t *files = NULL;
+    char *text = malloc(PROFILES_TEXT), stamp[CLOUD_STAMP_LEN + 1], name[64], root[CLOUD_ID_MAX], path[P];
+    char (*st)[CLOUD_STAMP_LEN + 1] = NULL, fpbuf[24], *saved;
+    const char *ptr[MAX_LIST];
+    size_t nu, ns, len, n = 0, m = 0, idx[MAX_LIST], del[MAX_LIST], k, sn = 0;
+    uint64_t fp, last = 0;
+    int rc = -1, r;
+    if (!text) return -1;
+    read_profiles(users, &nu, slots, &ns);
+    if (!nu && !ns) {
+        rc = 0; /* nothing read: never replace a good file with an empty one */
+        goto out;
+    }
+    len = cloud_profiles_text(text, PROFILES_TEXT, NULL, users, nu, slots, ns);
+    if (len >= PROFILES_TEXT) goto out;
+    fp = cloud_fnv(text, len);
+    if ((saved = read_small(PROFILES_FP_PATH, &sn)) != NULL) {
+        last = strtoull(saved, NULL, 16);
+        free(saved);
+    }
+    r = folder_cached("", root, sizeof root) ? 1
+                                              : cloud_drive_folder(NULL, CLOUD_ROOT_FOLDER, 1, root, sizeof root, err, ecap);
+    if (r != 1) goto out;
+    folder_remember("", root);
+    files = malloc(MAX_LIST * sizeof *files);
+    st = malloc(MAX_LIST * sizeof *st);
+    if (!files || !st || cloud_drive_list(root, files, MAX_LIST, &n, err, ecap) != 0) goto out;
+    for (size_t i = 0; i < n; i++) {
+        if (cloud_profiles_name_stamp(files[i].name, st[m], sizeof st[m]) != 0) continue;
+        ptr[m] = st[m];
+        idx[m++] = i;
+    }
+    if (m && fp == last) {
+        rc = 0;
+        goto out;
+    }
+    set_phase("sending the profiles");
+    if (cloud_stamp(stamp, sizeof stamp, time(NULL)) != 0 || cloud_profiles_name(name, sizeof name, stamp) != 0) goto out;
+    len = cloud_profiles_text(text, PROFILES_TEXT, stamp, users, nu, slots, ns);
+    snprintf(path, sizeof path, CLOUD_TMP_DIR "/%s", name);
+    (void)mkdir_p(CLOUD_TMP_DIR);
+    if (len >= PROFILES_TEXT || write_atomic(path, text, len) != 0) {
+        say(err, ecap, "could not write the profiles file");
+        goto out;
+    }
+    r = cloud_drive_upload(root, name, path, NULL, err, ecap);
+    unlink(path);
+    if (r != 0) {
+        folders_forget();
+        goto out;
+    }
+    snprintf(fpbuf, sizeof fpbuf, "%016llx\n", (unsigned long long)fp);
+    (void)write_atomic(PROFILES_FP_PATH, fpbuf, strlen(fpbuf));
+    k = cloud_prune(ptr, m, PROFILES_KEEP - 1, del); /* the one just sent is the newest */
+    for (size_t i = 0; i < k; i++) (void)cloud_drive_delete(files[idx[del[i]]].id, err, ecap);
+    err[0] = '\0';
+    pthread_mutex_lock(&g_mu);
+    g_pass.profiles_at = time(NULL);
+    pthread_mutex_unlock(&g_mu);
+    rc = 1;
+out:
+    free(text);
+    free(files);
+    free(st);
+    return rc;
+}
+
+/* ---- one pass ---- */
+
+typedef struct {
+    char title[10];
+    unsigned mask;
+} title_t;
+
+/* The titles with a save of `user` and which save folders each has; meta-only titles left out. */
+static size_t user_titles(const char *user, title_t *out, size_t max) {
+    size_t n = 0;
+    for (int k = 0; k < CLOUD_KINDS; k++) {
+        char root[P];
+        DIR *d;
+        struct dirent *de;
+        snprintf(root, sizeof root, HOME_ROOT "/%s/%s%s", user, cloud_kinds[k], cloud_kind_is_meta(k) ? "/user" : "");
+        d = opendir(root);
+        if (!d) continue;
+        while ((de = readdir(d)) != NULL) {
+            size_t i;
+            if (!cloud_title_ok(de->d_name)) continue;
+            for (i = 0; i < n; i++)
+                if (strcmp(out[i].title, de->d_name) == 0) break;
+            if (i == n) {
+                if (n >= max) continue;
+                snprintf(out[n].title, sizeof out[n].title, "%s", de->d_name);
+                out[n].mask = 0;
+                n++;
+            }
+            out[i].mask |= 1u << k;
+        }
+        closedir(d);
+    }
+    /* keep those with a save folder itself (not only its details) */
+    for (size_t i = 0; i < n;) {
+        if (out[i].mask & ((1u << 0) | (1u << 2))) {
+            i++;
+        } else {
+            out[i] = out[--n];
+        }
+    }
+    return n;
+}
+
+/* One save: 1 uploaded, 0 nothing to do, -1 its copy failed, -2 the upload failed (stop the pass). */
+static int process_save(const char *user, const title_t *t, int keep_cloud, int keep_local, char *err, size_t ecap) {
+    uint64_t fp = fingerprint(user, t->title, t->mask), have_cloud, have_local;
+    char stamp[CLOUD_STAMP_LEN + 1] = "", final[P];
+    entry_t *e;
+    if (!fp) return 0;
+    pthread_mutex_lock(&g_mu);
+    e = entry_locked(user, t->title);
+    have_cloud = e ? e->cloud_fp : 0;
+    have_local = e ? e->local_fp : 0;
+    if (e) snprintf(stamp, sizeof stamp, "%s", e->local_stamp);
+    pthread_mutex_unlock(&g_mu);
+    if (!e) return 0;
+    if (have_cloud == fp) return 0;
+    snprintf(final, sizeof final, CLOUD_BACKUP_ROOT "/%s/%s/%s" CLOUD_SYNC_SUFFIX, user, t->title, stamp);
+    if (!(have_local == fp && stamp[0] && is_dir(final))) {
+        set_phase("copying %s (%s)", t->title, user);
+        if (snapshot(user, t->title, t->mask, &fp, stamp, err, ecap) != 0) return -1;
+        pthread_mutex_lock(&g_mu);
+        e = entry_locked(user, t->title);
+        if (e) {
+            e->local_fp = fp;
+            snprintf(e->local_stamp, sizeof e->local_stamp, "%s", stamp);
+        }
+        pthread_mutex_unlock(&g_mu);
+        state_save();
+        prune_local(user, t->title, keep_local);
+        if (have_cloud == fp) return 0; /* back to what is on Drive already */
+    }
+    set_phase("uploading %s (%s)", t->title, user);
+    if (upload(user, t->title, stamp, keep_cloud, err, ecap) != 0) return -2;
+    pthread_mutex_lock(&g_mu);
+    e = entry_locked(user, t->title);
+    if (e) e->cloud_fp = fp;
+    pthread_mutex_unlock(&g_mu);
+    state_save();
+    return 1;
+}
+
+static void run_pass(void) {
+    title_t *titles = malloc(MAX_TITLES * sizeof *titles);
+    char err[300] = "", first_err[300] = "";
+    int uploaded = 0, failed = 0, looked = 0, keep_cloud, keep_local, had_error, net_down = 0;
+    DIR *d;
+    struct dirent *de;
+    pthread_mutex_lock(&g_mu);
+    g_pass.running = 1;
+    keep_cloud = g_set.keep_cloud;
+    keep_local = g_set.keep_local;
+    had_error = g_pass.error[0] != '\0';
+    pthread_mutex_unlock(&g_mu);
+    set_phase("looking at the saves");
+    if (!titles) {
+        snprintf(first_err, sizeof first_err, "out of memory");
+        failed = 1;
+        goto out;
+    }
+    if (!cloud_auth_connected()) {
+        snprintf(first_err, sizeof first_err, "not signed in to Google");
+        failed = 1;
+        goto out;
+    }
+    d = opendir(HOME_ROOT);
+    if (!d) {
+        snprintf(first_err, sizeof first_err, "cannot read " HOME_ROOT ": %s", strerror(errno));
+        failed = 1;
+        goto out;
+    }
+    while ((de = readdir(d)) != NULL) {
+        char user[9];
+        size_t n;
+        int stop = 0;
+        if (!cloud_user_ok(de->d_name)) continue;
+        snprintf(user, sizeof user, "%s", de->d_name);
+        n = user_titles(user, titles, MAX_TITLES);
+        for (size_t i = 0; i < n && !stop; i++) {
+            int r;
+            looked++;
+            err[0] = '\0';
+            r = process_save(user, &titles[i], keep_cloud, keep_local, err, sizeof err);
+            if (r == 1) uploaded++;
+            if (r < 0) {
+                failed++;
+                if (!first_err[0]) snprintf(first_err, sizeof first_err, "%s: %s", titles[i].title, err);
+                fprintf(stderr, "cloud: %s/%s: %s\n", user, titles[i].title, err);
+            }
+            /* no network or no Drive: the rest would fail the same way */
+            if (r == -2) stop = 1;
+        }
+        if (stop) {
+            net_down = 1;
+            break;
+        }
+    }
+    closedir(d);
+    /* the account IDs go with the saves: without them a lost profile's backups can't be used */
+    if (!net_down) {
+        err[0] = '\0';
+        if (backup_profiles(err, sizeof err) < 0) {
+            failed++;
+            if (!first_err[0]) snprintf(first_err, sizeof first_err, "profiles: %s", err[0] ? err : "failed");
+            fprintf(stderr, "cloud: profiles: %s\n", err);
+        }
+    }
+out:
+    free(titles);
+    pthread_mutex_lock(&g_mu);
+    g_pass.running = 0;
+    g_pass.phase[0] = '\0';
+    g_pass.last_at = time(NULL);
+    g_pass.uploaded = uploaded;
+    g_pass.failed = failed;
+    g_pass.looked = looked;
+    snprintf(g_pass.error, sizeof g_pass.error, "%s", first_err);
+    if (!failed) g_pass.last_ok_at = g_pass.last_at;
+    pthread_mutex_unlock(&g_mu);
+    fprintf(stderr, "cloud: pass done: %d saves looked at, %d uploaded, %d failed\n", looked, uploaded, failed);
+    if (failed && !had_error) {
+        char m[360];
+        snprintf(m, sizeof m, "Backup na nuvem falhou: %s", first_err);
+        (void)notif_send_serialised(m, NOTIF_LEVEL_WARN);
+    } else if (!failed && had_error) {
+        (void)notif_send_serialised("Backup na nuvem voltou a funcionar", NOTIF_LEVEL_INFO);
+    }
+}
+
+static void *sync_main(void *arg) {
+    (void)arg;
+    pthread_mutex_lock(&g_mu);
+    g_pass.next_at = time(NULL) + FIRST_PASS_S;
+    pthread_mutex_unlock(&g_mu);
+    for (;;) {
+        int due;
+        time_t now;
+        sleep(5);
+        now = time(NULL);
+        pthread_mutex_lock(&g_mu);
+        due = g_run_now || (g_set.enabled && now >= g_pass.next_at);
+        pthread_mutex_unlock(&g_mu);
+        if (!due || !cloud_auth_connected()) {
+            g_run_now = 0;
+            continue;
+        }
+        g_run_now = 0;
+        run_pass();
+        pthread_mutex_lock(&g_mu);
+        g_pass.next_at = time(NULL) + (time_t)g_set.interval_min * 60;
+        pthread_mutex_unlock(&g_mu);
+    }
+    return NULL;
+}
+
+/* ---- the page's requests ---- */
+
+static void task_auth(void) {
+    cloud_device_t *dv = malloc(sizeof *dv);
+    char err[300] = "";
+    int interval, r;
+    if (!dv) return;
+    if (cloud_device_start(dv, err, sizeof err) != 0) {
+        pthread_mutex_lock(&g_mu);
+        snprintf(g_task.a_state, sizeof g_task.a_state, "error");
+        snprintf(g_task.a_error, sizeof g_task.a_error, "%s", err);
+        pthread_mutex_unlock(&g_mu);
+        free(dv);
+        return;
+    }
+    pthread_mutex_lock(&g_mu);
+    snprintf(g_task.a_state, sizeof g_task.a_state, "code");
+    snprintf(g_task.a_code, sizeof g_task.a_code, "%s", dv->user_code);
+    snprintf(g_task.a_url, sizeof g_task.a_url, "%s", dv->url);
+    g_task.a_expires = dv->expires_at;
+    pthread_mutex_unlock(&g_mu);
+    interval = dv->interval;
+    for (;;) {
+        for (int s = 0; s < interval && !g_task.a_cancel; s++) sleep(1);
+        if (g_task.a_cancel) {
+            pthread_mutex_lock(&g_mu);
+            snprintf(g_task.a_state, sizeof g_task.a_state, "idle");
+            pthread_mutex_unlock(&g_mu);
+            break;
+        }
+        r = cloud_device_poll(dv, err, sizeof err);
+        if (r == 0) continue;
+        if (r == 2) {
+            interval += 5;
+            continue;
+        }
+        pthread_mutex_lock(&g_mu);
+        if (r == 1) {
+            snprintf(g_task.a_state, sizeof g_task.a_state, "done");
+            g_task.a_error[0] = '\0';
+            /* signed in: backups start on their own, the first one soon */
+            g_set.enabled = 1;
+            (void)settings_save_locked();
+            g_pass.next_at = time(NULL) + 30;
+            g_pass.error[0] = '\0';
+        } else {
+            snprintf(g_task.a_state, sizeof g_task.a_state, "error");
+            snprintf(g_task.a_error, sizeof g_task.a_error, "%s", err);
+        }
+        pthread_mutex_unlock(&g_mu);
+        break;
+    }
+    free(dv);
+}
+
+/* Appends the backups of `owner`/`title` to files/owners. 0 (none is fine), or -1. */
+static int list_owner(const char *owner, const char *title, cloud_file_t *files, char (*owners)[9], size_t *n,
+                      char *err, size_t ecap) {
+    char folder[CLOUD_ID_MAX];
+    size_t got = 0;
+    int r = drive_folder_of(owner, title, 0, folder, sizeof folder, err, ecap);
+    if (r == 0) return 0; /* no folder yet: no backups */
+    if (r < 0 || cloud_drive_list(folder, files + *n, MAX_LIST - *n, &got, err, ecap) != 0) return -1;
+    for (size_t i = 0; i < got; i++) snprintf(owners[*n + i], sizeof owners[0], "%s", owner);
+    *n += got;
+    return 0;
+}
+
+/* The backups of `title` from every profile folder on Drive: `user`'s first, then the others (a
+ * profile that was deleted and made again on this PS5 is a new folder, so its old backups are
+ * listed under the old one). */
+static void task_list(void) {
+    char user[9], title[10], root[CLOUD_ID_MAX], err[300] = "";
+    cloud_file_t *files = malloc(MAX_LIST * sizeof *files);
+    cloud_file_t *subs = malloc(MAX_LIST * sizeof *subs);
+    char (*owners)[9] = malloc(MAX_LIST * sizeof *owners);
+    size_t n = 0, ns = 0;
+    int r = 0;
+    pthread_mutex_lock(&g_mu);
+    snprintf(user, sizeof user, "%s", g_task.l_user);
+    snprintf(title, sizeof title, "%s", g_task.l_title);
+    pthread_mutex_unlock(&g_mu);
+    if (!files || !subs || !owners) {
+        say(err, sizeof err, "out of memory");
+        r = -1;
+        goto publish;
+    }
+    r = list_owner(user, title, files, owners, &n, err, sizeof err);
+    if (r == 0) {
+        int fr = folder_cached("", root, sizeof root)
+                     ? 1
+                     : cloud_drive_folder(NULL, CLOUD_ROOT_FOLDER, 0, root, sizeof root, err, sizeof err);
+        if (fr == 1) {
+            folder_remember("", root);
+            if (cloud_drive_subfolders(root, subs, MAX_LIST, &ns, err, sizeof err) != 0) r = -1;
+        } else if (fr < 0) {
+            r = -1;
+        }
+    }
+    for (size_t i = 0; r == 0 && i < ns && n < MAX_LIST; i++) {
+        if (!cloud_user_ok(subs[i].name) || strcmp(subs[i].name, user) == 0) continue;
+        folder_remember(subs[i].name, subs[i].id);
+        r = list_owner(subs[i].name, title, files, owners, &n, err, sizeof err);
+    }
+publish:
+    free(subs);
+    pthread_mutex_lock(&g_mu);
+    free(g_task.l_files);
+    free(g_task.l_owner);
+    g_task.l_files = NULL;
+    g_task.l_owner = NULL;
+    g_task.l_n = 0;
+    if (r < 0) {
+        snprintf(g_task.l_state, sizeof g_task.l_state, "error");
+        snprintf(g_task.l_error, sizeof g_task.l_error, "%s", err);
+        free(files);
+        free(owners);
+    } else {
+        snprintf(g_task.l_state, sizeof g_task.l_state, "done");
+        g_task.l_error[0] = '\0';
+        g_task.l_files = files;
+        g_task.l_owner = owners;
+        g_task.l_n = n;
+    }
+    pthread_mutex_unlock(&g_mu);
+}
+
+static void task_fetch(void) {
+    char user[9], from[9], title[10], id[CLOUD_ID_MAX], stamp[CLOUD_STAMP_LEN + 1], err[300] = "";
+    char tdir[P], final[P], part[P], tar[P];
+    int rc = -1;
+    pthread_mutex_lock(&g_mu);
+    snprintf(user, sizeof user, "%s", g_task.f_user);
+    snprintf(from, sizeof from, "%s", g_task.f_from);
+    snprintf(title, sizeof title, "%s", g_task.f_title);
+    snprintf(id, sizeof id, "%s", g_task.f_id);
+    snprintf(stamp, sizeof stamp, "%s", g_task.f_stamp);
+    pthread_mutex_unlock(&g_mu);
+    title_dir(tdir, sizeof tdir, user, title);
+    snprintf(final, sizeof final, "%s/%s" CLOUD_SYNC_SUFFIX, tdir, stamp);
+    snprintf(part, sizeof part, "%s/.%s" CLOUD_SYNC_SUFFIX ".part", tdir, stamp);
+    snprintf(tar, sizeof tar, CLOUD_TMP_DIR "/fetch-%s-%s.tar", user, title);
+    if (is_dir(final) && strcmp(from, user) != 0) {
+        /* this profile has a backup of its own with the same time: never mistake one for the other */
+        say(err, sizeof err, "this profile already has a backup from %s; restore that one", stamp);
+    } else if (is_dir(final)) {
+        rc = 0; /* the same backup is on the console already */
+    } else if (mkdir_p(CLOUD_TMP_DIR) != 0 || mkdir_p(tdir) != 0) {
+        say(err, sizeof err, "cannot make the folders on the PS5");
+    } else if (cloud_drive_download(id, tar, NULL, err, sizeof err) == 0) {
+        rm_rf(part);
+        if (mkdir_p(part) == 0 && untar(tar, part, err, sizeof err) == 0) {
+            if (rename(part, final) == 0) rc = 0;
+            else say(err, sizeof err, "rename: %s", strerror(errno));
+        }
+        if (rc != 0) rm_rf(part);
+    }
+    unlink(tar);
+    pthread_mutex_lock(&g_mu);
+    snprintf(g_task.f_state, sizeof g_task.f_state, rc == 0 ? "done" : "error");
+    snprintf(g_task.f_error, sizeof g_task.f_error, "%s", rc == 0 ? "" : err);
+    pthread_mutex_unlock(&g_mu);
+}
+
+/* This PS5's profiles, each with the account slot that goes with it. */
+static size_t profiles_here(here_t *out, size_t max) {
+    cloud_user_t users[PROFILES_MAX];
+    cloud_slot_t slots[PROFILES_MAX];
+    size_t nu, ns, n = 0;
+    read_profiles(users, &nu, slots, &ns);
+    for (size_t i = 0; i < nu && n < max; i++, n++) {
+        int si = cloud_user_slot(users, nu, i, slots, ns);
+        snprintf(out[n].uid, sizeof out[n].uid, "%s", users[i].uid);
+        snprintf(out[n].name, sizeof out[n].name, "%s", users[i].name);
+        out[n].slot = si >= 0 ? slots[si].slot : 0;
+        out[n].id = si >= 0 ? slots[si].id : 0;
+    }
+    return n;
+}
+
+/* Every account in the profiles files on Drive (newest file first; an account is kept from the
+ * newest file that has it), and this PS5's profiles. */
+static void task_profiles(void) {
+    cloud_file_t *files = malloc(MAX_LIST * sizeof *files);
+    cloud_account_t *old = calloc(OLD_MAX, sizeof *old), found[OLD_MAX];
+    here_t here[HERE_MAX];
+    char root[CLOUD_ID_MAX], err[300] = "", path[P], stamp[CLOUD_STAMP_LEN + 1];
+    size_t n = 0, nold = 0, nhere;
+    int r = -1;
+    if (!files || !old) {
+        say(err, sizeof err, "out of memory");
+        goto publish;
+    }
+    r = folder_cached("", root, sizeof root)
+            ? 1
+            : cloud_drive_folder(NULL, CLOUD_ROOT_FOLDER, 0, root, sizeof root, err, sizeof err);
+    if (r == 1) {
+        folder_remember("", root);
+        r = cloud_drive_list(root, files, MAX_LIST, &n, err, sizeof err) == 0 ? 1 : -1;
+    }
+    if (r == 0) n = 0; /* no PS5 Saves folder: nothing was ever sent */
+    (void)mkdir_p(CLOUD_TMP_DIR);
+    snprintf(path, sizeof path, CLOUD_TMP_DIR "/profiles.txt");
+    /* newest first: Drive lists by name, and the names sort by time */
+    for (size_t i = n; r >= 0 && i-- > 0 && nold < OLD_MAX;) {
+        char *text;
+        size_t len = 0, k;
+        if (cloud_profiles_name_stamp(files[i].name, stamp, sizeof stamp) != 0) continue;
+        if (cloud_drive_download(files[i].id, path, NULL, err, sizeof err) != 0) {
+            r = -1;
+            break;
+        }
+        text = read_small(path, &len);
+        unlink(path);
+        if (!text) continue;
+        k = cloud_profiles_parse(text, len, found, OLD_MAX);
+        free(text);
+        for (size_t a = 0; a < k && nold < OLD_MAX; a++) {
+            size_t b;
+            for (b = 0; b < nold; b++)
+                if (old[b].id == found[a].id) break;
+            if (b < nold) continue;
+            old[nold] = found[a];
+            snprintf(old[nold].stamp, sizeof old[nold].stamp, "%s", stamp);
+            nold++;
+        }
+    }
+    if (r >= 0) err[0] = '\0';
+publish:
+    nhere = profiles_here(here, HERE_MAX);
+    pthread_mutex_lock(&g_mu);
+    snprintf(g_task.p_state, sizeof g_task.p_state, r < 0 ? "error" : "done");
+    snprintf(g_task.p_error, sizeof g_task.p_error, "%s", r < 0 ? err : "");
+    g_task.p_nold = r < 0 ? 0 : nold;
+    if (old) memcpy(g_task.p_old, old, nold * sizeof *old);
+    memcpy(g_task.p_here, here, nhere * sizeof *here);
+    g_task.p_nhere = nhere;
+    pthread_mutex_unlock(&g_mu);
+    free(files);
+    free(old);
+}
+
+static void *task_main(void *arg) {
+    (void)arg;
+    for (;;) {
+        int kind;
+        pthread_mutex_lock(&g_mu);
+        while (!g_task.pending) pthread_cond_wait(&g_task_cv, &g_mu);
+        kind = g_task.pending;
+        g_task.pending = T_NONE;
+        g_task.busy = kind;
+        pthread_mutex_unlock(&g_mu);
+        if (kind == T_AUTH) task_auth();
+        else if (kind == T_LIST) task_list();
+        else if (kind == T_FETCH) task_fetch();
+        else if (kind == T_PROFILES) task_profiles();
+        pthread_mutex_lock(&g_mu);
+        g_task.busy = T_NONE;
+        pthread_mutex_unlock(&g_mu);
+    }
+    return NULL;
+}
+
+/* Queues `kind` (with g_mu held): 0, or 1 when another request runs or waits. */
+static int task_queue_locked(int kind) {
+    if (g_task.pending || g_task.busy) return 1;
+    g_task.pending = kind;
+    pthread_cond_signal(&g_task_cv);
+    return 0;
+}
+
+int cloud_connect_start(void) {
+    int r;
+    if (!cloud_auth_has_client()) return -1;
+    pthread_mutex_lock(&g_mu);
+    g_task.a_cancel = 0;
+    r = task_queue_locked(T_AUTH);
+    if (r == 0) {
+        snprintf(g_task.a_state, sizeof g_task.a_state, "starting");
+        g_task.a_code[0] = g_task.a_url[0] = g_task.a_error[0] = '\0';
+    }
+    pthread_mutex_unlock(&g_mu);
+    return r;
+}
+
+void cloud_disconnect(void) {
+    int waiting;
+    pthread_mutex_lock(&g_mu);
+    waiting = g_task.busy == T_AUTH || g_task.pending == T_AUTH;
+    g_task.a_cancel = 1;
+    if (g_task.pending == T_AUTH) g_task.pending = T_NONE;
+    if (!waiting) snprintf(g_task.a_state, sizeof g_task.a_state, "idle");
+    pthread_mutex_unlock(&g_mu);
+    if (!waiting) {
+        cloud_auth_disconnect();
+        folders_forget();
+    }
+}
+
+int cloud_list_start(const char *user, const char *title) {
+    int r;
+    if (!cloud_user_ok(user) || !cloud_title_ok(title) || !cloud_auth_connected()) return -1;
+    pthread_mutex_lock(&g_mu);
+    r = task_queue_locked(T_LIST);
+    if (r == 0) {
+        snprintf(g_task.l_state, sizeof g_task.l_state, "running");
+        snprintf(g_task.l_user, sizeof g_task.l_user, "%s", user);
+        snprintf(g_task.l_title, sizeof g_task.l_title, "%s", title);
+        g_task.l_error[0] = '\0';
+    }
+    pthread_mutex_unlock(&g_mu);
+    return r;
+}
+
+int cloud_fetch_start(const char *user, const char *from, const char *title, const char *file_id, const char *stamp) {
+    int r;
+    if (!from) from = user;
+    if (!cloud_user_ok(user) || !cloud_user_ok(from) || !cloud_title_ok(title) || !cloud_stamp_ok(stamp) ||
+        !file_id || !file_id[0] ||
+        strlen(file_id) >= CLOUD_ID_MAX || strpbrk(file_id, "/?#&'\"\\ ") || !cloud_auth_connected())
+        return -1;
+    pthread_mutex_lock(&g_mu);
+    r = task_queue_locked(T_FETCH);
+    if (r == 0) {
+        snprintf(g_task.f_state, sizeof g_task.f_state, "running");
+        snprintf(g_task.f_user, sizeof g_task.f_user, "%s", user);
+        snprintf(g_task.f_from, sizeof g_task.f_from, "%s", from);
+        snprintf(g_task.f_title, sizeof g_task.f_title, "%s", title);
+        snprintf(g_task.f_id, sizeof g_task.f_id, "%s", file_id);
+        snprintf(g_task.f_stamp, sizeof g_task.f_stamp, "%s", stamp);
+        g_task.f_error[0] = '\0';
+    }
+    pthread_mutex_unlock(&g_mu);
+    return r;
+}
+
+int cloud_profiles_start(void) {
+    int r;
+    if (!cloud_auth_connected()) return -1;
+    pthread_mutex_lock(&g_mu);
+    r = task_queue_locked(T_PROFILES);
+    if (r == 0) {
+        snprintf(g_task.p_state, sizeof g_task.p_state, "running");
+        g_task.p_error[0] = '\0';
+    }
+    pthread_mutex_unlock(&g_mu);
+    return r;
+}
+
+int cloud_profile_apply(int slot, const char *uid, uint64_t id) {
+    here_t here[HERE_MAX];
+    size_t nhere, i;
+    int known = 0, rc;
+    uint64_t now = 0;
+    pthread_mutex_lock(&g_mu);
+    for (i = 0; i < g_task.p_nold; i++)
+        if (g_task.p_old[i].id == id) known = 1;
+    pthread_mutex_unlock(&g_mu);
+    /* only an account the profiles files on Drive list, and only onto a profile that has a slot */
+    if (!id || !known || slot < 1 || slot > PROFILE_SLOT_COUNT || !cloud_user_ok(uid)) return -1;
+    nhere = profiles_here(here, HERE_MAX);
+    for (i = 0; i < nhere; i++)
+        if (strcmp(here[i].uid, uid) == 0 && here[i].slot == slot) break;
+    if (i == nhere) return -1;
+    pthread_mutex_lock(&sony_api_lock);
+    rc = profile_slot_activate(slot, id);
+    (void)profile_slot_get_id(slot, &now, NULL);
+    usleep(SONY_API_POST_SLEEP_US);
+    pthread_mutex_unlock(&sony_api_lock);
+    fprintf(stderr, "cloud: profile %s (slot %d) given account 0x%llx: %s\n", uid, slot, (unsigned long long)id,
+            rc == 0 && now == id ? "done" : "failed");
+    if (rc != 0 || now != id) return -2;
+    nhere = profiles_here(here, HERE_MAX);
+    pthread_mutex_lock(&g_mu);
+    memcpy(g_task.p_here, here, nhere * sizeof *here);
+    g_task.p_nhere = nhere;
+    pthread_mutex_unlock(&g_mu);
+    return 0;
+}
+
+int cloud_run_now(void) {
+    if (!cloud_auth_connected()) return -1;
+    g_run_now = 1;
+    return 0;
+}
+
+int cloud_settings_set(int enabled, int interval_min, int keep_cloud, int keep_local) {
+    int rc;
+    pthread_mutex_lock(&g_mu);
+    if (enabled >= 0) {
+        if (enabled && !g_set.enabled) g_pass.next_at = time(NULL) + 30;
+        g_set.enabled = enabled ? 1 : 0;
+    }
+    if (interval_min >= 0) {
+        int was = g_set.interval_min;
+        g_set.interval_min = clampi(interval_min, 5, 1440);
+        /* a shorter interval takes effect now, not after the old one ran out */
+        if (g_set.interval_min < was) {
+            time_t soon = time(NULL) + (time_t)g_set.interval_min * 60;
+            if (g_pass.next_at > soon) g_pass.next_at = soon;
+        }
+    }
+    if (keep_cloud >= 0) g_set.keep_cloud = clampi(keep_cloud, 1, 100);
+    if (keep_local >= 0) g_set.keep_local = clampi(keep_local, 1, 50);
+    rc = settings_save_locked();
+    pthread_mutex_unlock(&g_mu);
+    return rc;
+}
+
+int cloud_set_client(const char *id, const char *secret) { return cloud_auth_set_client(id, secret); }
+
+/* ---- status ---- */
+
+typedef struct {
+    char *b;
+    size_t cap, at;
+    int over;
+} jb_t;
+
+static void jb_raw(jb_t *j, const char *fmt, ...) __attribute__((format(printf, 2, 3)));
+static void jb_raw(jb_t *j, const char *fmt, ...) {
+    va_list ap;
+    int k;
+    if (j->over) return;
+    va_start(ap, fmt);
+    k = vsnprintf(j->b + j->at, j->cap - j->at, fmt, ap);
+    va_end(ap);
+    if (k < 0 || (size_t)k >= j->cap - j->at) j->over = 1;
+    else j->at += (size_t)k;
+}
+
+/* "key":"<escaped>" (or null when s is NULL or empty and `null_empty`). */
+static void jb_str(jb_t *j, const char *key, const char *s, int null_empty) {
+    size_t k;
+    if (j->over) return;
+    if (!s || (null_empty && !s[0])) {
+        jb_raw(j, "\"%s\":null", key);
+        return;
+    }
+    jb_raw(j, "\"%s\":\"", key);
+    if (j->over) return;
+    k = webui_json_escape(j->b + j->at, j->cap - j->at, s, strlen(s));
+    if (k >= j->cap - j->at) {
+        j->over = 1;
+        return;
+    }
+    j->at += k;
+    jb_raw(j, "\"");
+}
+
+int cloud_status_json(char *out, size_t cap) {
+    jb_t j = { out, cap, 0, 0 };
+    char email[256], client[CLOUD_ID_MAX];
+    int signed_in = cloud_auth_connected();
+    cloud_auth_email(email, sizeof email);
+    cloud_auth_client_id(client, sizeof client);
+    pthread_mutex_lock(&g_mu);
+    jb_raw(&j, "{\"signed_in\":%s,", signed_in ? "true" : "false");
+    jb_str(&j, "email", email, 1);
+    jb_raw(&j, ",");
+    jb_str(&j, "client_id", client, 1);
+    jb_raw(&j, ",\"settings\":{\"enabled\":%s,\"interval_min\":%d,\"keep_cloud\":%d,\"keep_local\":%d},",
+           g_set.enabled ? "true" : "false", g_set.interval_min, g_set.keep_cloud, g_set.keep_local);
+    jb_raw(&j, "\"pass\":{\"running\":%s,", g_pass.running ? "true" : "false");
+    jb_str(&j, "phase", g_pass.phase, 1);
+    jb_raw(&j,
+           ",\"last_at\":%lld,\"last_ok_at\":%lld,\"profiles_at\":%lld,\"next_at\":%lld,\"looked\":%d,\"uploaded\":%d,"
+           "\"failed\":%d,",
+           (long long)g_pass.last_at, (long long)g_pass.last_ok_at, (long long)g_pass.profiles_at,
+           (long long)(g_set.enabled && signed_in ? g_pass.next_at : 0), g_pass.looked, g_pass.uploaded,
+           g_pass.failed);
+    jb_str(&j, "error", g_pass.error, 1);
+    jb_raw(&j, "},\"auth\":{");
+    jb_str(&j, "state", g_task.a_state[0] ? g_task.a_state : "idle", 0);
+    jb_raw(&j, ",");
+    jb_str(&j, "user_code", g_task.a_code, 1);
+    jb_raw(&j, ",");
+    jb_str(&j, "url", g_task.a_url, 1);
+    jb_raw(&j, ",\"expires_at\":%lld,", (long long)g_task.a_expires);
+    jb_str(&j, "error", g_task.a_error, 1);
+    jb_raw(&j, "},\"list\":{");
+    jb_str(&j, "state", g_task.l_state[0] ? g_task.l_state : "idle", 0);
+    jb_raw(&j, ",");
+    jb_str(&j, "user", g_task.l_user, 1);
+    jb_raw(&j, ",");
+    jb_str(&j, "title", g_task.l_title, 1);
+    jb_raw(&j, ",");
+    jb_str(&j, "error", g_task.l_error, 1);
+    jb_raw(&j, ",\"files\":[");
+    for (size_t i = 0; i < g_task.l_n; i++) {
+        const cloud_file_t *f = &g_task.l_files[i];
+        char stamp[CLOUD_STAMP_LEN + 1];
+        if (cloud_drive_name_stamp(f->name, g_task.l_title, stamp, sizeof stamp) != 0) continue;
+        jb_raw(&j, "%s{", j.at && out[j.at - 1] == '}' ? "," : "");
+        jb_str(&j, "id", f->id, 0);
+        jb_raw(&j, ",");
+        jb_str(&j, "user", g_task.l_owner ? g_task.l_owner[i] : g_task.l_user, 0);
+        jb_raw(&j, ",");
+        jb_str(&j, "name", f->name, 0);
+        jb_raw(&j, ",");
+        jb_str(&j, "stamp", stamp, 0);
+        jb_raw(&j, ",\"size\":%llu}", (unsigned long long)f->size);
+    }
+    jb_raw(&j, "]},\"fetch\":{");
+    jb_str(&j, "state", g_task.f_state[0] ? g_task.f_state : "idle", 0);
+    jb_raw(&j, ",");
+    jb_str(&j, "user", g_task.f_user, 1);
+    jb_raw(&j, ",");
+    jb_str(&j, "from", g_task.f_from, 1);
+    jb_raw(&j, ",");
+    jb_str(&j, "title", g_task.f_title, 1);
+    jb_raw(&j, ",");
+    jb_str(&j, "stamp", g_task.f_stamp, 1);
+    jb_raw(&j, ",");
+    jb_str(&j, "error", g_task.f_error, 1);
+    jb_raw(&j, "},\"profiles\":{");
+    jb_str(&j, "state", g_task.p_state[0] ? g_task.p_state : "idle", 0);
+    jb_raw(&j, ",");
+    jb_str(&j, "error", g_task.p_error, 1);
+    jb_raw(&j, ",\"old\":[");
+    for (size_t i = 0; i < g_task.p_nold; i++) {
+        const cloud_account_t *a = &g_task.p_old[i];
+        jb_raw(&j, "%s{", i ? "," : "");
+        jb_str(&j, "name", a->name, 0);
+        jb_raw(&j, ",");
+        jb_str(&j, "uid", a->uid, 1);
+        jb_raw(&j, ",\"id\":\"0x%llx\",", (unsigned long long)a->id);
+        jb_str(&j, "stamp", a->stamp, 0);
+        jb_raw(&j, "}");
+    }
+    jb_raw(&j, "],\"here\":[");
+    for (size_t i = 0; i < g_task.p_nhere; i++) {
+        const here_t *h = &g_task.p_here[i];
+        jb_raw(&j, "%s{", i ? "," : "");
+        jb_str(&j, "uid", h->uid, 0);
+        jb_raw(&j, ",");
+        jb_str(&j, "name", h->name, 0);
+        jb_raw(&j, ",\"slot\":%d,\"id\":\"0x%llx\"}", h->slot, (unsigned long long)h->id);
+    }
+    jb_raw(&j, "]},\"busy\":%s}", g_task.busy || g_task.pending ? "true" : "false");
+    pthread_mutex_unlock(&g_mu);
+    return j.over ? -1 : (int)j.at;
+}
+
+/* ---- start ---- */
+
+static int spawn(void *(*fn)(void *)) {
+    pthread_attr_t attr;
+    pthread_t t;
+    int rc;
+    pthread_attr_init(&attr);
+    pthread_attr_setstacksize(&attr, THREAD_STACK);
+    pthread_attr_setdetachstate(&attr, PTHREAD_CREATE_DETACHED);
+    rc = pthread_create(&t, &attr, fn, NULL);
+    pthread_attr_destroy(&attr);
+    return rc;
+}
+
+void cloud_sync_start(void) {
+    g_entries = calloc(MAX_ENTRIES, sizeof *g_entries);
+    if (!g_entries) {
+        fprintf(stderr, "cloud: out of memory; save backups to Google Drive are off\n");
+        return;
+    }
+    (void)mkdir_p(CLOUD_DIR);
+    (void)chmod(CLOUD_DIR, 0700);
+    /* what a stopped helper left half-sent or half-fetched */
+    rm_rf(CLOUD_TMP_DIR);
+    cloud_auth_load();
+    settings_load();
+    state_load();
+    if (spawn(sync_main) != 0 || spawn(task_main) != 0)
+        fprintf(stderr, "cloud: could not start its threads; save backups to Google Drive are off\n");
+}
