+/* Past the JSON value at *i (an object, array, string or bare word): 0, or -1 malformed. */
+static int skip_value(const char *a, size_t len, size_t *i) {
+    int depth = 0, in_str = 0;
+    size_t k = *i;
+    if (k >= len) return -1;
+    if (a[k] != '{' && a[k] != '[' && a[k] != '"') {
+        while (k < len && a[k] != ',' && a[k] != ']' && a[k] != '}') k++;
+        *i = k;
+        return 0;
+    }
+    for (; k < len; k++) {
+        char ch = a[k];
+        if (in_str) {
+            if (ch == '\\') k++;
+            else if (ch == '"') {
+                in_str = 0;
+                if (depth == 0) {
+                    *i = k + 1;
+                    return 0;
+                }
+            }
+            continue;
+        }
+        if (ch == '"') in_str = 1;
+        else if (ch == '{' || ch == '[') depth++;
+        else if (ch == '}' || ch == ']') {
+            if (--depth == 0) {
+                *i = k + 1;
+                return 0;
+            }
+            if (depth < 0) return -1;
+        }
+    }
+    return -1;
+}
+
+int cloud_json_next_object(const char *arr, size_t len, size_t *pos, const char **obj, size_t *olen) {
+    size_t i = *pos;
+    if (i == 0) {
+        while (i < len && isspace((unsigned char)arr[i])) i++;
+        if (i >= len || arr[i] != '[') return -1;
+        i++;
+    }
+    for (;;) {
+        size_t start;
+        while (i < len && (isspace((unsigned char)arr[i]) || arr[i] == ',')) i++;
+        if (i >= len) return -1;
+        if (arr[i] == ']') {
+            *pos = i;
+            return 0;
+        }
+        start = i;
+        if (skip_value(arr, len, &i) != 0) return -1;
+        if (arr[start] == '{') {
+            *obj = arr + start;
+            *olen = i - start;
+            *pos = i;
+            return 1;
+        }
+    }
+}
