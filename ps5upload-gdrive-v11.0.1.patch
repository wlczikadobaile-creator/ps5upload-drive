diff -ruN a/payload/tests/cloud_logic_selftest.c b/payload/tests/cloud_logic_selftest.c
--- a/payload/tests/cloud_logic_selftest.c	1969-12-31 21:00:00.000000000 -0300
+++ b/payload/tests/cloud_logic_selftest.c	2026-11-03 22:51:09.180959497 -0300
@@ -0,0 +1,223 @@
+/* Host selftest for the cloud save backup's pure parts (cloud_logic.c): the names a backup goes by
+ * on the console and on Drive, which backups a prune removes, the tar reader against the tar writer
+ * the helper uses (webui_files.c wf_tar_header), the entries a restore may write, the Drive reply's
+ * file list and form escaping. */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "cloud_logic.h"
+#include "webui_files.h"
+
+static int failures = 0;
+
+#define CHECK(cond, ...)                                                                                     \
+    do {                                                                                                     \
+        if (!(cond)) {                                                                                       \
+            printf("  FAIL %s:%d: ", __FILE__, __LINE__);                                                    \
+            printf(__VA_ARGS__);                                                                             \
+            printf("\n");                                                                                    \
+            failures++;                                                                                      \
+        }                                                                                                    \
+    } while (0)
+
+static void names(void) {
+    char s[32], out[64];
+    CHECK(cloud_title_ok("PPSA01234") && cloud_title_ok("CUSA12345"), "game ids");
+    CHECK(!cloud_title_ok("ppsa01234") && !cloud_title_ok("PPSA0123") && !cloud_title_ok("PPSA012345") &&
+              !cloud_title_ok("PPS101234") && !cloud_title_ok(NULL),
+          "not game ids");
+    CHECK(cloud_user_ok("1a2b3c4d") && !cloud_user_ok("1A2B3C4D") && !cloud_user_ok("1a2b3c4") &&
+              !cloud_user_ok("1a2b3c4g"),
+          "user folders");
+    CHECK(cloud_stamp(s, sizeof s, 1700000000) == 0 && cloud_stamp_ok(s), "a stamp is made: %s", s);
+    CHECK(cloud_stamp(s, 10, 1700000000) != 0, "a stamp needs room");
+    CHECK(cloud_stamp_ok("2026-11-03_14-30-00") && !cloud_stamp_ok("2026-11-03_14-30-0") &&
+              !cloud_stamp_ok("2026-11-03 14-30-00") && !cloud_stamp_ok("2026-11-03_14-30-00_sync"),
+          "stamps");
+    CHECK(cloud_local_name_stamp("2026-11-03_14-30-00_sync", s, sizeof s) == 0 && !strcmp(s, "2026-11-03_14-30-00"),
+          "a local backup's name");
+    /* the page's own backups, and its safety copies, are never taken for ours */
+    CHECK(cloud_local_name_stamp("2026-11-03_14-30-00", s, sizeof s) != 0 &&
+              cloud_local_name_stamp("2026-11-03_14-30-00_auto", s, sizeof s) != 0 &&
+              cloud_local_name_stamp(".2026-11-03_14-30-00_sync.part", s, sizeof s) != 0,
+          "not ours");
+    CHECK(cloud_drive_name(out, sizeof out, "PPSA01234", "2026-11-03_14-30-00") == 0 &&
+              !strcmp(out, "PPSA01234_2026-11-03_14-30-00.tar"),
+          "the Drive name: %s", out);
+    CHECK(cloud_drive_name_stamp("PPSA01234_2026-11-03_14-30-00.tar", "PPSA01234", s, sizeof s) == 0 &&
+              !strcmp(s, "2026-11-03_14-30-00"),
+          "a Drive name's stamp");
+    CHECK(cloud_drive_name_stamp("PPSA09999_2026-11-03_14-30-00.tar", "PPSA01234", s, sizeof s) != 0 &&
+              cloud_drive_name_stamp("PPSA01234_2026-11-03_14-30-00.zip", "PPSA01234", s, sizeof s) != 0 &&
+              cloud_drive_name_stamp("PPSA01234_notastamp_00-00-00.tar", "PPSA01234", s, sizeof s) != 0,
+          "another game's, or not ours");
+    CHECK(!cloud_kind_is_meta(0) && cloud_kind_is_meta(1) && !cloud_kind_is_meta(2) && cloud_kind_is_meta(3),
+          "meta kinds");
+}
+
+static void prune(void) {
+    const char *st[] = { "2026-01-03_00-00-00", "2026-01-01_00-00-00", "2026-01-05_00-00-00", "2026-01-02_00-00-00",
+                         "2026-01-04_00-00-00" };
+    size_t del[5], n;
+    n = cloud_prune(st, 5, 3, del);
+    CHECK(n == 2 && del[0] == 1 && del[1] == 3, "the two oldest go, oldest first (n=%zu)", n);
+    n = cloud_prune(st, 5, 5, del);
+    CHECK(n == 0, "keep all");
+    n = cloud_prune(st, 5, 10, del);
+    CHECK(n == 0, "keep more than there are");
+    n = cloud_prune(st, 5, 1, del);
+    CHECK(n == 4 && del[3] == 4, "only the newest stays");
+    n = cloud_prune(st, 5, 0, del);
+    CHECK(n == 5, "keep none");
+    n = cloud_prune(st, 0, 3, del);
+    CHECK(n == 0, "none");
+}
+
+static void fingerprints(void) {
+    uint64_t a = cloud_fp_part("savedata_prospero/sdimg_SAVEDATA00", 100, 5);
+    CHECK(a != cloud_fp_part("savedata_prospero/sdimg_SAVEDATA00", 101, 5), "size");
+    CHECK(a != cloud_fp_part("savedata_prospero/sdimg_SAVEDATA00", 100, 6), "time");
+    CHECK(a != cloud_fp_part("savedata_prospero/sdimg_SAVEDATA01", 100, 5), "name");
+    CHECK(a == cloud_fp_part("savedata_prospero/sdimg_SAVEDATA00", 100, 5), "same file, same part");
+}
+
+static void urlenc(void) {
+    char out[128];
+    size_t n = cloud_urlenc(out, sizeof out, "name='PS5 Saves' and x/y");
+    CHECK(!strcmp(out, "name%3D%27PS5%20Saves%27%20and%20x%2Fy") && n == strlen(out), "%s", out);
+    n = cloud_urlenc(out, 5, "abcdefgh");
+    CHECK(n == 8 && strlen(out) == 4, "cut short, full length returned");
+    CHECK(cloud_urlenc(out, sizeof out, "a-b_c.d~e") == 9 && !strcmp(out, "a-b_c.d~e"), "unreserved stay");
+}
+
+static void json_objects(void) {
+    const char *arr = "[ {\"id\":\"a\",\"name\":\"x}\"} , 7, \"s{\", {\"id\":\"b\",\"n\":{\"deep\":[1,2]}} ]";
+    const char *obj;
+    size_t len = strlen(arr), pos = 0, olen;
+    CHECK(cloud_json_next_object(arr, len, &pos, &obj, &olen) == 1 && olen == strlen("{\"id\":\"a\",\"name\":\"x}\"}") &&
+              obj[0] == '{',
+          "first object (a brace inside a string)");
+    CHECK(cloud_json_next_object(arr, len, &pos, &obj, &olen) == 1 && !strncmp(obj, "{\"id\":\"b\"", 9) &&
+              obj[olen - 1] == '}',
+          "second object (a number and a string skipped, nested values)");
+    CHECK(cloud_json_next_object(arr, len, &pos, &obj, &olen) == 0, "end");
+    CHECK(cloud_json_next_object(arr, len, &pos, &obj, &olen) == 0, "still the end");
+    pos = 0;
+    CHECK(cloud_json_next_object("[]", 2, &pos, &obj, &olen) == 0, "empty");
+    pos = 0;
+    CHECK(cloud_json_next_object("[{\"a\":1", 7, &pos, &obj, &olen) == -1, "cut short");
+    pos = 0;
+    CHECK(cloud_json_next_object("{}", 2, &pos, &obj, &olen) == -1, "not an array");
+}
+
+static void tar(void) {
+    uint8_t *h = malloc(WF_TAR_HEADER_MAX);
+    char name[1100], pax[1100], longname[400];
+    uint64_t size = 0;
+    size_t n;
+    memset(name, 0, sizeof name);
+    n = wf_tar_header(h, WF_TAR_HEADER_MAX, "savedata_prospero/sdimg_SAVEDATA00", 0, 123456, 0600, 1700000000);
+    CHECK(n == 512, "a short name: one header");
+    CHECK(cloud_tar_parse(h, name, sizeof name, &size) == CLOUD_TAR_FILE && !strcmp(name, "savedata_prospero/sdimg_SAVEDATA00") &&
+              size == 123456,
+          "file %s %llu", name, (unsigned long long)size);
+    n = wf_tar_header(h, WF_TAR_HEADER_MAX, "savedata_prospero_meta", 1, 0, 0777, 1700000000);
+    CHECK(n == 512 && cloud_tar_parse(h, name, sizeof name, &size) == CLOUD_TAR_DIR && !strcmp(name, "savedata_prospero_meta"),
+          "a folder, its '/' dropped: %s", name);
+    /* a name past ustar's 255: a pax header first, with the real path */
+    memset(longname, 'a', sizeof longname);
+    memcpy(longname, "savedata/", 9);
+    longname[300] = '\0';
+    n = wf_tar_header(h, WF_TAR_HEADER_MAX, longname, 0, 10, 0600, 1);
+    CHECK(n == 512 * 3, "pax: header, data, header (%zu)", n);
+    CHECK(cloud_tar_parse(h, name, sizeof name, &size) == CLOUD_TAR_PAX, "the pax header");
+    CHECK(cloud_tar_pax_path((const char *)h + 512, (size_t)size, pax, sizeof pax) == 1 && !strcmp(pax, longname),
+          "the pax path");
+    CHECK(cloud_tar_parse(h + 1024, name, sizeof name, &size) == CLOUD_TAR_FILE && size == 10, "then the entry");
+    /* damage */
+    n = wf_tar_header(h, WF_TAR_HEADER_MAX, "savedata/x", 0, 1, 0600, 1);
+    h[0] ^= 1;
+    CHECK(cloud_tar_parse(h, name, sizeof name, &size) == -1, "a bad checksum");
+    memset(h, 0, 512);
+    CHECK(cloud_tar_parse(h, name, sizeof name, &size) == CLOUD_TAR_END, "the end block");
+    CHECK(cloud_tar_pax_path("11 size=10\n", 11, pax, sizeof pax) == 0, "no path record");
+    CHECK(cloud_tar_pax_path("99 path=x\n", 10, pax, sizeof pax) == -1, "a bad record");
+    free(h);
+}
+
+static void restore_names(void) {
+    CHECK(cloud_tar_name_ok("savedata_prospero") && cloud_tar_name_ok("savedata_prospero/sdimg_SAVEDATA00") &&
+              cloud_tar_name_ok("savedata_meta/SAVEDATA00.sfo") && cloud_tar_name_ok("savedata/a/b/c"),
+          "a save's entries");
+    CHECK(!cloud_tar_name_ok("/savedata/x") && !cloud_tar_name_ok("savedata/../x") && !cloud_tar_name_ok("../x") &&
+              !cloud_tar_name_ok("savedata/./x") && !cloud_tar_name_ok("savedata//x") && !cloud_tar_name_ok("savedata/") &&
+              !cloud_tar_name_ok("other/x") && !cloud_tar_name_ok("savedata_x/y") && !cloud_tar_name_ok("") &&
+              !cloud_tar_name_ok("savedata/a/b/c/d") && !cloud_tar_name_ok("savedata/a\\b") &&
+              !cloud_tar_name_ok("savedata/a\nb"),
+          "anything else is refused");
+}
+
+static void profiles(void) {
+    static char out[16384];
+    char s[32];
+    cloud_user_t users[2] = { { "10b32138", "wallace" }, { "2c0ffee1", "" } };
+    cloud_slot_t slots[2] = { { 1, "wallace", "np", 6, 0x7a356e99a9e2205cull }, { 3, "", "np", 0x1002, 0x1234ull } };
+    size_t n = cloud_profiles_text(out, sizeof out, "2026-11-03_22-00-00", users, 2, slots, 2), n2;
+    CHECK(n > 0 && n < sizeof out && strlen(out) == n, "the text fits (%zu)", n);
+    CHECK(strstr(out, "10b32138") && strstr(out, "0x7a356e99a9e2205c") && strstr(out, "8806066252652093532"),
+          "a profile's folder and account ID, hex and decimal");
+    CHECK(strstr(out, "XCDiqZluNXo="), "the base64 the PC app writes for the same ID");
+    CHECK(strstr(out, "(sem nome)") && strstr(out, "nenhuma encontrada"), "a profile without a name or account");
+    CHECK(strstr(out, "OUTRAS CONTAS") && strstr(out, "0x1234") && strstr(out, "ativada offline"),
+          "an account slot no profile takes is listed apart");
+    CHECK(strstr(out, "Feito em: 2026-11-03_22-00-00"), "the time line");
+    n2 = cloud_profiles_text(out, sizeof out, NULL, users, 2, slots, 2);
+    CHECK(n2 < n && !strstr(out, "Feito em"), "no time line for the fingerprint");
+    CHECK(cloud_fnv(out, n2) == cloud_fnv(out, n2) && cloud_fnv("a", 1) != cloud_fnv("b", 1), "fingerprints");
+    CHECK(cloud_profiles_text(out, 10, NULL, users, 2, slots, 2) == n2 && strlen(out) == 9, "a short buffer: cut, length kept");
+    {
+        cloud_user_t one = { "10b32138", "" };
+        cloud_profiles_text(out, sizeof out, NULL, &one, 1, slots, 1);
+        CHECK(strstr(out, "0x7a356e99a9e2205c") && !strstr(out, "OUTRAS"), "one user and one named slot go together");
+    }
+    {
+        /* what the text says comes back: the profile with its folder, the slot without a profile */
+        cloud_account_t a[8];
+        size_t k;
+        cloud_profiles_text(out, sizeof out, "2026-11-03_22-00-00", users, 2, slots, 2);
+        k = cloud_profiles_parse(out, strlen(out), a, 8);
+        CHECK(k == 2, "two accounts read back (%zu)", k);
+        CHECK(k == 2 && a[0].id == 0x7a356e99a9e2205cull && !strcmp(a[0].uid, "10b32138") && !strcmp(a[0].name, "wallace"),
+              "the profile's account, name and folder");
+        CHECK(k == 2 && a[1].id == 0x1234ull && !a[1].uid[0], "the account without a profile");
+        CHECK(cloud_profiles_parse(out, strlen(out), a, 1) == 1, "at most max");
+        CHECK(cloud_profiles_parse("nothing here\n", 13, a, 8) == 0, "a text without accounts");
+        CHECK(cloud_user_slot(users, 2, 0, slots, 2) == 0 && cloud_user_slot(users, 2, 1, slots, 2) == -1 &&
+                  cloud_user_slot(users, 2, 5, slots, 2) == -1,
+              "which slot goes with which user");
+    }
+    CHECK(cloud_profiles_name(s, sizeof s, "2026-11-03_22-00-00") == 0 && !strcmp(s, "perfis_2026-11-03_22-00-00.txt"),
+          "the file's name");
+    CHECK(cloud_profiles_name_stamp("perfis_2026-11-03_22-00-00.txt", s, sizeof s) == 0 && !strcmp(s, "2026-11-03_22-00-00") &&
+              cloud_profiles_name_stamp("perfis_2026-11-03_22-00-00.tar", s, sizeof s) != 0 &&
+              cloud_profiles_name_stamp("PPSA01234_2026-11-03_22-00-00.tar", s, sizeof s) != 0,
+          "its stamp back, and only from our names");
+}
+
+int main(void) {
+    names();
+    profiles();
+    prune();
+    fingerprints();
+    urlenc();
+    json_objects();
+    tar();
+    restore_names();
+    if (failures == 0) {
+        printf("✓ cloud backup names, pruning, tar reading and Drive list parsing hold\n");
+        return 0;
+    }
+    printf("✗ %d failure(s)\n", failures);
+    return 1;
+}
