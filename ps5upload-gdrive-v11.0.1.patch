diff -ruN a/payload/include/cloud_drive.h b/payload/include/cloud_drive.h
--- a/payload/include/cloud_drive.h	1969-12-31 21:00:00.000000000 -0300
+++ b/payload/include/cloud_drive.h	2026-11-03 22:51:08.521765984 -0300
@@ -0,0 +1,86 @@
+/* Google sign-in and Google Drive for the cloud save backup (cloud_sync.c).
+ *
+ * Sign-in is OAuth 2.0 for limited-input devices: the console asks Google for a short code, the
+ * user enters it at the address Google gives (google.com/device, on a phone) and allows access,
+ * and the console, polling meanwhile, receives a refresh token. The OAuth client is the user's own
+ * (a "TVs and Limited Input devices" client of a Google Cloud project: its id and secret are set
+ * from the console page). The scope is drive.file: the app sees only the files it created.
+ *
+ * The client, the refresh token and the account's address are kept in CLOUD_AUTH_PATH (mode 0600,
+ * under CLOUD_DIR, which path_policy.c denies to the page's and the PC's file access). The access
+ * token lives in memory and is refreshed when it is about to expire or a call answers 401.
+ *
+ * Every function here does network I/O and may take seconds: call it from a worker thread, never
+ * from a web request. They are safe to call from two threads at once. */
+#ifndef PS5UPLOAD_CLOUD_DRIVE_H
+#define PS5UPLOAD_CLOUD_DRIVE_H
+
+#include <stddef.h>
+#include <stdint.h>
+#include <time.h>
+
+#define CLOUD_DIR "/data/ps5upload/gdrive"
+#define CLOUD_AUTH_PATH CLOUD_DIR "/auth.json"
+#define CLOUD_ROOT_FOLDER "PS5 Saves"
+
+#define CLOUD_ID_MAX 160
+#define CLOUD_SECRET_MAX 160
+
+/* ---- the saved sign-in ---- */
+
+/* Reads CLOUD_AUTH_PATH (once at start; a missing file is no sign-in). */
+void cloud_auth_load(void);
+/* 1 when an OAuth client id is set. */
+int cloud_auth_has_client(void);
+/* 1 when signed in (a refresh token is kept). */
+int cloud_auth_connected(void);
+/* The signed-in account's address ("" when not known). */
+void cloud_auth_email(char *out, size_t cap);
+/* The client id (never the secret) for the page. */
+void cloud_auth_client_id(char *out, size_t cap);
+/* Sets the OAuth client. A different id signs out (the token belongs to the old client). A NULL or
+ * empty secret keeps the one saved. 0, or -1 when it could not be saved. */
+int cloud_auth_set_client(const char *id, const char *secret);
+/* Signs out: the refresh token is revoked at Google (best effort) and forgotten. */
+void cloud_auth_disconnect(void);
+
+/* ---- sign-in with a code ---- */
+
+typedef struct {
+    char device_code[512];
+    char user_code[32];
+    char url[128];
+    int interval;      /* seconds between polls */
+    time_t expires_at; /* the code's end (wall clock) */
+} cloud_device_t;
+
+/* Asks Google for a code. 0, or -1 (`err`). */
+int cloud_device_start(cloud_device_t *d, char *err, size_t ecap);
+/* One poll: 1 signed in (saved), 0 not yet, 2 asked to slow down (add 5 s), -1 refused, expired
+ * or failed (`err`). */
+int cloud_device_poll(const cloud_device_t *d, char *err, size_t ecap);
+
+/* ---- Drive ---- */
+
+typedef struct {
+    char id[CLOUD_ID_MAX];
+    char name[256];
+    uint64_t size;
+} cloud_file_t;
+
+/* The folder `name` in `parent` (NULL: My Drive's top), made when `create` and missing. 1 found or
+ * made (`id` set), 0 missing (create 0), -1 failed. `name` may not hold a quote or a backslash. */
+int cloud_drive_folder(const char *parent, const char *name, int create, char *id, size_t cap, char *err, size_t ecap);
+/* The files (not folders) in `folder`, at most `max`, in Drive's name order. 0, or -1. */
+int cloud_drive_list(const char *folder, cloud_file_t *out, size_t max, size_t *n, char *err, size_t ecap);
+/* The folders in `folder` (size 0), the same way. */
+int cloud_drive_subfolders(const char *folder, cloud_file_t *out, size_t max, size_t *n, char *err, size_t ecap);
+/* Uploads the local file `path` as `name` into `folder` (a resumable upload sent in one piece). */
+int cloud_drive_upload(const char *folder, const char *name, const char *path, volatile int *cancel, char *err,
+                       size_t ecap);
+/* Downloads the file `id` to the local `path`. 0, or -1. */
+int cloud_drive_download(const char *id, const char *path, volatile int *cancel, char *err, size_t ecap);
+/* Deletes the file `id` (one already gone counts as deleted). 0, or -1. */
+int cloud_drive_delete(const char *id, char *err, size_t ecap);
+
+#endif
diff -ruN a/payload/include/cloud_https.h b/payload/include/cloud_https.h
--- a/payload/include/cloud_https.h	1969-12-31 21:00:00.000000000 -0300
+++ b/payload/include/cloud_https.h	2026-11-03 22:51:08.553985424 -0300
@@ -0,0 +1,51 @@
+/* A small HTTPS/1.1 client for the cloud save backup (cloud_drive.c): one request per connection
+ * (Connection: close), TLS 1.2 through the payload's own mbedTLS (mbedtls_ps5_config.h), the
+ * server's certificate checked against Google's roots only (cloud_roots.h) and its name.
+ *
+ * Every wait is bounded: the connect (10 s), each read and write (CLOUD_HTTPS_IO_TIMEOUT_S), the
+ * DNS fallback (3 s per server). A host name is looked up with getaddrinfo first and, when the
+ * console's resolver does not answer, with a plain DNS query to public resolvers.
+ *
+ * A request body comes from memory or streams from a file; a response body goes to memory (capped)
+ * or, for a 2xx answer, streams to a file. */
+#ifndef PS5UPLOAD_CLOUD_HTTPS_H
+#define PS5UPLOAD_CLOUD_HTTPS_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+#define CLOUD_HTTPS_IO_TIMEOUT_S 30
+/* An in-memory response body's default ceiling. */
+#define CLOUD_HTTPS_BODY_MAX (1024u * 1024u)
+
+typedef struct {
+    const char *method;    /* "GET", "POST", "PUT", "DELETE" */
+    const char *url;       /* https://host[:port]/path?query */
+    const char *headers;   /* extra complete "Name: value\r\n" lines, or NULL */
+    const char *body;      /* request body in memory (body_len bytes), or NULL */
+    size_t body_len;
+    const char *body_file; /* or: this file streamed as the body */
+    const char *out_file;  /* a 2xx response body is written here instead of memory (NULL: memory) */
+    size_t max_body;       /* in-memory ceiling (0: CLOUD_HTTPS_BODY_MAX); longer is cut, `truncated` set */
+    volatile int *cancel;  /* polled between blocks when set: non-zero stops the transfer */
+} cloud_https_req_t;
+
+typedef struct {
+    int status;            /* the HTTP status */
+    char location[2048];   /* the Location header ("" when none) */
+    char *body;            /* malloc'd, NUL-terminated (may be NULL when empty or written to a file) */
+    size_t body_len;
+    int truncated;
+    uint64_t file_bytes;   /* bytes written to out_file */
+} cloud_https_resp_t;
+
+/* 0 when an answer came back (any status: read rs->status), -1 when none did (`err` says why:
+ * a lookup, connection, TLS or I/O failure, a cancel, or a bad URL). rs must be released with
+ * cloud_https_resp_free in both cases. */
+int cloud_https_request(const cloud_https_req_t *rq, cloud_https_resp_t *rs, char *err, size_t errcap);
+void cloud_https_resp_free(cloud_https_resp_t *rs);
+
+/* Splits an https URL into host, port and path (with query). 0, or -1 when it is not one. */
+int cloud_https_split_url(const char *url, char *host, size_t hcap, int *port, char *path, size_t pcap);
+
+#endif
diff -ruN a/payload/include/cloud_logic.h b/payload/include/cloud_logic.h
--- a/payload/include/cloud_logic.h	1969-12-31 21:00:00.000000000 -0300
+++ b/payload/include/cloud_logic.h	2026-11-03 22:51:08.589985434 -0300
@@ -0,0 +1,118 @@
+/* The pure parts of the cloud save backup (cloud_sync.c, cloud_drive.c): names, the tar reader,
+ * the Drive reply's file list, form encoding, change fingerprints and which backups to prune.
+ * No I/O, no globals: host-tested by payload/tests/cloud_logic_selftest.c.
+ *
+ * A backup is kept twice, under one stamp (YYYY-MM-DD_HH-MM-SS, the console's local time):
+ *   on the console  /data/ps5upload/save-backups/<user>/<title>/<stamp>_sync/<kind>/...
+ *                   (the console page's own layout, so its Saves screen lists and restores it)
+ *   on Google Drive  PS5 Saves/<user>/<title>/<title>_<stamp>.tar
+ *                   (the same folder as a tar: <kind>/... entries) */
+#ifndef PS5UPLOAD_CLOUD_LOGIC_H
+#define PS5UPLOAD_CLOUD_LOGIC_H
+
+#include <stddef.h>
+#include <stdint.h>
+#include <time.h>
+
+#define CLOUD_STAMP_LEN 19 /* YYYY-MM-DD_HH-MM-SS */
+#define CLOUD_SYNC_SUFFIX "_sync"
+
+/* The save folders a title can have (the console page's SAVE_KINDS), in that order. */
+#define CLOUD_KINDS 4
+extern const char *const cloud_kinds[CLOUD_KINDS];
+/* 1 for the two "meta" kinds, which keep their title folders one level down, in user/. */
+int cloud_kind_is_meta(int k);
+
+/* A title id as the console page takes one: four capital letters and five digits. */
+int cloud_title_ok(const char *s);
+/* A user's home folder name: eight lowercase hex digits. */
+int cloud_user_ok(const char *s);
+
+/* `t` as a stamp in local time (localtime_r) into out[CLOUD_STAMP_LEN + 1]: 0, or -1. */
+int cloud_stamp(char *out, size_t cap, time_t t);
+/* 1 when `s` is exactly a stamp. */
+int cloud_stamp_ok(const char *s);
+/* "<stamp>_sync": the stamp out of a local backup's folder name. 0, or -1 when it is not one. */
+int cloud_local_name_stamp(const char *dir, char *stamp, size_t cap);
+/* "<title>_<stamp>.tar": the Drive file's name. 0, or -1 when it does not fit. */
+int cloud_drive_name(char *out, size_t cap, const char *title, const char *stamp);
+/* The stamp out of a Drive file's name for `title`: 0, or -1 when the name is not one of ours. */
+int cloud_drive_name_stamp(const char *name, const char *title, char *stamp, size_t cap);
+
+/* Of `n` stamps (any order), which go when only the newest `keep` stay: their indexes into `del`
+ * (room for n), oldest first; the number written. keep 0 keeps none. */
+size_t cloud_prune(const char *const *stamps, size_t n, size_t keep, size_t *del);
+
+/* One save file's part of a change fingerprint (`rel` its path inside the save, its size and time).
+ * A save's fingerprint is the sum of its files' parts plus their count, so the order the folder
+ * lists them in does not matter. */
+uint64_t cloud_fp_part(const char *rel, uint64_t size, int64_t mtime);
+
+/* application/x-www-form-urlencoded / query-string escaping of `s` (unreserved characters as they
+ * are, everything else %XX). The full length, like snprintf: >= cap means it did not fit. */
+size_t cloud_urlenc(char *out, size_t cap, const char *s);
+
+/* The objects of a JSON array span (from webui_json_array): *pos starts at 0; each call gives the
+ * next element that is an object as [*obj, *obj + *olen) (braces included, so webui_json_str reads its
+ * keys as top-level ones). 1 an object, 0 the array ended, -1 malformed. Elements that are not
+ * objects are skipped. */
+int cloud_json_next_object(const char *arr, size_t len, size_t *pos, const char **obj, size_t *olen);
+
+/* ---- the profiles file (PS5 Saves/perfis_<stamp>.txt) ----
+ * Which account ID each profile has: a save follows the account ID, so after a profile is lost a
+ * new one given the same ID (Accounts › Users in the PC app) can take the old backups back. */
+
+typedef struct {
+    char uid[9];   /* the /user/home folder, as the backups' folder on Drive */
+    char name[33]; /* "" when not known */
+} cloud_user_t;
+
+typedef struct {
+    int slot;
+    char name[33];
+    char type[18];
+    int flags;
+    uint64_t id; /* 0: no account */
+} cloud_slot_t;
+
+/* The file as text (Portuguese, for the person who reads it). `made` NULL leaves out the line with
+ * the time, which gives the text a change fingerprint uses. A user takes the slot with its name, or,
+ * with one user and one named slot, that slot. The full length, like snprintf. */
+size_t cloud_profiles_text(char *out, size_t cap, const char *made, const cloud_user_t *users, size_t nu,
+                           const cloud_slot_t *slots, size_t ns);
+/* The slot that goes with users[i] (its index into `slots`), or -1: the slot with the user's name,
+ * or, with one user and one named slot, that slot. */
+int cloud_user_slot(const cloud_user_t *users, size_t nu, size_t i, const cloud_slot_t *slots, size_t ns);
+
+/* An account read back from a profiles file. */
+typedef struct {
+    char name[33]; /* the profile's (or the slot's) name, "" when none */
+    char uid[9];   /* its folder, "" for an account without a profile */
+    uint64_t id;
+    char stamp[CLOUD_STAMP_LEN + 1]; /* the file it was in (set by the caller) */
+} cloud_account_t;
+
+/* The accounts with an ID in a profiles file's text, in its order, at most `max`. Their number. */
+size_t cloud_profiles_parse(const char *text, size_t n, cloud_account_t *out, size_t max);
+
+/* "perfis_<stamp>.txt", and its stamp back (0, or -1 when a name is not one). */
+int cloud_profiles_name(char *out, size_t cap, const char *stamp);
+int cloud_profiles_name_stamp(const char *name, char *stamp, size_t cap);
+/* FNV-1a of `n` bytes (a profiles text's fingerprint). */
+uint64_t cloud_fnv(const void *p, size_t n);
+
+/* ---- tar (reading what cloud_sync.c wrote with wf_tar_header) ---- */
+
+enum { CLOUD_TAR_END = 0, CLOUD_TAR_FILE = 1, CLOUD_TAR_DIR = 2, CLOUD_TAR_PAX = 3, CLOUD_TAR_OTHER = 4 };
+
+/* One 512-byte header: its kind, the entry's name (prefix/name joined, the trailing '/' of a folder
+ * dropped) and size. CLOUD_TAR_END for an all-zero block. -1 when the checksum is wrong or the name
+ * does not fit `cap`. */
+int cloud_tar_parse(const uint8_t h[512], char *name, size_t cap, uint64_t *size);
+/* The "path" record of a pax header's data (`n` bytes), copied to `out`: 1 found, 0 none, -1 bad. */
+int cloud_tar_pax_path(const char *data, size_t n, char *out, size_t cap);
+/* 1 when a restored entry may be written: a relative path of plain names (no "", ".", ".."), its
+ * first part one of cloud_kinds, at most 4 parts deep. */
+int cloud_tar_name_ok(const char *name);
+
+#endif
