diff -ruN a/payload/src/webui_cloud.c b/payload/src/webui_cloud.c
--- a/payload/src/webui_cloud.c	1969-12-31 21:00:00.000000000 -0300
+++ b/payload/src/webui_cloud.c	2026-11-03 22:51:09.088907983 -0300
@@ -0,0 +1,184 @@
+/* The console page's Google Drive routes: see include/webui_cloud.h. */
+#include "webui_cloud.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "cloud_drive.h"
+#include "cloud_sync.h"
+#include "webui_codec.h"
+#include "webui_server.h"
+
+/* The route buffer webui_api.c hands every route (its API_OUT_MAX). */
+#define OUT_CAP (256u * 1024u)
+
+static void reply_status(uint8_t *out, int fd) {
+    int n = cloud_status_json((char *)out, OUT_CAP);
+    if (n < 0) webui_send_json(fd, 500, "{\"error\":\"too_large\"}");
+    else webui_send(fd, 200, "application/json", out, (size_t)n);
+}
+
+static void bad(int fd, const char *token) {
+    char b[96];
+    snprintf(b, sizeof b, "{\"error\":\"%s\"}", token);
+    webui_send_json(fd, 400, b);
+}
+
+/* An optional small integer field: `def` when absent, -2 when present but not usable. */
+static int opt_int(const char *b, size_t n, const char *key, int def) {
+    uint64_t v;
+    int rc = webui_json_u64(b, n, key, &v);
+    if (rc == 0) return def;
+    return rc == 1 && v <= 100000 ? (int)v : -2;
+}
+
+void webui_cloud_status(const char *b, size_t n, uint8_t *out, int fd) {
+    (void)b;
+    (void)n;
+    reply_status(out, fd);
+}
+
+void webui_cloud_client(const char *b, size_t n, uint8_t *out, int fd) {
+    char id[CLOUD_ID_MAX], secret[CLOUD_SECRET_MAX];
+    int has_secret;
+    if (webui_json_str(b, n, "client_id", id, sizeof id) != 1 || !id[0] || strpbrk(id, " \t\r\n")) {
+        bad(fd, "bad_client_id");
+        return;
+    }
+    has_secret = webui_json_str(b, n, "client_secret", secret, sizeof secret);
+    if (has_secret < 0 || (has_secret == 1 && strpbrk(secret, " \t\r\n"))) {
+        bad(fd, "bad_client_secret");
+        return;
+    }
+    if (cloud_set_client(id, has_secret == 1 ? secret : NULL) != 0) {
+        webui_send_json(fd, 500, "{\"error\":\"write_failed\"}");
+        return;
+    }
+    reply_status(out, fd);
+}
+
+void webui_cloud_connect(const char *b, size_t n, uint8_t *out, int fd) {
+    int r;
+    (void)b;
+    (void)n;
+    r = cloud_connect_start();
+    if (r < 0) bad(fd, "no_client");
+    else if (r > 0) webui_send_json(fd, 409, "{\"error\":\"busy\"}");
+    else reply_status(out, fd);
+}
+
+void webui_cloud_disconnect(const char *b, size_t n, uint8_t *out, int fd) {
+    (void)b;
+    (void)n;
+    cloud_disconnect();
+    reply_status(out, fd);
+}
+
+void webui_cloud_settings(const char *b, size_t n, uint8_t *out, int fd) {
+    int enabled = -1, on, interval, keep_cloud, keep_local, rc = webui_json_bool(b, n, "enabled", &on);
+    if (rc < 0) {
+        bad(fd, "bad_enabled");
+        return;
+    }
+    if (rc == 1) enabled = on;
+    interval = opt_int(b, n, "interval_min", -1);
+    keep_cloud = opt_int(b, n, "keep_cloud", -1);
+    keep_local = opt_int(b, n, "keep_local", -1);
+    if (interval == -2 || keep_cloud == -2 || keep_local == -2) {
+        bad(fd, interval == -2 ? "bad_interval_min" : keep_cloud == -2 ? "bad_keep_cloud" : "bad_keep_local");
+        return;
+    }
+    if (cloud_settings_set(enabled, interval, keep_cloud, keep_local) != 0) {
+        webui_send_json(fd, 500, "{\"error\":\"write_failed\"}");
+        return;
+    }
+    reply_status(out, fd);
+}
+
+void webui_cloud_run(const char *b, size_t n, uint8_t *out, int fd) {
+    (void)b;
+    (void)n;
+    if (cloud_run_now() != 0) bad(fd, "not_signed_in");
+    else reply_status(out, fd);
+}
+
+void webui_cloud_list(const char *b, size_t n, uint8_t *out, int fd) {
+    char user[16], title[16];
+    int r;
+    if (webui_json_str(b, n, "user", user, sizeof user) != 1) {
+        bad(fd, "bad_user");
+        return;
+    }
+    if (webui_json_str(b, n, "title", title, sizeof title) != 1) {
+        bad(fd, "bad_title");
+        return;
+    }
+    r = cloud_list_start(user, title);
+    if (r < 0) bad(fd, cloud_auth_connected() ? "bad_title" : "not_signed_in");
+    else if (r > 0) webui_send_json(fd, 409, "{\"error\":\"busy\"}");
+    else reply_status(out, fd);
+}
+
+void webui_cloud_profiles(const char *b, size_t n, uint8_t *out, int fd) {
+    int r;
+    (void)b;
+    (void)n;
+    r = cloud_profiles_start();
+    if (r < 0) bad(fd, "not_signed_in");
+    else if (r > 0) webui_send_json(fd, 409, "{\"error\":\"busy\"}");
+    else reply_status(out, fd);
+}
+
+void webui_cloud_apply_account(const char *b, size_t n, uint8_t *out, int fd) {
+    char uid[16], ids[24], *end = NULL;
+    uint64_t slot, id;
+    int r;
+    if (webui_json_u64(b, n, "slot", &slot) != 1 || slot < 1 || slot > 64) {
+        bad(fd, "bad_slot");
+        return;
+    }
+    if (webui_json_str(b, n, "uid", uid, sizeof uid) != 1) {
+        bad(fd, "bad_user");
+        return;
+    }
+    if (webui_json_str(b, n, "id", ids, sizeof ids) != 1 || strncmp(ids, "0x", 2) != 0) {
+        bad(fd, "bad_id");
+        return;
+    }
+    id = strtoull(ids + 2, &end, 16);
+    if (!end || *end || !id) {
+        bad(fd, "bad_id");
+        return;
+    }
+    r = cloud_profile_apply((int)slot, uid, id);
+    if (r == -1) bad(fd, "not_allowed");
+    else if (r != 0) webui_send_json(fd, 500, "{\"error\":\"not_applied\"}");
+    else reply_status(out, fd);
+}
+
+void webui_cloud_fetch(const char *b, size_t n, uint8_t *out, int fd) {
+    char user[16], from[16], title[16], id[CLOUD_ID_MAX], stamp[32];
+    int r, has_from;
+    if (webui_json_str(b, n, "user", user, sizeof user) != 1 || webui_json_str(b, n, "title", title, sizeof title) != 1) {
+        bad(fd, "bad_title");
+        return;
+    }
+    if (webui_json_str(b, n, "id", id, sizeof id) != 1) {
+        bad(fd, "bad_id");
+        return;
+    }
+    if (webui_json_str(b, n, "stamp", stamp, sizeof stamp) != 1) {
+        bad(fd, "bad_stamp");
+        return;
+    }
+    has_from = webui_json_str(b, n, "from", from, sizeof from);
+    if (has_from < 0) {
+        bad(fd, "bad_user");
+        return;
+    }
+    r = cloud_fetch_start(user, has_from == 1 ? from : NULL, title, id, stamp);
+    if (r < 0) bad(fd, cloud_auth_connected() ? "bad_request" : "not_signed_in");
+    else if (r > 0) webui_send_json(fd, 409, "{\"error\":\"busy\"}");
+    else reply_status(out, fd);
+}
