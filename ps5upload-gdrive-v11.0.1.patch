--- a/payload/Makefile	2026-11-03 22:51:08.436660632 -0300
+++ b/payload/Makefile	2026-11-03 22:51:08.416724687 -0300
@@ -104,8 +104,18 @@
                  -DSQLITE_DQS=0 \
                  -DSQLITE_UNTESTABLE=1
 
-INCLUDES := -Iinclude -Ismb -I$(BLAKE3_DIR) -I$(SQLITE_DIR) -Ithird_party/tiny_aes -I$(AVA1) -I$(AVA1)/gen -I$(MONO_DIR) -Igen
-CFLAGS := -Wall -Wextra -Werror -g $(INCLUDES)
+# mbedTLS 3.6 (third_party/mbedtls: its library/ and include/ as released), the TLS client of the save
+# backups to Google Drive (src/cloud_https.c). Only what that needs is compiled in
+# (include/mbedtls_ps5_config.h); every source of the library is built, the ones for modules left out
+# compile to nothing. Built as objects at -O2 and not held to -Werror, like the other third-party code.
+MBEDTLS_DIR := third_party/mbedtls
+MBEDTLS_DEF := -DMBEDTLS_CONFIG_FILE='"mbedtls_ps5_config.h"'
+MBEDTLS_SRCS := $(wildcard $(MBEDTLS_DIR)/library/*.c)
