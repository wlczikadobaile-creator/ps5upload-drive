+static void slot_lines(tb_t *t, const cloud_slot_t *s) {
+    char b64[13];
+    const char *how;
+    if (!s) {
+        tb(t, "   Conta:               nenhuma encontrada para este perfil\n");
+        return;
+    }
+    how = !(s->id && strcmp(s->type, "np") == 0) ? "não ativada" : s->flags == 0x1002 ? "ativada offline" : "ativada";
+    tb(t, "   Conta (slot):        %d%s%s%s\n", s->slot, s->name[0] ? " (\"" : "", s->name, s->name[0] ? "\")" : "");
+    if (s->id) {
+        id_b64(s->id, b64);
+        tb(t, "   ID da conta (hex):   0x%llx\n", (unsigned long long)s->id);
+        tb(t, "   ID da conta (dec):   %llu\n", (unsigned long long)s->id);
+        tb(t, "   ID da conta (b64):   %s\n", b64);
+    } else {
+        tb(t, "   ID da conta:         nenhum\n");
+    }
+    tb(t, "   Estado:              %s (tipo %s, flags 0x%x)\n", how, s->type[0] ? s->type : "-", (unsigned)s->flags);
+}
