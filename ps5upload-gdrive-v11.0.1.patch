+int cloud_user_slot(const cloud_user_t *users, size_t nu, size_t i, const cloud_slot_t *slots, size_t ns) {
+    size_t named = 0;
+    int only = -1;
+    if (i >= nu) return -1;
+    for (size_t j = 0; j < ns && users[i].name[0]; j++)
+        if (strcmp(slots[j].name, users[i].name) == 0) return (int)j;
+    for (size_t j = 0; j < ns; j++)
+        if (slots[j].name[0]) {
+            named++;
+            only = (int)j;
+        }
+    return nu == 1 && named == 1 ? only : -1;
+}
+
+/* The value after "<label>" on a line ([p, e)), spaces skipped; NULL when the line has no label. */
+static const char *after_label(const char *p, const char *e, const char *label) {
+    size_t ll = strlen(label);
+    for (const char *q = p; q + ll <= e; q++)
+        if (memcmp(q, label, ll) == 0) {
+            q += ll;
+            while (q < e && *q == ' ') q++;
+            return q;
+        }
+    return NULL;
+}
+
+static void copy_until(char *dst, size_t cap, const char *p, const char *e, char stop) {
+    size_t k = 0;
+    while (p < e && *p != stop && k + 1 < cap) dst[k++] = *p++;
+    while (k && dst[k - 1] == ' ') k--;
+    dst[k] = '\0';
+}
+
+size_t cloud_profiles_parse(const char *text, size_t n, cloud_account_t *out, size_t max) {
+    cloud_account_t cur;
+    size_t got = 0;
+    const char *p = text, *end = text + n;
+    memset(&cur, 0, sizeof cur);
+    while (p < end && got < max) {
+        const char *e = memchr(p, '\n', (size_t)(end - p)), *v;
+        if (!e) e = end;
+        if (p < e && *p == '=') {
+            memset(&cur, 0, sizeof cur); /* a section starts */
+        } else if (p < e && isdigit((unsigned char)*p)) {
+            /* "N. <name>": a profile starts */
+            const char *q = p;
+            while (q < e && isdigit((unsigned char)*q)) q++;
+            if (q + 1 < e && q[0] == '.' && q[1] == ' ') {
+                memset(&cur, 0, sizeof cur);
+                copy_until(cur.name, sizeof cur.name, q + 2, e, '\n');
+                if (strcmp(cur.name, "(sem nome)") == 0) cur.name[0] = '\0';
+            }
+        } else if ((v = after_label(p, e, "(pasta):")) != NULL) {
+            copy_until(cur.uid, sizeof cur.uid, v, e, ' ');
+            if (!cloud_user_ok(cur.uid)) cur.uid[0] = '\0';
+        } else if ((v = after_label(p, e, "Conta (slot):")) != NULL) {
+            if (!cur.uid[0] && !cur.name[0]) memset(&cur, 0, sizeof cur); /* an account without a profile */
+            {
+                const char *q = memchr(v, '"', (size_t)(e - v));
+                if (q && !cur.uid[0] && !cur.name[0]) copy_until(cur.name, sizeof cur.name, q + 1, e, '"');
+            }
+        } else if ((v = after_label(p, e, "ID da conta (hex):")) != NULL) {
+            uint64_t id = strtoull(v, NULL, 16);
+            if (id) {
+                cur.id = id;
+                out[got++] = cur;
+            }
+            memset(&cur, 0, sizeof cur);
+        }
+        p = e < end ? e + 1 : end;
+    }
+    return got;
+}
