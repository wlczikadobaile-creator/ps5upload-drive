+uint64_t cloud_fp_part(const char *rel, uint64_t size, int64_t mtime) {
+    uint64_t h = 1469598103934665603ull; /* FNV-1a */
+    const unsigned char *p = (const unsigned char *)rel;
+    for (; *p; p++) {
+        h ^= *p;
+        h *= 1099511628211ull;
+    }
+    for (int i = 0; i < 8; i++) {
+        h ^= (size >> (8 * i)) & 0xff;
+        h *= 1099511628211ull;
+    }
+    for (int i = 0; i < 8; i++) {
+        h ^= ((uint64_t)mtime >> (8 * i)) & 0xff;
+        h *= 1099511628211ull;
+    }
+    return h;
+}
+
+size_t cloud_urlenc(char *out, size_t cap, const char *s) {
+    static const char k_hex[] = "0123456789ABCDEF";
+    size_t n = 0;
+    for (const unsigned char *p = (const unsigned char *)s; *p; p++) {
+        if (isalnum(*p) || *p == '-' || *p == '_' || *p == '.' || *p == '~') {
+            if (n + 1 < cap) out[n] = (char)*p;
+            n++;
+        } else {
+            if (n + 3 < cap) {
+                out[n] = '%';
+                out[n + 1] = k_hex[*p >> 4];
+                out[n + 2] = k_hex[*p & 15];
+            }
+            n += 3;
+        }
+    }
+    if (cap) out[n < cap ? n : cap - 1] = '\0';
+    return n;
+}
