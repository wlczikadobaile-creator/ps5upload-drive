+static pthread_mutex_t g_mu = PTHREAD_MUTEX_INITIALIZER;
+static struct {
+    char client_id[CLOUD_ID_MAX];
+    char client_secret[CLOUD_SECRET_MAX];
+    char refresh[TOKEN_MAX];
+    char email[256];
+    char access[TOKEN_MAX];
+    time_t access_until; /* monotonic seconds */
+} g;
+
+static time_t mono_s(void) {
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return ts.tv_sec;
+}
+
+static void say(char *err, size_t cap, const char *fmt, const char *a) {
+    if (err && cap) snprintf(err, cap, fmt, a ? a : "");
+}
+
+/* ---- the saved sign-in ---- */
+
+/* Writes g's client, token and email to CLOUD_AUTH_PATH (a temporary file renamed over it). With
+ * g_mu held. */
+static int auth_save_locked(void) {
+    char *buf = malloc(AUTH_FILE_MAX), tmp[256];
+    size_t at = 0;
+    int fd, rc = -1;
+    if (!buf) return -1;
+    (void)mkdir("/data/ps5upload", 0777);
+    (void)mkdir(CLOUD_DIR, 0700);
+    at += (size_t)snprintf(buf, AUTH_FILE_MAX, "{\"client_id\":\"");
+    at += webui_json_escape(buf + at, AUTH_FILE_MAX - at, g.client_id, strlen(g.client_id));
+    if (at < AUTH_FILE_MAX) at += (size_t)snprintf(buf + at, AUTH_FILE_MAX - at, "\",\"client_secret\":\"");
+    if (at < AUTH_FILE_MAX) at += webui_json_escape(buf + at, AUTH_FILE_MAX - at, g.client_secret, strlen(g.client_secret));
+    if (at < AUTH_FILE_MAX) at += (size_t)snprintf(buf + at, AUTH_FILE_MAX - at, "\",\"refresh_token\":\"");
+    if (at < AUTH_FILE_MAX) at += webui_json_escape(buf + at, AUTH_FILE_MAX - at, g.refresh, strlen(g.refresh));
+    if (at < AUTH_FILE_MAX) at += (size_t)snprintf(buf + at, AUTH_FILE_MAX - at, "\",\"email\":\"");
+    if (at < AUTH_FILE_MAX) at += webui_json_escape(buf + at, AUTH_FILE_MAX - at, g.email, strlen(g.email));
+    if (at < AUTH_FILE_MAX) at += (size_t)snprintf(buf + at, AUTH_FILE_MAX - at, "\"}\n");
+    if (at >= AUTH_FILE_MAX) goto out;
+    snprintf(tmp, sizeof tmp, "%s.tmp", CLOUD_AUTH_PATH);
+    fd = open(tmp, O_WRONLY | O_CREAT | O_TRUNC, 0600);
+    if (fd < 0) goto out;
+    if (write(fd, buf, at) == (ssize_t)at && fsync(fd) == 0) rc = 0;
+    close(fd);
+    if (rc == 0 && rename(tmp, CLOUD_AUTH_PATH) != 0) rc = -1;
+    if (rc != 0) unlink(tmp);
+    else (void)chmod(CLOUD_AUTH_PATH, 0600);
+out:
+    free(buf);
+    return rc;
+}
+
+void cloud_auth_load(void) {
+    char *buf = malloc(AUTH_FILE_MAX);
+    int fd;
+    ssize_t n;
+    if (!buf) return;
+    fd = open(CLOUD_AUTH_PATH, O_RDONLY);
+    if (fd < 0) {
+        free(buf);
+        return;
+    }
+    n = read(fd, buf, AUTH_FILE_MAX - 1);
+    close(fd);
+    if (n > 0) {
+        pthread_mutex_lock(&g_mu);
+        if (webui_json_str(buf, (size_t)n, "client_id", g.client_id, sizeof g.client_id) != 1) g.client_id[0] = '\0';
+        if (webui_json_str(buf, (size_t)n, "client_secret", g.client_secret, sizeof g.client_secret) != 1)
+            g.client_secret[0] = '\0';
+        if (webui_json_str(buf, (size_t)n, "refresh_token", g.refresh, sizeof g.refresh) != 1) g.refresh[0] = '\0';
+        if (webui_json_str(buf, (size_t)n, "email", g.email, sizeof g.email) != 1) g.email[0] = '\0';
+        pthread_mutex_unlock(&g_mu);
+    }
+    free(buf);
+}
+
+int cloud_auth_has_client(void) {
+    int r;
+    pthread_mutex_lock(&g_mu);
+    r = g.client_id[0] != '\0';
+    pthread_mutex_unlock(&g_mu);
+    return r;
+}
+
+int cloud_auth_connected(void) {
+    int r;
+    pthread_mutex_lock(&g_mu);
+    r = g.refresh[0] != '\0';
+    pthread_mutex_unlock(&g_mu);
+    return r;
+}
+
+void cloud_auth_email(char *out, size_t cap) {
+    pthread_mutex_lock(&g_mu);
+    snprintf(out, cap, "%s", g.email);
+    pthread_mutex_unlock(&g_mu);
+}
+
+void cloud_auth_client_id(char *out, size_t cap) {
+    pthread_mutex_lock(&g_mu);
+    snprintf(out, cap, "%s", g.client_id);
+    pthread_mutex_unlock(&g_mu);
+}
+
+int cloud_auth_set_client(const char *id, const char *secret) {
+    int rc;
+    if (!id || strlen(id) >= sizeof g.client_id || (secret && strlen(secret) >= sizeof g.client_secret)) return -1;
+    pthread_mutex_lock(&g_mu);
+    if (strcmp(id, g.client_id) != 0) {
+        g.refresh[0] = g.access[0] = g.email[0] = '\0';
+        g.access_until = 0;
+    }
+    snprintf(g.client_id, sizeof g.client_id, "%s", id);
+    if (secret && secret[0]) snprintf(g.client_secret, sizeof g.client_secret, "%s", secret);
+    rc = auth_save_locked();
+    pthread_mutex_unlock(&g_mu);
+    return rc;
+}
+
+/* A form body "k=v&k=v" with every value escaped: 0, or -1 when it does not fit. */
+static int form(char *out, size_t cap, const char *const *kv, size_t pairs) {
+    size_t at = 0;
+    for (size_t i = 0; i < pairs; i++) {
+        int k = snprintf(out + at, cap - at, "%s%s=", i ? "&" : "", kv[2 * i]);
+        if (k < 0 || (size_t)k >= cap - at) return -1;
+        at += (size_t)k;
+        at += cloud_urlenc(out + at, cap - at, kv[2 * i + 1]);
+        if (at >= cap) return -1;
+    }
+    return 0;
+}
+
+static int post_form(const char *url, const char *body, cloud_https_resp_t *rs, char *err, size_t ecap) {
+    cloud_https_req_t rq;
+    memset(&rq, 0, sizeof rq);
+    rq.method = "POST";
+    rq.url = url;
+    rq.headers = "Content-Type: application/x-www-form-urlencoded\r\n";
+    rq.body = body;
+    rq.body_len = strlen(body);
+    return cloud_https_request(&rq, rs, err, ecap);
+}
+
+void cloud_auth_disconnect(void) {
+    char tok[TOKEN_MAX], *body;
+    pthread_mutex_lock(&g_mu);
+    snprintf(tok, sizeof tok, "%s", g.refresh);
+    g.refresh[0] = g.access[0] = g.email[0] = '\0';
+    g.access_until = 0;
+    (void)auth_save_locked();
+    pthread_mutex_unlock(&g_mu);
+    if (!tok[0]) return;
+    body = malloc(3 * TOKEN_MAX + 16);
+    if (body) {
+        const char *kv[] = { "token", tok };
+        cloud_https_resp_t rs;
+        char err[128];
+        if (form(body, 3 * TOKEN_MAX + 16, kv, 1) == 0) {
+            (void)post_form(OAUTH_REVOKE_URL, body, &rs, err, sizeof err);
+            cloud_https_resp_free(&rs);
+        }
+        free(body);
+    }
+}
+
+/* Google's reason for a failed answer: OAuth's top-level "error" (and its description), or Drive's
+ * error.message. */
+static void google_error(const cloud_https_resp_t *rs, const char *what, char *err, size_t ecap) {
+    char code[64] = "", desc[256] = "";
+    const char *b = rs->body ? rs->body : "";
+    size_t n = rs->body_len;
+    if (webui_json_str(b, n, "error", code, sizeof code) == 1) {
+        if (webui_json_str(b, n, "error_description", desc, sizeof desc) != 1) desc[0] = '\0';
+    } else {
+        const char *m = strstr(b, "\"message\"");
+        if (m && (m = strchr(m + 9, '"')) != NULL) {
+            const char *e = strchr(m + 1, '"');
+            size_t l = e ? (size_t)(e - m - 1) : 0;
+            if (l >= sizeof desc) l = sizeof desc - 1;
+            memcpy(desc, m + 1, l);
+            desc[l] = '\0';
+        }
+    }
+    if (err && ecap)
+        snprintf(err, ecap, "%s: HTTP %d%s%s%s%s", what, rs->status, code[0] ? " " : "", code, desc[0] ? ": " : "",
+                 desc);
+}
+
+/* ---- tokens ---- */
+
+/* A valid access token into `out` (refreshed when it is about to end, or always with `force`).
+ * 0, or -1: not signed in, Google refused the token (signed out), or no answer. */
+/* Two threads never refresh at once; g_mu itself is only held for moments, never through a
+ * request (the page's status route reads the sign-in under it). */
+static pthread_mutex_t g_refresh_mu = PTHREAD_MUTEX_INITIALIZER;
+
+static int access_token(char *out, size_t cap, int force, char *err, size_t ecap) {
+    char *body = malloc(4 * TOKEN_MAX), *used = malloc(TOKEN_MAX), *fresh = malloc(TOKEN_MAX);
+    cloud_https_resp_t rs;
+    int rc = -1, ok;
+    uint64_t exp = 0;
+    memset(&rs, 0, sizeof rs);
+    if (!body || !used || !fresh) {
+        free(body);
+        free(used);
+        free(fresh);
+        return -1;
+    }
+    pthread_mutex_lock(&g_refresh_mu);
+    pthread_mutex_lock(&g_mu);
+    if (!g.refresh[0] || !g.client_id[0]) {
+        pthread_mutex_unlock(&g_mu);
+        say(err, ecap, "not signed in to Google%s", "");
+        goto out;
+    }
+    if (!force && g.access[0] && mono_s() + 60 < g.access_until) {
+        snprintf(out, cap, "%s", g.access);
+        pthread_mutex_unlock(&g_mu);
+        rc = 0;
+        goto out;
+    }
+    snprintf(used, TOKEN_MAX, "%s", g.refresh);
+    {
+        const char *kv[] = { "client_id", g.client_id, "client_secret", g.client_secret, "refresh_token", g.refresh,
+                             "grant_type", "refresh_token" };
+        ok = form(body, 4 * TOKEN_MAX, kv, 4) == 0;
+    }
+    pthread_mutex_unlock(&g_mu);
+    if (!ok || post_form(OAUTH_TOKEN_URL, body, &rs, err, ecap) != 0) goto out;
+    if (rs.status == 200 && webui_json_str(rs.body, rs.body_len, "access_token", fresh, TOKEN_MAX) == 1) {
+        if (webui_json_u64(rs.body, rs.body_len, "expires_in", &exp) != 1) exp = 3600;
+        pthread_mutex_lock(&g_mu);
+        /* unless the user signed out (or in again) meanwhile */
+        if (strcmp(g.refresh, used) == 0) {
+            snprintf(g.access, sizeof g.access, "%s", fresh);
+            g.access_until = mono_s() + (time_t)exp;
+        }
+        pthread_mutex_unlock(&g_mu);
+        snprintf(out, cap, "%s", fresh);
+        rc = 0;
+    } else {
+        char code[64] = "";
+        google_error(&rs, "google sign-in", err, ecap);
+        if (webui_json_str(rs.body ? rs.body : "", rs.body_len, "error", code, sizeof code) == 1 &&
+            (strcmp(code, "invalid_grant") == 0 || strcmp(code, "invalid_client") == 0 ||
+             strcmp(code, "unauthorized_client") == 0)) {
+            /* the token was revoked, expired or belongs to another client: signed out */
+            pthread_mutex_lock(&g_mu);
+            if (strcmp(g.refresh, used) == 0) {
+                g.refresh[0] = g.access[0] = '\0';
+                g.access_until = 0;
+                (void)auth_save_locked();
+            }
+            pthread_mutex_unlock(&g_mu);
+            say(err, ecap, "Google signed this PS5 out (%s): connect again", code);
+        }
+    }
+out:
+    pthread_mutex_unlock(&g_refresh_mu);
+    cloud_https_resp_free(&rs);
+    free(body);
+    free(used);
+    free(fresh);
+    return rc;
+}
+
+/* ---- sign-in with a code ---- */
+
+int cloud_device_start(cloud_device_t *d, char *err, size_t ecap) {
+    char body[1024], id[CLOUD_ID_MAX];
+    cloud_https_resp_t rs;
+    uint64_t v;
+    int rc = -1;
+    memset(d, 0, sizeof *d);
+    cloud_auth_client_id(id, sizeof id);
+    if (!id[0]) {
+        say(err, ecap, "set the Google OAuth client first%s", "");
+        return -1;
+    }
+    {
+        const char *kv[] = { "client_id", id, "scope", DRIVE_SCOPE };
+        if (form(body, sizeof body, kv, 2) != 0) return -1;
+    }
+    if (post_form(OAUTH_DEVICE_URL, body, &rs, err, ecap) != 0) goto out;
+    if (rs.status != 200 ||
+        webui_json_str(rs.body, rs.body_len, "device_code", d->device_code, sizeof d->device_code) != 1 ||
+        webui_json_str(rs.body, rs.body_len, "user_code", d->user_code, sizeof d->user_code) != 1) {
+        google_error(&rs, "google code", err, ecap);
+        goto out;
+    }
+    if (webui_json_str(rs.body, rs.body_len, "verification_url", d->url, sizeof d->url) != 1 &&
+        webui_json_str(rs.body, rs.body_len, "verification_uri", d->url, sizeof d->url) != 1)
+        snprintf(d->url, sizeof d->url, "https://www.google.com/device");
+    d->interval = webui_json_u64(rs.body, rs.body_len, "interval", &v) == 1 && v > 0 && v < 60 ? (int)v : 5;
+    d->expires_at = time(NULL) + (webui_json_u64(rs.body, rs.body_len, "expires_in", &v) == 1 ? (time_t)v : 1800);
+    rc = 0;
+out:
+    cloud_https_resp_free(&rs);
+    return rc;
+}
+
+/* The signed-in account's address, from Drive's about (best effort). */
+static void fetch_email(void) {
+    char tok[TOKEN_MAX], hdr[TOKEN_MAX + 64], err[128];
+    cloud_https_req_t rq;
+    cloud_https_resp_t rs;
+    if (access_token(tok, sizeof tok, 0, err, sizeof err) != 0) return;
+    snprintf(hdr, sizeof hdr, "Authorization: Bearer %s\r\n", tok);
+    memset(&rq, 0, sizeof rq);
+    rq.method = "GET";
+    rq.url = "https://www.googleapis.com/drive/v3/about?fields=user(emailAddress)";
+    rq.headers = hdr;
+    if (cloud_https_request(&rq, &rs, err, sizeof err) == 0 && rs.status == 200 && rs.body) {
+        const char *m = strstr(rs.body, "\"emailAddress\"");
+        if (m && (m = strchr(m + 14, '"')) != NULL) {
+            const char *e = strchr(m + 1, '"');
+            if (e && (size_t)(e - m - 1) < sizeof g.email) {
+                pthread_mutex_lock(&g_mu);
+                memcpy(g.email, m + 1, (size_t)(e - m - 1));
+                g.email[e - m - 1] = '\0';
+                (void)auth_save_locked();
+                pthread_mutex_unlock(&g_mu);
+            }
+        }
+    }
+    cloud_https_resp_free(&rs);
+}
+
+int cloud_device_poll(const cloud_device_t *d, char *err, size_t ecap) {
+    char *body = malloc(4096), code[64] = "";
+    cloud_https_resp_t rs;
+    uint64_t exp = 0;
+    int rc = -1;
+    if (!body) return -1;
+    if (time(NULL) > d->expires_at) {
+        say(err, ecap, "the code expired%s", "");
+        free(body);
+        return -1;
+    }
+    pthread_mutex_lock(&g_mu);
+    {
+        const char *kv[] = { "client_id", g.client_id, "client_secret", g.client_secret, "device_code", d->device_code,
+                             "grant_type", "urn:ietf:params:oauth:grant-type:device_code" };
+        if (form(body, 4096, kv, 4) != 0) {
+            pthread_mutex_unlock(&g_mu);
+            free(body);
+            return -1;
+        }
+    }
+    pthread_mutex_unlock(&g_mu);
+    if (post_form(OAUTH_TOKEN_URL, body, &rs, err, ecap) != 0) {
+        /* no answer this time: try again at the next poll */
+        rc = 0;
+        goto out;
+    }
+    if (rs.status == 200) {
+        char refresh[TOKEN_MAX], access[TOKEN_MAX];
+        if (webui_json_str(rs.body, rs.body_len, "refresh_token", refresh, sizeof refresh) != 1 ||
+            webui_json_str(rs.body, rs.body_len, "access_token", access, sizeof access) != 1) {
+            say(err, ecap, "Google gave no refresh token%s", "");
+            goto out;
+        }
+        if (webui_json_u64(rs.body, rs.body_len, "expires_in", &exp) != 1) exp = 3600;
+        pthread_mutex_lock(&g_mu);
+        snprintf(g.refresh, sizeof g.refresh, "%s", refresh);
+        snprintf(g.access, sizeof g.access, "%s", access);
+        g.access_until = mono_s() + (time_t)exp;
+        g.email[0] = '\0';
+        rc = auth_save_locked() == 0 ? 1 : -1;
+        pthread_mutex_unlock(&g_mu);
+        if (rc != 1) say(err, ecap, "could not save the sign-in on the PS5%s", "");
+        else fetch_email();
+        goto out;
+    }
+    if (webui_json_str(rs.body ? rs.body : "", rs.body_len, "error", code, sizeof code) == 1) {
+        if (strcmp(code, "authorization_pending") == 0) {
+            rc = 0;
+            goto out;
+        }
+        if (strcmp(code, "slow_down") == 0) {
+            rc = 2;
+            goto out;
+        }
+    }
+    google_error(&rs, "google sign-in", err, ecap);
+out:
+    cloud_https_resp_free(&rs);
+    free(body);
+    return rc;
+}
+
+/* ---- Drive ---- */
+
+typedef struct {
+    const char *method, *url, *ctype, *extra;
+    const char *body;
+    size_t body_len;
+    const char *body_file, *out_file;
+    volatile int *cancel;
+} drive_rq_t;
+
+/* One Drive call with the access token; a 401 refreshes it and tries once more. 0 when it answered
+ * (rs->status), -1 otherwise. */
+static int drive_call(const drive_rq_t *d, cloud_https_resp_t *rs, char *err, size_t ecap) {
+    char *tok = malloc(TOKEN_MAX), *hdr = malloc(TOKEN_MAX + 1024);
+    int rc = -1;
+    memset(rs, 0, sizeof *rs);
+    if (!tok || !hdr) goto out;
+    for (int attempt = 0; attempt < 2; attempt++) {
+        cloud_https_req_t rq;
+        if (access_token(tok, TOKEN_MAX, attempt > 0, err, ecap) != 0) goto out;
+        snprintf(hdr, TOKEN_MAX + 1024, "Authorization: Bearer %s\r\n%s%s%s%s", tok, d->ctype ? "Content-Type: " : "",
+                 d->ctype ? d->ctype : "", d->ctype ? "\r\n" : "", d->extra ? d->extra : "");
+        memset(&rq, 0, sizeof rq);
+        rq.method = d->method;
+        rq.url = d->url;
+        rq.headers = hdr;
+        rq.body = d->body;
+        rq.body_len = d->body_len;
+        rq.body_file = d->body_file;
+        rq.out_file = d->out_file;
+        rq.cancel = d->cancel;
+        cloud_https_resp_free(rs);
+        if (cloud_https_request(&rq, rs, err, ecap) != 0) goto out;
+        if (rs->status != 401) break;
+    }
+    rc = 0;
+out:
+    free(tok);
+    free(hdr);
+    return rc;
+}
+
+static int name_ok(const char *s) { return s && s[0] && !strchr(s, '\'') && !strchr(s, '\\') && !strchr(s, '"'); }
+
+int cloud_drive_folder(const char *parent, const char *name, int create, char *id, size_t cap, char *err, size_t ecap) {
+    char q[512], *url = malloc(2048);
+    drive_rq_t d;
+    cloud_https_resp_t rs;
+    const char *arr, *obj;
+    size_t alen, olen, pos = 0;
+    int rc = -1;
+    if (!url) return -1;
+    if (!name_ok(name) || (parent && !name_ok(parent))) {
+        say(err, ecap, "bad folder name%s", "");
+        free(url);
+        return -1;
+    }
+    snprintf(q, sizeof q, "name='%s' and mimeType='" FOLDER_MIME "' and '%s' in parents and trashed=false", name,
+             parent ? parent : "root");
+    {
+        size_t at = (size_t)snprintf(url, 2048, DRIVE_FILES_URL "?spaces=drive&fields=files(id)&pageSize=10&q=");
+        if (cloud_urlenc(url + at, 2048 - at, q) >= 2048 - at) {
+            free(url);
+            return -1;
+        }
+    }
+    memset(&d, 0, sizeof d);
+    d.method = "GET";
+    d.url = url;
+    if (drive_call(&d, &rs, err, ecap) != 0) goto out;
+    if (rs.status != 200) {
+        google_error(&rs, "drive folder", err, ecap);
+        goto out;
+    }
+    if (webui_json_array(rs.body, rs.body_len, "files", &arr, &alen) == 1 &&
+        cloud_json_next_object(arr, alen, &pos, &obj, &olen) == 1 && webui_json_str(obj, olen, "id", id, cap) == 1) {
+        rc = 1;
+        goto out;
+    }
+    if (!create) {
+        rc = 0;
+        goto out;
+    }
+    {
+        char body[512];
+        int bl = parent ? snprintf(body, sizeof body, "{\"name\":\"%s\",\"mimeType\":\"" FOLDER_MIME "\",\"parents\":[\"%s\"]}",
+                                   name, parent)
+                        : snprintf(body, sizeof body, "{\"name\":\"%s\",\"mimeType\":\"" FOLDER_MIME "\"}", name);
+        cloud_https_resp_free(&rs);
+        memset(&d, 0, sizeof d);
+        d.method = "POST";
+        d.url = DRIVE_FILES_URL "?fields=id";
+        d.ctype = "application/json; charset=UTF-8";
+        d.body = body;
+        d.body_len = (size_t)bl;
+        if (drive_call(&d, &rs, err, ecap) != 0) goto out;
+        if (rs.status != 200 || webui_json_str(rs.body, rs.body_len, "id", id, cap) != 1) {
+            google_error(&rs, "drive make folder", err, ecap);
+            goto out;
+        }
+        rc = 1;
+    }
+out:
+    cloud_https_resp_free(&rs);
+    free(url);
+    return rc;
+}
+
+static int list_in(const char *folder, int folders, cloud_file_t *out, size_t max, size_t *n, char *err,
+                   size_t ecap) {
+    char q[256], *url = malloc(4096), *page = malloc(1024);
+    int rc = -1;
+    *n = 0;
+    if (!url || !page) goto done;
+    page[0] = '\0';
+    if (!name_ok(folder)) {
+        say(err, ecap, "bad folder id%s", "");
+        goto done;
+    }
+    snprintf(q, sizeof q, "'%s' in parents and trashed=false and mimeType%s'" FOLDER_MIME "'", folder,
+             folders ? "=" : "!=");
+    for (int pages = 0; pages < 20; pages++) {
+        drive_rq_t d;
+        cloud_https_resp_t rs;
+        const char *arr, *obj;
+        size_t alen, olen, pos = 0, at;
+        at = (size_t)snprintf(url, 4096,
+                              DRIVE_FILES_URL "?spaces=drive&pageSize=1000&orderBy=name&fields=nextPageToken,files(id,name,size)&q=");
+        at += cloud_urlenc(url + at, 4096 - at, q);
+        if (page[0] && at < 4096) {
+            at += (size_t)snprintf(url + at, 4096 - at, "&pageToken=");
+            if (at < 4096) at += cloud_urlenc(url + at, 4096 - at, page);
+        }
+        if (at >= 4096) goto done;
+        memset(&d, 0, sizeof d);
+        d.method = "GET";
+        d.url = url;
+        if (drive_call(&d, &rs, err, ecap) != 0) {
+            cloud_https_resp_free(&rs);
+            goto done;
+        }
+        if (rs.status != 200) {
+            google_error(&rs, "drive list", err, ecap);
+            cloud_https_resp_free(&rs);
+            goto done;
+        }
+        if (webui_json_array(rs.body, rs.body_len, "files", &arr, &alen) == 1) {
+            while (*n < max && cloud_json_next_object(arr, alen, &pos, &obj, &olen) == 1) {
+                char sz[32];
+                cloud_file_t *f = &out[*n];
+                if (webui_json_str(obj, olen, "id", f->id, sizeof f->id) != 1 ||
+                    webui_json_str(obj, olen, "name", f->name, sizeof f->name) != 1)
+                    continue;
+                f->size = webui_json_str(obj, olen, "size", sz, sizeof sz) == 1 ? strtoull(sz, NULL, 10) : 0;
+                (*n)++;
+            }
+        }
+        if (*n >= max || webui_json_str(rs.body, rs.body_len, "nextPageToken", page, 1024) != 1) page[0] = '\0';
+        cloud_https_resp_free(&rs);
+        if (!page[0]) break;
+    }
+    rc = 0;
+done:
+    free(url);
+    free(page);
+    return rc;
+}
+
+int cloud_drive_list(const char *folder, cloud_file_t *out, size_t max, size_t *n, char *err, size_t ecap) {
+    return list_in(folder, 0, out, max, n, err, ecap);
+}
+
+int cloud_drive_subfolders(const char *folder, cloud_file_t *out, size_t max, size_t *n, char *err, size_t ecap) {
+    return list_in(folder, 1, out, max, n, err, ecap);
+}
+
+int cloud_drive_upload(const char *folder, const char *name, const char *path, volatile int *cancel, char *err,
+                       size_t ecap) {
+    char meta[512], extra[160], *session = NULL;
+    struct stat st;
+    drive_rq_t d;
+    cloud_https_resp_t rs;
+    int rc = -1, ml;
+    if (!name_ok(folder) || !name_ok(name)) {
+        say(err, ecap, "bad name%s", "");
+        return -1;
+    }
+    if (stat(path, &st) != 0) {
+        say(err, ecap, "stat: %s", strerror(errno));
+        return -1;
+    }
+    ml = snprintf(meta, sizeof meta, "{\"name\":\"%s\",\"parents\":[\"%s\"]}", name, folder);
+    snprintf(extra, sizeof extra, "X-Upload-Content-Type: application/x-tar\r\nX-Upload-Content-Length: %llu\r\n",
+             (unsigned long long)st.st_size);
+    memset(&d, 0, sizeof d);
+    d.method = "POST";
+    d.url = DRIVE_UPLOAD_URL "?uploadType=resumable&fields=id";
+    d.ctype = "application/json; charset=UTF-8";
+    d.extra = extra;
+    d.body = meta;
+    d.body_len = (size_t)ml;
+    if (drive_call(&d, &rs, err, ecap) != 0) goto out;
+    if (rs.status != 200 || !rs.location[0]) {
+        google_error(&rs, "drive upload start", err, ecap);
+        goto out;
+    }
+    session = strdup(rs.location);
+    cloud_https_resp_free(&rs);
+    if (!session) goto out;
+    memset(&d, 0, sizeof d);
+    d.method = "PUT";
+    d.url = session;
+    d.ctype = "application/x-tar";
+    d.body_file = path;
+    d.cancel = cancel;
+    if (drive_call(&d, &rs, err, ecap) != 0) goto out;
+    if (rs.status != 200 && rs.status != 201) {
+        google_error(&rs, "drive upload", err, ecap);
+        goto out;
+    }
+    rc = 0;
+out:
+    cloud_https_resp_free(&rs);
+    free(session);
+    return rc;
+}
+
+int cloud_drive_download(const char *id, const char *path, volatile int *cancel, char *err, size_t ecap) {
+    char url[512];
+    drive_rq_t d;
+    cloud_https_resp_t rs;
+    int rc = -1;
+    if (!name_ok(id)) {
+        say(err, ecap, "bad file id%s", "");
+        return -1;
+    }
+    snprintf(url, sizeof url, DRIVE_FILES_URL "/%s?alt=media", id);
+    memset(&d, 0, sizeof d);
+    d.method = "GET";
+    d.url = url;
+    d.out_file = path;
+    d.cancel = cancel;
+    if (drive_call(&d, &rs, err, ecap) != 0) goto out;
+    if ((rs.status == 302 || rs.status == 303 || rs.status == 307) && rs.location[0]) {
+        char *loc = strdup(rs.location);
+        cloud_https_resp_free(&rs);
+        if (!loc) goto out;
+        d.url = loc;
+        rc = drive_call(&d, &rs, err, ecap);
+        free(loc);
+        if (rc != 0) goto out;
+        rc = -1;
+    }
+    if (rs.status != 200) {
+        google_error(&rs, "drive download", err, ecap);
+        unlink(path);
+        goto out;
+    }
+    rc = 0;
+out:
+    cloud_https_resp_free(&rs);
+    return rc;
+}
+
+int cloud_drive_delete(const char *id, char *err, size_t ecap) {
+    char url[512];
+    drive_rq_t d;
+    cloud_https_resp_t rs;
+    int rc = -1;
+    if (!name_ok(id)) return -1;
+    snprintf(url, sizeof url, DRIVE_FILES_URL "/%s", id);
+    memset(&d, 0, sizeof d);
+    d.method = "DELETE";
+    d.url = url;
+    if (drive_call(&d, &rs, err, ecap) != 0) goto out;
+    if (rs.status != 204 && rs.status != 200 && rs.status != 404) {
+        google_error(&rs, "drive delete", err, ecap);
+        goto out;
+    }
+    rc = 0;
+out:
+    cloud_https_resp_free(&rs);
+    return rc;
+}
