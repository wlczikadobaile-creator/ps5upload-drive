+/* ---- tar ---- */
+
+static uint64_t octal_field(const uint8_t *p, size_t n) {
+    uint64_t v = 0;
+    size_t i = 0;
+    if (n && (p[0] & 0x80)) { /* base-256 */
+        for (i = 1; i < n; i++) v = (v << 8) | p[i];
+        return v;
+    }
+    while (i < n && (p[i] == ' ' || p[i] == '\0')) i++;
+    for (; i < n && p[i] >= '0' && p[i] <= '7'; i++) v = (v << 3) | (uint64_t)(p[i] - '0');
+    return v;
+}
+
+int cloud_tar_parse(const uint8_t h[512], char *name, size_t cap, uint64_t *size) {
+    unsigned sum = 0, want;
+    size_t nl, pl, at = 0;
+    int zero = 1;
+    for (int i = 0; i < 512; i++)
+        if (h[i]) {
+            zero = 0;
+            break;
+        }
+    if (zero) return CLOUD_TAR_END;
+    for (int i = 0; i < 512; i++) sum += (i >= 148 && i < 156) ? (unsigned)' ' : (unsigned)h[i];
+    want = (unsigned)octal_field(h + 148, 8);
+    if (sum != want) return -1;
+    *size = octal_field(h + 124, 12);
+    pl = strnlen((const char *)h + 345, 155);
+    nl = strnlen((const char *)h, 100);
+    if (pl + nl + 2 > cap) return -1;
+    if (pl && memcmp(h + 257, "ustar", 5) == 0) {
+        memcpy(name, h + 345, pl);
+        at = pl;
+        name[at++] = '/';
+    }
+    memcpy(name + at, h, nl);
+    at += nl;
+    while (at > 1 && name[at - 1] == '/') at--;
+    name[at] = '\0';
+    switch (h[156]) {
+    case '0':
+    case '\0':
+    case '7': return CLOUD_TAR_FILE;
+    case '5': return CLOUD_TAR_DIR;
+    case 'x': return CLOUD_TAR_PAX;
+    default: return CLOUD_TAR_OTHER;
+    }
+}
+
+int cloud_tar_pax_path(const char *data, size_t n, char *out, size_t cap) {
+    size_t i = 0;
+    while (i < n) {
+        char *end;
+        unsigned long rl = strtoul(data + i, &end, 10);
+        const char *sp, *eq, *rec_end;
+        if (end == data + i || rl == 0 || i + rl > n) return -1;
+        rec_end = data + i + rl;
+        sp = end;
+        if (*sp != ' ') return -1;
+        eq = memchr(sp + 1, '=', (size_t)(rec_end - sp - 1));
+        if (!eq || rec_end[-1] != '\n') return -1;
+        if ((size_t)(eq - sp - 1) == 4 && memcmp(sp + 1, "path", 4) == 0) {
+            size_t vl = (size_t)(rec_end - 1 - (eq + 1));
+            if (vl + 1 > cap) return -1;
+            memcpy(out, eq + 1, vl);
+            while (vl > 1 && out[vl - 1] == '/') vl--;
+            out[vl] = '\0';
+            return 1;
+        }
+        i += rl;
+    }
+    return 0;
+}
+
+int cloud_tar_name_ok(const char *name) {
+    const char *p = name;
+    int parts = 0, kind = 0;
+    if (!name || !name[0] || name[0] == '/') return 0;
+    while (*p) {
+        const char *slash = strchr(p, '/');
+        size_t l = slash ? (size_t)(slash - p) : strlen(p);
+        if (l == 0 || (l == 1 && p[0] == '.') || (l == 2 && p[0] == '.' && p[1] == '.')) return 0;
+        for (size_t i = 0; i < l; i++)
+            if ((unsigned char)p[i] < 0x20 || p[i] == '\\') return 0;
+        if (parts == 0) {
+            for (int k = 0; k < CLOUD_KINDS; k++)
+                if (strlen(cloud_kinds[k]) == l && memcmp(cloud_kinds[k], p, l) == 0) kind = 1;
+            if (!kind) return 0;
+        }
+        if (++parts > 4) return 0;
+        if (!slash) break;
+        p = slash + 1;
+        if (!*p) return 0;
+    }
+    return 1;
+}
