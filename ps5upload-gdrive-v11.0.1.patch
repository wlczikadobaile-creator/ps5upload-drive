+
+  const apply = useCallback(
+    (v: CloudStatus) => {
+      if (!live.current) return;
+      setS(v);
+      onSignedIn(v.signed_in);
+    },
+    [onSignedIn],
+  );
+
+  const refresh = useCallback(async () => {
+    try {
+      apply(await cloudApi.status());
