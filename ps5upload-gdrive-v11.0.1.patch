+
+mbedtls_ms_time_t mbedtls_ms_time(void) {
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (mbedtls_ms_time_t)ts.tv_sec * 1000 + (mbedtls_ms_time_t)(ts.tv_nsec / 1000000);
+}
+
+struct tm *mbedtls_platform_gmtime_r(const mbedtls_time_t *tt, struct tm *tm_buf) {
+    time_t t = (time_t)*tt;
+    return gmtime_r(&t, tm_buf);
+}
+
+/* x86-64 RDRAND (every PS5 CPU has it): the entropy when /dev/urandom cannot be read. */
+static int rdrand64(uint64_t *v) {
+    unsigned char ok = 0;
+    for (int i = 0; i < 10 && !ok; i++) __asm__ volatile("rdrand %0; setc %1" : "=r"(*v), "=qm"(ok));
+    return ok ? 0 : -1;
+}
+
+static int entropy_poll(void *data, unsigned char *out, size_t len, size_t *olen) {
+    size_t got = 0;
+    int fd = open("/dev/urandom", O_RDONLY);
+    (void)data;
+    if (fd >= 0) {
+        while (got < len) {
+            ssize_t k = read(fd, out + got, len - got);
+            if (k < 0 && errno == EINTR) continue;
+            if (k <= 0) break;
+            got += (size_t)k;
+        }
+        close(fd);
+    }
+    while (got < len) {
+        uint64_t v;
+        size_t take = len - got < sizeof v ? len - got : sizeof v;
+        if (rdrand64(&v) != 0) return MBEDTLS_ERR_ENTROPY_SOURCE_FAILED;
+        memcpy(out + got, &v, take);
+        got += take;
+    }
+    *olen = got;
+    return 0;
+}
+
+/* ---- errors ---- */
+
+static void set_err(char *err, size_t cap, const char *fmt, const char *detail) {
+    if (!err || !cap) return;
+    snprintf(err, cap, fmt, detail ? detail : "");
+}
+
+static void set_tls_err(char *err, size_t cap, const char *what, int rc) {
+    char m[160];
+    mbedtls_strerror(rc, m, sizeof m);
+    if (err && cap) snprintf(err, cap, "%s: %s (-0x%04x)", what, m, (unsigned)-rc);
+}
+
+/* ---- URL ---- */
+
+int cloud_https_split_url(const char *url, char *host, size_t hcap, int *port, char *path, size_t pcap) {
+    const char *h, *slash, *colon, *end;
+    size_t hl;
+    if (!url || strncmp(url, "https://", 8) != 0) return -1;
+    h = url + 8;
+    slash = strchr(h, '/');
+    end = slash ? slash : h + strlen(h);
+    colon = memchr(h, ':', (size_t)(end - h));
+    hl = (size_t)((colon ? colon : end) - h);
+    if (hl == 0 || hl >= hcap) return -1;
+    memcpy(host, h, hl);
+    host[hl] = '\0';
+    *port = 443;
+    if (colon) {
+        long p = strtol(colon + 1, NULL, 10);
+        if (p <= 0 || p > 65535) return -1;
+        *port = (int)p;
+    }
+    if (snprintf(path, pcap, "%s", slash ? slash : "/") >= (int)pcap) return -1;
+    return 0;
+}
+
+/* ---- name lookup ---- */
+
+/* One A record of `host` from the DNS server `server` (an IPv4 address), by a plain UDP query. */
+static int dns_query(const char *host, const char *server, struct in_addr *out) {
+    unsigned char q[512], r[1024];
+    size_t qn = 12, i;
+    struct sockaddr_in sa;
+    int fd, rc = -1;
+    uint16_t id = (uint16_t)(time(NULL) ^ (uintptr_t)host);
+    memset(q, 0, sizeof q);
+    q[0] = (unsigned char)(id >> 8);
+    q[1] = (unsigned char)id;
+    q[2] = 0x01; /* recursion desired */
+    q[5] = 1;    /* one question */
+    for (const char *p = host; *p;) {
+        const char *dot = strchr(p, '.');
+        size_t l = dot ? (size_t)(dot - p) : strlen(p);
+        if (l == 0 || l > 63 || qn + l + 6 > sizeof q) return -1;
+        q[qn++] = (unsigned char)l;
+        memcpy(q + qn, p, l);
+        qn += l;
+        p += l;
+        if (*p == '.') p++;
+    }
+    q[qn++] = 0;
+    q[qn++] = 0;
+    q[qn++] = 1; /* A */
+    q[qn++] = 0;
+    q[qn++] = 1; /* IN */
+    memset(&sa, 0, sizeof sa);
+    sa.sin_family = AF_INET;
+    sa.sin_port = htons(53);
+    if (inet_pton(AF_INET, server, &sa.sin_addr) != 1) return -1;
+    fd = socket(AF_INET, SOCK_DGRAM, 0);
+    if (fd < 0) return -1;
+    if (sendto(fd, q, qn, 0, (struct sockaddr *)&sa, sizeof sa) == (ssize_t)qn) {
+        struct pollfd pfd = {.fd = fd, .events = POLLIN, .revents = 0};
+        if (poll(&pfd, 1, DNS_TIMEOUT_MS) == 1) {
+            ssize_t n = recv(fd, r, sizeof r, 0);
+            if (n > 12 && r[0] == q[0] && r[1] == q[1] && (r[3] & 0x0f) == 0) {
+                size_t at = 12, len = (size_t)n;
+                unsigned an = ((unsigned)r[6] << 8) | r[7];
+                /* skip the question: its name, then type and class */
+                while (at < len && r[at]) {
+                    if ((r[at] & 0xc0) == 0xc0) {
+                        at++;
+                        break;
+                    }
+                    at += (size_t)r[at] + 1;
+                }
+                at += 5;
+                for (i = 0; i < an && at < len; i++) {
+                    unsigned type, rdlen;
+                    /* the answer's name: labels or a pointer */
+                    while (at < len) {
+                        if ((r[at] & 0xc0) == 0xc0) {
+                            at += 2;
+                            break;
+                        }
+                        if (r[at] == 0) {
+                            at++;
+                            break;
+                        }
+                        at += (size_t)r[at] + 1;
+                    }
+                    if (at + 10 > len) break;
+                    type = ((unsigned)r[at] << 8) | r[at + 1];
+                    rdlen = ((unsigned)r[at + 8] << 8) | r[at + 9];
+                    at += 10;
+                    if (at + rdlen > len) break;
+                    if (type == 1 && rdlen == 4) {
+                        memcpy(&out->s_addr, r + at, 4);
+                        rc = 0;
+                        break;
+                    }
+                    at += rdlen;
+                }
+            }
+        }
+    }
+    close(fd);
+    return rc;
+}
+
+#define MAX_ADDRS 8
+
+/* An answer no server lives at: 0.0.0.0/8 and loopback (what DNS blockers hand out). */
+static int bogus_ip(struct in_addr a) {
+    uint32_t h = ntohl(a.s_addr);
+    return (h >> 24) == 0 || (h >> 24) == 127;
+}
+
+/* A LAN address: a blocker on the network (a Pi-hole, a router) may answer with its own. */
+static int private_ip(struct in_addr a) {
+    uint32_t h = ntohl(a.s_addr);
+    return (h >> 24) == 10 || (h >> 20) == 0xac1 || (h >> 16) == 0xc0a8 || (h >> 22) == 0x191 || (h >> 16) == 0xa9fe;
+}
+
+static void add_addr(struct in_addr *out, size_t *n, struct in_addr a) {
+    if (bogus_ip(a) || *n >= MAX_ADDRS) return;
+    for (size_t i = 0; i < *n; i++)
+        if (out[i].s_addr == a.s_addr) return;
+    out[(*n)++] = a;
+}
+
+/* Public addresses first: a LAN answer is tried last. */
+static void order_addrs(struct in_addr *a, size_t n) {
+    struct in_addr tmp[MAX_ADDRS];
+    size_t k = 0;
+    for (size_t i = 0; i < n; i++)
+        if (!private_ip(a[i])) tmp[k++] = a[i];
+    for (size_t i = 0; i < n; i++)
+        if (private_ip(a[i])) tmp[k++] = a[i];
+    memcpy(a, tmp, n * sizeof *a);
+}
+
+/* `host` by the console's own resolver (getaddrinfo). */
+static size_t lookup_system(const char *host, struct in_addr *out) {
+    struct addrinfo hints, *res = NULL;
+    size_t n = 0;
+    struct in_addr lit;
+    if (inet_pton(AF_INET, host, &lit) == 1) {
+        out[0] = lit;
+        return 1;
+    }
+    memset(&hints, 0, sizeof hints);
+    hints.ai_family = AF_INET;
+    hints.ai_socktype = SOCK_STREAM;
+    if (getaddrinfo(host, NULL, &hints, &res) == 0 && res) {
+        for (struct addrinfo *a = res; a; a = a->ai_next)
+            if (a->ai_family == AF_INET && a->ai_addr) add_addr(out, &n, ((struct sockaddr_in *)a->ai_addr)->sin_addr);
+        freeaddrinfo(res);
+    }
+    order_addrs(out, n);
+    return n;
+}
+
+/* `host` asked of public resolvers directly (past a blocking DNS on the console or the network). */
+static size_t lookup_public(const char *host, struct in_addr *out) {
+    static const char *const k_servers[] = { "8.8.8.8", "1.1.1.1", "8.8.4.4" };
+    size_t n = 0;
+    for (size_t i = 0; i < sizeof k_servers / sizeof k_servers[0] && n == 0; i++) {
+        struct in_addr a;
+        if (dns_query(host, k_servers[i], &a) == 0) add_addr(out, &n, a);
+    }
+    return n;
+}
+
+/* ---- TCP ---- */
+
+static int tcp_connect(const struct in_addr *ip, int port, char *err, size_t errcap) {
+    struct sockaddr_in sa;
+    struct timeval tv;
+    int fd, fl, soerr = 0;
+    socklen_t sl = sizeof soerr;
+    memset(&sa, 0, sizeof sa);
+    sa.sin_family = AF_INET;
+    sa.sin_port = htons((uint16_t)port);
+    sa.sin_addr = *ip;
+    fd = socket(AF_INET, SOCK_STREAM, 0);
+    if (fd < 0) {
+        set_err(err, errcap, "socket: %s", strerror(errno));
+        return -1;
+    }
+    fl = fcntl(fd, F_GETFL, 0);
+    (void)fcntl(fd, F_SETFL, fl | O_NONBLOCK);
+    if (connect(fd, (struct sockaddr *)&sa, sizeof sa) != 0) {
+        struct pollfd pfd = {.fd = fd, .events = POLLOUT, .revents = 0};
+        int pr = 0;
+        if (errno != EINPROGRESS) soerr = errno;
+        else if ((pr = poll(&pfd, 1, CONNECT_TIMEOUT_MS)) == 1 && getsockopt(fd, SOL_SOCKET, SO_ERROR, &soerr, &sl) != 0)
+            soerr = errno;
+        if (soerr != 0 || pr != 1) {
+            char ip[INET_ADDRSTRLEN] = "?", what[64];
+            (void)inet_ntop(AF_INET, &sa.sin_addr, ip, sizeof ip);
+            snprintf(what, sizeof what, "%s:%d", ip, port);
+            if (err && errcap)
+                snprintf(err, errcap, "connect %s: %s", what, soerr ? strerror(soerr) : "timed out");
+            close(fd);
+            return -1;
+        }
+    }
+    (void)fcntl(fd, F_SETFL, fl & ~O_NONBLOCK);
+    tv.tv_sec = CLOUD_HTTPS_IO_TIMEOUT_S;
+    tv.tv_usec = 0;
+    (void)setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof tv);
+    (void)setsockopt(fd, SOL_SOCKET, SO_SNDTIMEO, &tv, sizeof tv);
+    return fd;
+}
+
+static int bio_send(void *ctx, const unsigned char *buf, size_t len) {
+    int fd = *(int *)ctx;
+    for (;;) {
+        ssize_t k = send(fd, buf, len, 0);
+        if (k >= 0) return (int)k;
+        if (errno == EINTR) continue;
+        return MBEDTLS_ERR_SSL_INTERNAL_ERROR;
+    }
+}
+
+static int bio_recv(void *ctx, unsigned char *buf, size_t len) {
+    int fd = *(int *)ctx;
+    for (;;) {
+        ssize_t k = recv(fd, buf, len, 0);
+        if (k >= 0) return (int)k; /* 0: the peer closed */
+        if (errno == EINTR) continue;
+        if (errno == EAGAIN || errno == EWOULDBLOCK) return MBEDTLS_ERR_SSL_TIMEOUT;
+        return MBEDTLS_ERR_SSL_INTERNAL_ERROR;
+    }
+}
+
+/* ---- one TLS connection ---- */
+
+typedef struct {
+    int fd;
+    int up; /* the handshake finished: a close_notify is owed */
+    mbedtls_entropy_context ent;
+    mbedtls_ctr_drbg_context drbg;
+    mbedtls_x509_crt ca;
+    mbedtls_ssl_config conf;
+    mbedtls_ssl_context ssl;
+    /* buffered reads */
+    unsigned char *buf;
+    size_t pos, len;
+    int eof;
+} conn_t;
+
+static void conn_free(conn_t *c) {
+    if (c->fd >= 0) {
+        if (c->up) (void)mbedtls_ssl_close_notify(&c->ssl);
+        close(c->fd);
+        c->fd = -1;
+    }
+    mbedtls_ssl_free(&c->ssl);
+    mbedtls_ssl_config_free(&c->conf);
+    mbedtls_x509_crt_free(&c->ca);
+    mbedtls_ctr_drbg_free(&c->drbg);
+    mbedtls_entropy_free(&c->ent);
+    free(c->buf);
+    c->buf = NULL;
+}
+
+/* A connection to `host`: each address the console's resolver gave, then (when none answered, or
+ * it gave none) each one a public resolver gives. The fd, or -1 with the last failure in `err`. */
+static int connect_host(const char *host, int port, char *err, size_t errcap) {
+    struct in_addr sys[MAX_ADDRS], pub[MAX_ADDRS];
+    size_t ns = lookup_system(host, sys), np;
+    for (size_t i = 0; i < ns; i++) {
+        int fd = tcp_connect(&sys[i], port, err, errcap);
+        if (fd >= 0) return fd;
+    }
+    np = lookup_public(host, pub);
+    for (size_t i = 0; i < np; i++) {
+        int fd, tried = 0;
+        for (size_t j = 0; j < ns; j++)
+            if (sys[j].s_addr == pub[i].s_addr) tried = 1;
+        if (tried) continue;
+        fd = tcp_connect(&pub[i], port, err, errcap);
+        if (fd >= 0) return fd;
+    }
+    if (!ns && !np) set_err(err, errcap, "dns: %s not found (is the PS5 online?)", host);
+    return -1;
+}
+
+static int conn_open(conn_t *c, const char *host, int port, char *err, size_t errcap) {
+    int rc;
+    uint32_t flags;
+    static const unsigned char k_pers[] = "ps5upload-cloud";
+    memset(c, 0, sizeof *c);
+    c->fd = -1;
+    mbedtls_entropy_init(&c->ent);
+    mbedtls_ctr_drbg_init(&c->drbg);
+    mbedtls_x509_crt_init(&c->ca);
+    mbedtls_ssl_config_init(&c->conf);
+    mbedtls_ssl_init(&c->ssl);
+    c->buf = malloc(IO_BLOCK);
+    if (!c->buf) {
+        set_err(err, errcap, "out of memory%s", "");
+        return -1;
+    }
+    if (time(NULL) < 1704067200) { /* 2024-01-01: certificates cannot be checked against this clock */
+        set_err(err, errcap, "the PS5 clock is wrong%s: set the date and time", "");
+        return -1;
+    }
+    c->fd = connect_host(host, port, err, errcap);
+    if (c->fd < 0) return -1;
+    if ((rc = mbedtls_entropy_add_source(&c->ent, entropy_poll, NULL, 32, MBEDTLS_ENTROPY_SOURCE_STRONG)) != 0 ||
+        (rc = mbedtls_ctr_drbg_seed(&c->drbg, mbedtls_entropy_func, &c->ent, k_pers, sizeof k_pers - 1)) != 0) {
+        set_tls_err(err, errcap, "random", rc);
+        return -1;
+    }
+    if ((rc = mbedtls_x509_crt_parse(&c->ca, (const unsigned char *)k_cloud_roots_pem, sizeof k_cloud_roots_pem)) != 0) {
+        set_tls_err(err, errcap, "roots", rc);
+        return -1;
+    }
+    if ((rc = mbedtls_ssl_config_defaults(&c->conf, MBEDTLS_SSL_IS_CLIENT, MBEDTLS_SSL_TRANSPORT_STREAM,
+                                          MBEDTLS_SSL_PRESET_DEFAULT)) != 0) {
+        set_tls_err(err, errcap, "tls config", rc);
+        return -1;
+    }
+    mbedtls_ssl_conf_authmode(&c->conf, MBEDTLS_SSL_VERIFY_REQUIRED);
+    mbedtls_ssl_conf_ca_chain(&c->conf, &c->ca, NULL);
+    mbedtls_ssl_conf_rng(&c->conf, mbedtls_ctr_drbg_random, &c->drbg);
+    if ((rc = mbedtls_ssl_setup(&c->ssl, &c->conf)) != 0 || (rc = mbedtls_ssl_set_hostname(&c->ssl, host)) != 0) {
+        set_tls_err(err, errcap, "tls setup", rc);
+        return -1;
+    }
+    mbedtls_ssl_set_bio(&c->ssl, &c->fd, bio_send, bio_recv, NULL);
+    while ((rc = mbedtls_ssl_handshake(&c->ssl)) != 0) {
+        if (rc == MBEDTLS_ERR_SSL_WANT_READ || rc == MBEDTLS_ERR_SSL_WANT_WRITE) continue;
+        flags = mbedtls_ssl_get_verify_result(&c->ssl);
+        if (flags != 0 && flags != (uint32_t)-1) {
+            char why[256];
+            mbedtls_x509_crt_verify_info(why, sizeof why, "", flags);
+            for (char *p = why; *p; p++)
+                if (*p == '\n') *p = ' ';
+            set_err(err, errcap, "certificate not trusted: %s", why);
+        } else {
+            set_tls_err(err, errcap, "tls handshake", rc);
+        }
+        return -1;
+    }
+    c->up = 1;
+    return 0;
+}
+
+static int conn_write(conn_t *c, const void *data, size_t len, char *err, size_t errcap) {
+    const unsigned char *p = data;
+    while (len) {
+        int k = mbedtls_ssl_write(&c->ssl, p, len);
+        if (k == MBEDTLS_ERR_SSL_WANT_READ || k == MBEDTLS_ERR_SSL_WANT_WRITE) continue;
+        if (k <= 0) {
+            set_tls_err(err, errcap, "send", k);
+            return -1;
+        }
+        p += k;
+        len -= (size_t)k;
+    }
+    return 0;
+}
+
+/* Refills the read buffer: 1 bytes are there, 0 the stream ended, -1 an error. */
+static int conn_fill(conn_t *c, char *err, size_t errcap) {
+    int k;
+    if (c->pos < c->len) return 1;
+    if (c->eof) return 0;
+    for (;;) {
+        k = mbedtls_ssl_read(&c->ssl, c->buf, IO_BLOCK);
+        if (k == MBEDTLS_ERR_SSL_WANT_READ || k == MBEDTLS_ERR_SSL_WANT_WRITE) continue;
+        break;
+    }
+    if (k == 0 || k == MBEDTLS_ERR_SSL_PEER_CLOSE_NOTIFY) {
+        c->eof = 1;
+        return 0;
+    }
+    if (k < 0) {
+        set_tls_err(err, errcap, "receive", k);
+        return -1;
+    }
+    c->pos = 0;
+    c->len = (size_t)k;
+    return 1;
+}
+
+/* One line (without CRLF) into `out`; 0, or -1 (error, end, or longer than cap - 1). */
+static int conn_line(conn_t *c, char *out, size_t cap, char *err, size_t errcap) {
+    size_t n = 0;
+    for (;;) {
+        int f = conn_fill(c, err, errcap);
+        char ch;
+        if (f <= 0) {
+            if (f == 0) set_err(err, errcap, "the server closed the connection%s", "");
+            return -1;
+        }
+        ch = (char)c->buf[c->pos++];
+        if (ch == '\n') break;
+        if (n + 1 >= cap) {
+            set_err(err, errcap, "header line too long%s", "");
+            return -1;
+        }
+        out[n++] = ch;
+    }
+    if (n && out[n - 1] == '\r') n--;
+    out[n] = '\0';
+    return 0;
+}
+
+/* ---- the response body's sink ---- */
+
+typedef struct {
+    FILE *f;
+    char *mem;
+    size_t len, cap, max;
+    int truncated;
+    uint64_t file_bytes;
+} sink_t;
+
+static int sink_put(sink_t *s, const unsigned char *p, size_t n, char *err, size_t errcap) {
+    if (s->f) {
+        if (fwrite(p, 1, n, s->f) != n) {
+            set_err(err, errcap, "write: %s", strerror(errno));
+            return -1;
+        }
+        s->file_bytes += n;
+        return 0;
+    }
+    if (s->len + n > s->max) {
+        s->truncated = 1;
+        n = s->max - s->len;
+    }
+    if (s->len + n + 1 > s->cap) {
+        size_t nc = s->cap ? s->cap * 2 : 4096;
+        char *m;
+        while (nc < s->len + n + 1) nc *= 2;
+        m = realloc(s->mem, nc);
+        if (!m) {
+            set_err(err, errcap, "out of memory%s", "");
+            return -1;
+        }
+        s->mem = m;
+        s->cap = nc;
+    }
+    memcpy(s->mem + s->len, p, n);
+    s->len += n;
+    s->mem[s->len] = '\0';
+    return 0;
+}
+
+/* Copies `want` body bytes (UINT64_MAX: to the end of the stream) to the sink. */
+static int body_copy(conn_t *c, sink_t *s, uint64_t want, volatile int *cancel, char *err, size_t errcap) {
+    while (want) {
+        size_t take;
+        int f = conn_fill(c, err, errcap);
+        if (f < 0) return -1;
+        if (f == 0) {
+            if (want == UINT64_MAX) return 0;
+            set_err(err, errcap, "the answer ended early%s", "");
+            return -1;
+        }
+        if (cancel && *cancel) {
+            set_err(err, errcap, "cancelled%s", "");
+            return -1;
+        }
+        take = c->len - c->pos;
+        if (want != UINT64_MAX && take > want) take = (size_t)want;
+        if (sink_put(s, c->buf + c->pos, take, err, errcap) != 0) return -1;
+        c->pos += take;
+        if (want != UINT64_MAX) want -= take;
+    }
+    return 0;
+}
+
+static int body_chunked(conn_t *c, sink_t *s, volatile int *cancel, char *err, size_t errcap) {
+    char line[256];
+    for (;;) {
+        unsigned long long n;
+        char *end;
+        if (conn_line(c, line, sizeof line, err, errcap) != 0) return -1;
+        n = strtoull(line, &end, 16);
+        if (end == line) {
+            set_err(err, errcap, "bad chunk%s", "");
+            return -1;
+        }
+        if (n == 0) {
+            /* trailers up to the blank line */
+            do {
+                if (conn_line(c, line, sizeof line, err, errcap) != 0) return 0;
+            } while (line[0]);
+            return 0;
+        }
+        if (body_copy(c, s, (uint64_t)n, cancel, err, errcap) != 0) return -1;
+        if (conn_line(c, line, sizeof line, err, errcap) != 0) return -1;
+    }
+}
+
+/* ---- the request ---- */
+
+void cloud_https_resp_free(cloud_https_resp_t *rs) {
+    if (!rs) return;
+    free(rs->body);
+    rs->body = NULL;
+    rs->body_len = 0;
+}
+
+static int send_file(conn_t *c, const char *path, volatile int *cancel, char *err, size_t errcap) {
+    FILE *f = fopen(path, "rb");
+    unsigned char *b;
+    int rc = 0;
+    if (!f) {
+        set_err(err, errcap, "open: %s", strerror(errno));
+        return -1;
+    }
+    b = malloc(IO_BLOCK);
+    if (!b) {
+        fclose(f);
+        set_err(err, errcap, "out of memory%s", "");
+        return -1;
+    }
+    for (;;) {
+        size_t k = fread(b, 1, IO_BLOCK, f);
+        if (k == 0) {
+            if (ferror(f)) {
+                set_err(err, errcap, "read: %s", strerror(errno));
+                rc = -1;
+            }
+            break;
+        }
+        if (cancel && *cancel) {
+            set_err(err, errcap, "cancelled%s", "");
+            rc = -1;
+            break;
+        }
+        if (conn_write(c, b, k, err, errcap) != 0) {
+            rc = -1;
+            break;
+        }
+    }
+    free(b);
+    fclose(f);
+    return rc;
+}
+
+int cloud_https_request(const cloud_https_req_t *rq, cloud_https_resp_t *rs, char *err, size_t errcap) {
+    char host[256], *path = NULL, *head = NULL, *line = NULL;
+    int port, rc = -1, chunked = 0, has_len = 0;
+    uint64_t clen = 0, blen = 0;
+    conn_t c;
+    sink_t s;
+    size_t hn;
+    memset(rs, 0, sizeof *rs);
+    memset(&s, 0, sizeof s);
+    memset(&c, 0, sizeof c);
+    c.fd = -1;
+    if (err && errcap) err[0] = '\0';
+    path = malloc(4096);
+    head = malloc(HEAD_MAX);
+    line = malloc(4096);
+    if (!path || !head || !line) {
+        set_err(err, errcap, "out of memory%s", "");
+        goto out_nocon;
+    }
+    if (cloud_https_split_url(rq->url, host, sizeof host, &port, path, 4096) != 0) {
+        set_err(err, errcap, "bad url%s", "");
+        goto out_nocon;
+    }
+    if (rq->body_file) {
+        struct stat st;
+        if (stat(rq->body_file, &st) != 0) {
+            set_err(err, errcap, "stat: %s", strerror(errno));
+            goto out_nocon;
+        }
+        blen = (uint64_t)st.st_size;
+    } else {
+        blen = rq->body ? rq->body_len : 0;
+    }
+    if (conn_open(&c, host, port, err, errcap) != 0) goto out;
+
+    hn = (size_t)snprintf(head, HEAD_MAX,
+                          "%s %s HTTP/1.1\r\nHost: %s\r\nUser-Agent: ps5upload-cloud\r\nAccept-Encoding: identity\r\n"
+                          "Connection: close\r\n%s",
+                          rq->method, path, host, rq->headers ? rq->headers : "");
+    if (hn < HEAD_MAX && (blen || strcmp(rq->method, "POST") == 0 || strcmp(rq->method, "PUT") == 0))
+        hn += (size_t)snprintf(head + hn, HEAD_MAX - hn, "Content-Length: %llu\r\n", (unsigned long long)blen);
+    if (hn < HEAD_MAX) hn += (size_t)snprintf(head + hn, HEAD_MAX - hn, "\r\n");
+    if (hn >= HEAD_MAX) {
+        set_err(err, errcap, "request too long%s", "");
+        goto out;
+    }
+    if (conn_write(&c, head, hn, err, errcap) != 0) goto out;
+    if (rq->body_file) {
+        if (send_file(&c, rq->body_file, rq->cancel, err, errcap) != 0) goto out;
+    } else if (blen && conn_write(&c, rq->body, (size_t)blen, err, errcap) != 0) {
+        goto out;
+    }
+
+    /* status line, then headers */
+    if (conn_line(&c, line, 4096, err, errcap) != 0) goto out;
+    if (strncmp(line, "HTTP/1.", 7) != 0 || strlen(line) < 12) {
+        set_err(err, errcap, "not an HTTP answer%s", "");
+        goto out;
+    }
+    rs->status = atoi(line + 9);
+    for (;;) {
+        char *colon, *v;
+        if (conn_line(&c, line, 4096, err, errcap) != 0) goto out;
+        if (!line[0]) break;
+        colon = strchr(line, ':');
+        if (!colon) continue;
+        *colon = '\0';
+        for (v = colon + 1; *v == ' ' || *v == '\t'; v++) {
+        }
+        if (strcasecmp(line, "Content-Length") == 0) {
+            clen = strtoull(v, NULL, 10);
+            has_len = 1;
+        } else if (strcasecmp(line, "Transfer-Encoding") == 0 && strstr(v, "chunked")) {
+            chunked = 1;
+        } else if (strcasecmp(line, "Location") == 0) {
+            snprintf(rs->location, sizeof rs->location, "%s", v);
+        }
+    }
+
+    s.max = rq->max_body ? rq->max_body : CLOUD_HTTPS_BODY_MAX;
+    if (rq->out_file && rs->status >= 200 && rs->status < 300) {
+        s.f = fopen(rq->out_file, "wb");
+        if (!s.f) {
+            set_err(err, errcap, "create: %s", strerror(errno));
+            goto out;
+        }
+    }
+    if (strcmp(rq->method, "HEAD") == 0 || rs->status == 204 || rs->status == 304) {
+        rc = 0;
+    } else if (chunked) {
+        rc = body_chunked(&c, &s, rq->cancel, err, errcap);
+    } else {
+        rc = body_copy(&c, &s, has_len ? clen : UINT64_MAX, rq->cancel, err, errcap);
+    }
+    if (s.f) {
+        if (fflush(s.f) != 0 || fsync(fileno(s.f)) != 0) {
+            if (rc == 0) set_err(err, errcap, "write: %s", strerror(errno));
+            rc = -1;
+        }
+        if (fclose(s.f) != 0 && rc == 0) {
+            set_err(err, errcap, "write: %s", strerror(errno));
+            rc = -1;
+        }
+        s.f = NULL;
+    }
+    rs->body = s.mem;
+    rs->body_len = s.len;
+    rs->truncated = s.truncated;
+    rs->file_bytes = s.file_bytes;
+    s.mem = NULL;
+out:
+    conn_free(&c);
+out_nocon:
+    if (s.f) fclose(s.f);
+    free(s.mem);
+    free(path);
+    free(head);
+    free(line);
+    return rc;
+}
