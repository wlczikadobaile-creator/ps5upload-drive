+
+const char *const cloud_kinds[CLOUD_KINDS] = { "savedata_prospero", "savedata_prospero_meta", "savedata",
+                                               "savedata_meta" };
+
+int cloud_kind_is_meta(int k) { return k == 1 || k == 3; }
+
+int cloud_title_ok(const char *s) {
+    if (!s || strlen(s) != 9) return 0;
+    for (int i = 0; i < 4; i++)
+        if (s[i] < 'A' || s[i] > 'Z') return 0;
+    for (int i = 4; i < 9; i++)
+        if (s[i] < '0' || s[i] > '9') return 0;
+    return 1;
+}
+
+int cloud_user_ok(const char *s) {
+    if (!s || strlen(s) != 8) return 0;
+    for (int i = 0; i < 8; i++)
+        if (!((s[i] >= '0' && s[i] <= '9') || (s[i] >= 'a' && s[i] <= 'f'))) return 0;
+    return 1;
+}
+
+int cloud_stamp(char *out, size_t cap, time_t t) {
+    struct tm tm;
+    if (cap < CLOUD_STAMP_LEN + 1 || !localtime_r(&t, &tm)) return -1;
+    if (strftime(out, cap, "%Y-%m-%d_%H-%M-%S", &tm) != CLOUD_STAMP_LEN) return -1;
+    return 0;
+}
+
+int cloud_stamp_ok(const char *s) {
+    /* 0000-00-00_00-00-00 */
+    static const char k_shape[] = "dddd-dd-dd_dd-dd-dd";
+    if (!s || strlen(s) != CLOUD_STAMP_LEN) return 0;
+    for (int i = 0; i < CLOUD_STAMP_LEN; i++) {
+        if (k_shape[i] == 'd' ? !(s[i] >= '0' && s[i] <= '9') : s[i] != k_shape[i]) return 0;
+    }
+    return 1;
+}
+
+int cloud_local_name_stamp(const char *dir, char *stamp, size_t cap) {
+    size_t sl = sizeof CLOUD_SYNC_SUFFIX - 1;
+    if (!dir || strlen(dir) != CLOUD_STAMP_LEN + sl || strcmp(dir + CLOUD_STAMP_LEN, CLOUD_SYNC_SUFFIX) != 0 ||
+        cap < CLOUD_STAMP_LEN + 1)
+        return -1;
+    memcpy(stamp, dir, CLOUD_STAMP_LEN);
+    stamp[CLOUD_STAMP_LEN] = '\0';
+    return cloud_stamp_ok(stamp) ? 0 : -1;
+}
+
+int cloud_drive_name(char *out, size_t cap, const char *title, const char *stamp) {
+    int k = snprintf(out, cap, "%s_%s.tar", title, stamp);
+    return k > 0 && (size_t)k < cap ? 0 : -1;
+}
+
+int cloud_drive_name_stamp(const char *name, const char *title, char *stamp, size_t cap) {
+    size_t tl = strlen(title);
+    if (!name || strlen(name) != tl + 1 + CLOUD_STAMP_LEN + 4 || strncmp(name, title, tl) != 0 || name[tl] != '_' ||
+        strcmp(name + tl + 1 + CLOUD_STAMP_LEN, ".tar") != 0 || cap < CLOUD_STAMP_LEN + 1)
+        return -1;
+    memcpy(stamp, name + tl + 1, CLOUD_STAMP_LEN);
+    stamp[CLOUD_STAMP_LEN] = '\0';
+    return cloud_stamp_ok(stamp) ? 0 : -1;
+}
+
+#define PROFILES_PREFIX "perfis_"
+
+int cloud_profiles_name(char *out, size_t cap, const char *stamp) {
+    int k = snprintf(out, cap, PROFILES_PREFIX "%s.txt", stamp);
+    return k > 0 && (size_t)k < cap ? 0 : -1;
+}
+
+int cloud_profiles_name_stamp(const char *name, char *stamp, size_t cap) {
+    size_t pl = sizeof PROFILES_PREFIX - 1;
+    if (!name || strlen(name) != pl + CLOUD_STAMP_LEN + 4 || strncmp(name, PROFILES_PREFIX, pl) != 0 ||
+        strcmp(name + pl + CLOUD_STAMP_LEN, ".txt") != 0 || cap < CLOUD_STAMP_LEN + 1)
+        return -1;
+    memcpy(stamp, name + pl, CLOUD_STAMP_LEN);
+    stamp[CLOUD_STAMP_LEN] = '\0';
+    return cloud_stamp_ok(stamp) ? 0 : -1;
+}
+
+uint64_t cloud_fnv(const void *p, size_t n) {
+    const unsigned char *b = p;
+    uint64_t h = 1469598103934665603ull;
+    for (size_t i = 0; i < n; i++) {
+        h ^= b[i];
+        h *= 1099511628211ull;
+    }
+    return h;
+}
+
+typedef struct {
+    char *out;
+    size_t cap, at;
+} tb_t;
+
+static void tb(tb_t *t, const char *fmt, ...) __attribute__((format(printf, 2, 3)));
+static void tb(tb_t *t, const char *fmt, ...) {
+    va_list ap;
+    int k;
+    va_start(ap, fmt);
+    k = vsnprintf(t->at < t->cap ? t->out + t->at : NULL, t->at < t->cap ? t->cap - t->at : 0, fmt, ap);
+    va_end(ap);
+    if (k > 0) t->at += (size_t)k;
+}
+
+/* The 8 bytes of an account ID in memory order (little-endian), as base64: the form Remote Play
+ * pairing takes (client/src/screens/Accounts/accountId.ts accountIdToB64). */
+static void id_b64(uint64_t id, char out[13]) {
+    static const char a[] = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+    unsigned char b[9] = { 0 };
+    size_t o = 0;
+    for (int i = 0; i < 8; i++) b[i] = (unsigned char)(id >> (8 * i));
+    for (int i = 0; i < 9; i += 3) {
+        uint32_t v = (uint32_t)b[i] << 16 | (uint32_t)b[i + 1] << 8 | b[i + 2];
+        out[o++] = a[(v >> 18) & 63];
+        out[o++] = a[(v >> 12) & 63];
+        out[o++] = i + 1 < 8 ? a[(v >> 6) & 63] : '=';
+        out[o++] = i + 2 < 8 ? a[v & 63] : '=';
+    }
+    out[o] = '\0';
+}
