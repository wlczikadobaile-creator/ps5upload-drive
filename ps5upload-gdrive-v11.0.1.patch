+        const cloud_slot_t *s = si >= 0 ? &slots[si] : NULL;
+        if (s &&(size_t)(s - slots) < sizeof used / sizeof used[0]) used[s - slots] = 1;
+        tb(&t, "%zu. %s\n", i + 1, users[i].name[0] ? users[i].name : "(sem nome)");
+        tb(&t, "   Usuário (pasta):     %s  (PS5 Saves/%s no Drive)\n", users[i].uid, users[i].uid);
+        slot_lines(&t, s);
+        tb(&t, "\n");
+    }
+    for (size_t j = 0; j < ns && j < sizeof used / sizeof used[0]; j++)
+        if (!used[j] && (slots[j].name[0] || slots[j].id)) used_n++;
+    if (used_n) {
+        tb(&t, "========================================================================\n");
+        tb(&t, "OUTRAS CONTAS (sem perfil neste PS5)\n");
+        tb(&t, "========================================================================\n\n");
+        for (size_t j = 0; j < ns && j < sizeof used / sizeof used[0]; j++)
+            if (!used[j] && (slots[j].name[0] || slots[j].id)) {
+                slot_lines(&t, &slots[j]);
+                tb(&t, "\n");
+            }
+    }
+    return t.at;
+}
