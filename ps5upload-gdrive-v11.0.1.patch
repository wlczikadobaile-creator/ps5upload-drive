+++ b/client/src/console/saves/cloud.test.ts	2026-11-03 22:51:06.673986371 -0300
@@ -0,0 +1,159 @@
+import { describe, expect, it } from "vitest";
+import { ApiError } from "../api";
+import { deviceUrl, secretProblem } from "./CloudCard";
+import { cloudApi, fetchCloud, findClientFiles, listCloud, loadProfiles, localName, missingAccounts, otherProfile, parseClientJson, stampTime, type CloudStatus, type WaitDeps } from "./cloud";
+
+function status(over: Partial<CloudStatus> = {}): CloudStatus {
+  return {
+    signed_in: true,
+    email: "a@b.c",
+    client_id: "id",
+    settings: { enabled: true, interval_min: 30, keep_cloud: 10, keep_local: 3 },
+    pass: { running: false, phase: null, last_at: 0, last_ok_at: 0, next_at: 0, looked: 0, uploaded: 0, failed: 0, error: null },
+    auth: { state: "idle", user_code: null, url: null, expires_at: 0, error: null },
+    list: { state: "idle", user: null, title: null, error: null, files: [] },
+    fetch: { state: "idle", user: null, title: null, stamp: null, error: null },
+    busy: false,
+    ...over,
+  };
+}
+
+/** A helper that answers each route from `answers` (the status ones in turn). */
+function deps(statuses: CloudStatus[], calls: [string, unknown][] = []): WaitDeps {
+  let i = 0;
+  return {
+    call: (async (route: string, body?: object) => {
+      calls.push([route, body]);
+      if (route === "/api/cloud/status") return statuses[Math.min(i++, statuses.length - 1)];
+      return statuses[0];
+    }) as unknown as WaitDeps["call"],
+    sleep: async () => undefined,
+    now: () => 0,
+  };
+}
+
+describe("cloud save backups", () => {
+  it("reads a stamp as the console's local time", () => {
+    expect(stampTime("2026-11-03_14-30-05")).toBe(new Date(2026, 10, 3, 14, 30, 5).getTime());
+    expect(stampTime("2026-11-03 14-30-05")).toBeNaN();
+    expect(localName("2026-11-03_14-30-05")).toBe("2026-11-03_14-30-05_sync");
+  });
+
+  it("takes the client from the file Google Cloud Console downloads", () => {
+    expect(parseClientJson('{"installed":{"client_id":" x.apps.googleusercontent.com ","client_secret":"s"}}')).toEqual({
+      id: "x.apps.googleusercontent.com",
+      secret: "s",
+    });
+    expect(parseClientJson('{"client_id":"y"}')).toEqual({ id: "y", secret: "" });
+    expect(parseClientJson('{"installed":{}}')).toBeNull();
+    expect(parseClientJson("not json")).toBeNull();
+  });
+
+  it("finds client_secret files at the top of each drive", async () => {
+    const c = (async (route: string, body?: object) => {
+      expect(route).toBe("/api/fs/list");
+      const path = (body as { path: string }).path;
+      return path === "/mnt/usb0"
+        ? { entries: [{ name: "client_secret_123.json", kind: "file" }, { name: "x.json", kind: "file" }, { name: "client_secret_d", kind: "dir" }] }
+        : { entries: [] };
+    }) as unknown as WaitDeps["call"];
+    expect(await findClientFiles(["/mnt/usb0", "/mnt/usb1"], c)).toEqual(["/mnt/usb0/client_secret_123.json"]);
+  });
+
+  it("lists a game's Drive backups once the helper has them, newest first", async () => {
+    const files = [
+      { id: "1", name: "PPSA01234_2026-01-01_00-00-00.tar", stamp: "2026-01-01_00-00-00", size: 5 },
+      { id: "2", name: "PPSA01234_2026-02-01_00-00-00.tar", stamp: "2026-02-01_00-00-00", size: 6 },
+    ];
+    const calls: [string, unknown][] = [];
+    const d = deps(
+      [
+        status({ list: { state: "running", user: "1a2b3c4d", title: "PPSA01234", error: null, files: [] } }),
+        status({ list: { state: "done", user: "1a2b3c4d", title: "PPSA01234", error: null, files } }),
+      ],
+      calls,
+    );
+    const got = await listCloud("1a2b3c4d", "PPSA01234", d);
+    expect(got.map((f) => f.id)).toEqual(["2", "1"]);
+    expect(calls[0]).toEqual(["/api/cloud/list", { user: "1a2b3c4d", title: "PPSA01234" }]);
+  });
+
+  it("a failed list or fetch says why", async () => {
+    await expect(
+      listCloud("1a2b3c4d", "PPSA01234", deps([status({ list: { state: "error", user: "1a2b3c4d", title: "PPSA01234", error: "offline", files: [] } })])),
+    ).rejects.toMatchObject({ code: "offline" });
+    const f = { id: "9", name: "PPSA01234_2026-01-01_00-00-00.tar", stamp: "2026-01-01_00-00-00", size: 1 };
+    await expect(
+      fetchCloud("1a2b3c4d", "PPSA01234", f, deps([status({ fetch: { state: "error", user: "1a2b3c4d", title: "PPSA01234", stamp: f.stamp, error: "gone" } })])),
+    ).rejects.toBeInstanceOf(ApiError);
+  });
+
+  it("a fetched backup becomes the local <stamp>_sync backup", async () => {
+    const f = { id: "9", name: "PPSA01234_2026-01-01_00-00-00.tar", stamp: "2026-01-01_00-00-00", size: 1 };
+    const calls: [string, unknown][] = [];
+    const name = await fetchCloud(
+      "1a2b3c4d",
+      "PPSA01234",
+      f,
+      deps([status({ fetch: { state: "done", user: "1a2b3c4d", title: "PPSA01234", stamp: f.stamp, error: null } })], calls),
+    );
+    expect(name).toBe("2026-01-01_00-00-00_sync");
+    expect(calls[0]).toEqual(["/api/cloud/fetch", { user: "1a2b3c4d", title: "PPSA01234", id: "9", stamp: f.stamp }]);
+  });
+
+  it("a lost profile's Drive backups are fetched into this profile", async () => {
+    const mine = { id: "1", name: "PPSA01234_2026-01-01_00-00-00.tar", stamp: "2026-01-01_00-00-00", size: 1, user: "1a2b3c4d" };
+    const old = { id: "2", name: "PPSA01234_2026-02-01_00-00-00.tar", stamp: "2026-02-01_00-00-00", size: 1, user: "0badf00d" };
+    expect(otherProfile(mine, "1a2b3c4d")).toBeNull();
+    expect(otherProfile({ ...mine, user: undefined }, "1a2b3c4d")).toBeNull();
+    expect(otherProfile(old, "1a2b3c4d")).toBe("0badf00d");
+    const calls: [string, unknown][] = [];
+    const d = deps([status({ fetch: { state: "done", user: "1a2b3c4d", title: "PPSA01234", stamp: old.stamp, error: null } })], calls);
+    expect(await fetchCloud("1a2b3c4d", "PPSA01234", old, d)).toBe("2026-02-01_00-00-00_sync");
+    await fetchCloud("1a2b3c4d", "PPSA01234", mine, deps([status({ fetch: { state: "done", user: "1a2b3c4d", title: "PPSA01234", stamp: mine.stamp, error: null } })], calls));
+    expect(calls[0]).toEqual(["/api/cloud/fetch", { user: "1a2b3c4d", from: "0badf00d", title: "PPSA01234", id: "2", stamp: old.stamp }]);
+    expect(calls[2]).toEqual(["/api/cloud/fetch", { user: "1a2b3c4d", title: "PPSA01234", id: "1", stamp: mine.stamp }]);
+  });
+
+  it("restoring a profile offers the accounts this PS5 no longer has, and gives one to a profile", async () => {
+    const old = [
+      { name: "wallace", uid: "10b32138", id: "0x7a356e99a9e2205c", stamp: "2026-11-01_10-00-00" },
+      { name: "irmao", uid: "2c0ffee1", id: "0x1234", stamp: "2026-11-03_10-00-00" },
+    ];
+    const here = [{ uid: "3abcdef0", name: "wallace", slot: 1, id: "0x7A356E99A9E2205C" }];
+    expect(missingAccounts(old, here).map((a) => a.name)).toEqual(["irmao"]);
+    expect(missingAccounts(old, []).map((a) => a.name)).toEqual(["irmao", "wallace"]);
+    const calls: [string, unknown][] = [];
+    const d = deps([status({ profiles: { state: "done", error: null, old, here } })], calls);
+    expect(await loadProfiles(d)).toEqual({ old, here });
+    await cloudApi.applyAccount(here[0], old[1], d.call);
+    expect(calls[0]).toEqual(["/api/cloud/profiles", undefined]);
+    expect(calls[calls.length - 1]).toEqual(["/api/cloud/apply_account", { slot: 1, uid: "3abcdef0", id: "0x1234" }]);
+    await expect(loadProfiles(deps([status({ profiles: { state: "error", error: "offline", old: [], here: [] } })]))).rejects.toMatchObject({
+      code: "offline",
+    });
+  });
+
+  it("the QR code opens Google's device page with the code", () => {
+    expect(deviceUrl("https://www.google.com/device", "ABC-DEF-GHI")).toBe("https://www.google.com/device?user_code=ABC-DEF-GHI");
+    expect(deviceUrl("https://x.test/d?a=1", "A B")).toBe("https://x.test/d?a=1&user_code=A%20B");
+  });
+
+  it("a client secret is asked for, never the client ID again", () => {
+    expect(secretProblem("GOCSPX-abc_DEF-123")).toBeNull();
+    expect(secretProblem("  ")).not.toBeNull();
+    expect(secretProblem("579-x.apps.googleusercontent.com")).not.toBeNull();
+    expect(secretProblem("GOCSPX a")).not.toBeNull();
+  });
+
+  it("sends the client secret only when one is given", async () => {
+    const calls: [string, unknown][] = [];
+    const d = deps([status()], calls);
+    await cloudApi.setClient("id", undefined, d.call);
+    await cloudApi.setClient("id", "s", d.call);
+    expect(calls).toEqual([
+      ["/api/cloud/client", { client_id: "id" }],
+      ["/api/cloud/client", { client_id: "id", client_secret: "s" }],
+    ]);
+  });
+});
diff -ruN a/client/src/console/saves/cloud.ts b/client/src/console/saves/cloud.ts
--- a/client/src/console/saves/cloud.ts	1969-12-31 21:00:00.000000000 -0300
+++ b/client/src/console/saves/cloud.ts	2026-11-03 22:51:06.721659079 -0300
@@ -0,0 +1,192 @@
+/**
+ * Save backups to Google Drive, run by the helper itself (payload/include/cloud_sync.h): every few
+ * minutes the saves that changed are copied on the console (a "<stamp>_sync" backup, listed with the
+ * others here) and sent to Drive as PS5 Saves/<user>/<title>/<title>_<stamp>.tar. The page signs in,
+ * changes the settings and restores: a Drive backup is fetched as the local "<stamp>_sync" backup and
+ * put back like any other (model.ts restore).
+ *
+ * Every slow step runs on the helper's own threads; the page polls /api/cloud/status for the result
+ * (payload/include/webui_cloud.h has the shape).
+ */
+import { ApiError, call } from "../api";
+import type { CallFn } from "../games/model";
+import { listAll } from "./model";
+
+export interface CloudFile {
+  id: string;
+  name: string;
+  stamp: string;
+  size: number;
+  /** The profile folder it is in (an older helper lists only the asked user's: absent). */
+  user?: string;
+}
+
+/** The profile a Drive backup of `user`'s list came from, when it is another one (a lost profile). */
+export const otherProfile = (f: CloudFile, user: string): string | null => (f.user && f.user !== user ? f.user : null);
+
+export type TaskState = "idle" | "running" | "done" | "error";
+
+export interface CloudStatus {
+  signed_in: boolean;
+  email: string | null;
+  client_id: string | null;
+  settings: { enabled: boolean; interval_min: number; keep_cloud: number; keep_local: number };
+  pass: {
+    running: boolean;
+    phase: string | null;
+    last_at: number;
+    last_ok_at: number;
+    /** When the profiles file (each profile's account ID) last went to Drive; 0 not yet (or an older helper). */
+    profiles_at?: number;
+    next_at: number;
+    looked: number;
+    uploaded: number;
+    failed: number;
+    error: string | null;
+  };
+  auth: { state: "idle" | "starting" | "code" | "done" | "error"; user_code: string | null; url: string | null; expires_at: number; error: string | null };
+  list: { state: TaskState; user: string | null; title: string | null; error: string | null; files: CloudFile[] };
+  fetch: { state: TaskState; user: string | null; title: string | null; stamp: string | null; error: string | null };
+  /** Restoring a profile (absent on an older helper). */
+  profiles?: { state: TaskState; error: string | null; old: OldAccount[]; here: HereProfile[] };
+  busy: boolean;
+}
+
+/** An account read back from the profiles files on Drive (PS5 Saves/perfis_<stamp>.txt). */
+export interface OldAccount {
+  name: string;
+  /** The profile's folder (its backups' folder on Drive); null for an account without a profile. */
+  uid: string | null;
+  /** "0x…" */
+  id: string;
+  /** The newest profiles file that has it. */
+  stamp: string;
+}
+
+/** A profile on this PS5, with its account slot (0: none goes with it, so no ID can be given). */
+export interface HereProfile {
+  uid: string;
+  name: string;
+  slot: number;
+  id: string;
+}
+
+/** The old accounts no profile on this PS5 has now (those a lost profile would need), newest first. */
+export function missingAccounts(old: readonly OldAccount[], here: readonly HereProfile[]): OldAccount[] {
+  const have = new Set(here.map((h) => h.id.toLowerCase()));
+  return old.filter((a) => !have.has(a.id.toLowerCase())).sort((a, b) => b.stamp.localeCompare(a.stamp));
+}
+
+export type SettingsPatch = Partial<CloudStatus["settings"]>;
+
+/** The intervals offered, in minutes. */
+export const INTERVALS = [15, 30, 60, 120, 360] as const;
+
+export const cloudApi = {
+  status: (c: CallFn = call) => c<CloudStatus>("/api/cloud/status"),
+  setClient: (clientId: string, clientSecret?: string, c: CallFn = call) =>
+    c<CloudStatus>("/api/cloud/client", clientSecret ? { client_id: clientId, client_secret: clientSecret } : { client_id: clientId }),
+  connect: (c: CallFn = call) => c<CloudStatus>("/api/cloud/connect"),
+  disconnect: (c: CallFn = call) => c<CloudStatus>("/api/cloud/disconnect"),
+  settings: (patch: SettingsPatch, c: CallFn = call) => c<CloudStatus>("/api/cloud/settings", patch),
+  run: (c: CallFn = call) => c<CloudStatus>("/api/cloud/run"),
+  list: (user: string, title: string, c: CallFn = call) => c<CloudStatus>("/api/cloud/list", { user, title }),
+  profiles: (c: CallFn = call) => c<CloudStatus>("/api/cloud/profiles"),
+  applyAccount: (p: HereProfile, a: OldAccount, c: CallFn = call) =>
+    c<CloudStatus>("/api/cloud/apply_account", { slot: p.slot, uid: p.uid, id: a.id }),
+  fetch: (user: string, title: string, f: CloudFile, c: CallFn = call) => {
+    const from = otherProfile(f, user);
+    return c<CloudStatus>("/api/cloud/fetch", from ? { user, from, title, id: f.id, stamp: f.stamp } : { user, title, id: f.id, stamp: f.stamp });
+  },
+};
+
+/** An older helper has no /api/cloud routes (404): the page then shows nothing of this. */
+export function isUnsupported(e: unknown): boolean {
+  return e instanceof ApiError && e.status === 404;
+}
+
+/** A stamp (YYYY-MM-DD_HH-MM-SS, the console's local time) as ms; NaN when it is not one. */
+export function stampTime(stamp: string): number {
+  const m = /^(\d{4})-(\d{2})-(\d{2})_(\d{2})-(\d{2})-(\d{2})$/.exec(stamp);
+  if (!m) return NaN;
+  return new Date(+m[1], +m[2] - 1, +m[3], +m[4], +m[5], +m[6]).getTime();
+}
+
+/** The local backup a Drive backup becomes. */
+export const localName = (stamp: string) => `${stamp}_sync`;
+
+/**
+ * The OAuth client from the JSON file Google Cloud Console downloads ({"installed":{client_id,
+ * client_secret,...}}, or a "web" one, or the two fields at the top). Null when it has no id.
+ */
+export function parseClientJson(text: string): { id: string; secret: string } | null {
+  let v: unknown;
+  try {
+    v = JSON.parse(text);
+  } catch {
+    return null;
+  }
+  if (!v || typeof v !== "object") return null;
+  const o = v as Record<string, unknown>;
+  const inner = (o.installed ?? o.web ?? o) as Record<string, unknown>;
+  if (!inner || typeof inner !== "object" || typeof inner.client_id !== "string" || !inner.client_id) return null;
+  return { id: inner.client_id.trim(), secret: typeof inner.client_secret === "string" ? inner.client_secret.trim() : "" };
+}
+
+/** The client files at the top of each USB drive (client_secret*.json, as Google names them). */
+export async function findClientFiles(mounts: readonly string[], callFn: CallFn = call): Promise<string[]> {
+  const out: string[] = [];
+  for (const m of mounts) {
+    const l = await listAll(callFn, m).catch(() => null);
+    for (const e of l ?? []) if (e.kind === "file" && /^client_secret.*\.json$/i.test(e.name)) out.push(`${m}/${e.name}`);
+  }
+  return out;
+}
+
+export interface WaitDeps {
+  call: CallFn;
+  sleep: (ms: number) => Promise<void>;
+  now: () => number;
+}
+
+const defaultWait: WaitDeps = { call, sleep: (ms) => new Promise((r) => setTimeout(r, ms)), now: () => Date.now() };
+
+/** Polls the status until `done` says so (its answer), or throws ApiError(504, "timeout"). */
+export async function waitStatus(done: (s: CloudStatus) => boolean, timeoutMs: number, d: WaitDeps = defaultWait): Promise<CloudStatus> {
+  const end = d.now() + timeoutMs;
+  for (;;) {
+    const s = await cloudApi.status(d.call);
+    if (done(s)) return s;
+    if (d.now() >= end) throw new ApiError(504, "timeout");
+    await d.sleep(1000);
+  }
+}
+
+/** The backups of `title` on Drive for `user`, newest first: its own, and other profiles' (`user` set). */
+export async function listCloud(user: string, title: string, d: WaitDeps = defaultWait): Promise<CloudFile[]> {
+  await cloudApi.list(user, title, d.call);
+  const s = await waitStatus((x) => x.list.user === user && x.list.title === title && x.list.state !== "running", 60_000, d);
+  if (s.list.state === "error") throw new ApiError(502, s.list.error || "drive_error");
+  return [...s.list.files].sort((a, b) => b.stamp.localeCompare(a.stamp));
+}
+
+/** Reads the accounts in the profiles files on Drive and this PS5's profiles. */
+export async function loadProfiles(d: WaitDeps = defaultWait): Promise<{ old: OldAccount[]; here: HereProfile[] }> {
+  await cloudApi.profiles(d.call);
+  const s = await waitStatus((x) => !!x.profiles && x.profiles.state !== "running", 120_000, d);
+  if (!s.profiles) throw new ApiError(404, "unsupported");
+  if (s.profiles.state === "error") throw new ApiError(502, s.profiles.error || "drive_error");
+  return { old: s.profiles.old, here: s.profiles.here };
+}
+
+/** Fetches the Drive backup `f` as a local backup; its name (model.ts restores it). */
+export async function fetchCloud(user: string, title: string, f: CloudFile, d: WaitDeps = defaultWait): Promise<string> {
+  await cloudApi.fetch(user, title, f, d.call);
+  const s = await waitStatus(
+    (x) => x.fetch.user === user && x.fetch.title === title && x.fetch.stamp === f.stamp && x.fetch.state !== "running",
+    15 * 60_000,
+    d,
+  );
+  if (s.fetch.state === "error") throw new ApiError(502, s.fetch.error || "drive_error");
+  return localName(f.stamp);
+}
