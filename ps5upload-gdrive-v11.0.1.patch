diff -ruN a/payload/include/cloud_sync.h b/payload/include/cloud_sync.h
--- a/payload/include/cloud_sync.h	1969-12-31 21:00:00.000000000 -0300
+++ b/payload/include/cloud_sync.h	2026-11-03 22:51:08.661985453 -0300
@@ -0,0 +1,85 @@
+/* Automatic save backups to Google Drive, run by the helper itself (no PC needed).
+ *
+ * Every `interval_min` minutes (30 by default) each user's game saves are looked at. A save that
+ * changed since its last upload is first copied on the console, then sent to Drive:
+ *
+ *   1. local copy  /data/ps5upload/save-backups/<user>/<title>/<stamp>_sync/<kind>/...
+ *      The console page's own layout (client/src/console/saves/model.ts), so its Saves screen lists
+ *      the copy and restores from it. Taken while the game may be running, the way the PC app's
+ *      snapshots are: only once the save has sat still for a few seconds, and kept only when it is
+ *      still unchanged after the copy (a game that saved mid-copy would leave a torn backup).
+ *      Written under a ".<stamp>_sync.part" name and renamed when complete.
+ *   2. upload       the copy as one tar, PS5 Saves/<user>/<title>/<title>_<stamp>.tar on Drive.
+ *
+ * The newest `keep_local` automatic copies of each save stay on the console and the newest
+ * `keep_cloud` on Drive; older ones are removed (only "_sync" ones: the page's own backups are never
+ * touched). A copy that could not be uploaded (no network) is uploaded at the next pass, not copied
+ * again.
+ *
+ * At the end of each pass the profiles go too: PS5 Saves/perfis_<stamp>.txt, each profile's folder
+ * and account ID (cloud_profiles_text), sent when Drive has none or they changed since the last one
+ * (older files are kept), so a lost profile can be made again with the same ID.
+ *
+ * Restoring from Drive downloads a backup and unpacks it as a local "<stamp>_sync" backup; the page
+ * then restores that the way it restores any backup (it backs up the current save first, and the
+ * game must be closed).
+ *
+ * Settings and what was uploaded are kept under CLOUD_DIR (cloud_drive.h). Two threads: the pass,
+ * and one for the page's slower requests (sign-in, listing Drive, fetching a backup), so a long
+ * upload never holds up a restore. */
+#ifndef PS5UPLOAD_CLOUD_SYNC_H
+#define PS5UPLOAD_CLOUD_SYNC_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+#define CLOUD_BACKUP_ROOT "/data/ps5upload/save-backups"
+#define CLOUD_SETTINGS_PATH "/data/ps5upload/gdrive/settings.json"
+#define CLOUD_STATE_PATH "/data/ps5upload/gdrive/state.txt"
+#define CLOUD_TMP_DIR "/data/ps5upload/gdrive/tmp"
+
+#define CLOUD_INTERVAL_MIN_DEFAULT 30
+#define CLOUD_KEEP_CLOUD_DEFAULT 10
+#define CLOUD_KEEP_LOCAL_DEFAULT 3
+
+/* Loads the sign-in and settings and starts both threads. Call once, at helper start. */
+void cloud_sync_start(void);
+
+/* ---- for the page's routes (webui_cloud.c): all quick, none does network I/O ---- */
+
+/* The whole state as JSON (see webui_cloud.h). Its length, or -1 when it does not fit. */
+int cloud_status_json(char *out, size_t cap);
+
+/* Changes the settings: a negative value (or -1 for `enabled`) keeps that one. 0, or -1 (not saved). */
+int cloud_settings_set(int enabled, int interval_min, int keep_cloud, int keep_local);
+/* Sets the OAuth client (cloud_auth_set_client). 0, or -1. */
+int cloud_set_client(const char *id, const char *secret);
+
+/* Start a pass now (whatever the interval). 0, or -1 when not signed in. */
+int cloud_run_now(void);
+
+/* Starts the sign-in (a code to enter at Google). 0, 1 another request is running, -1 no client set. */
+int cloud_connect_start(void);
+/* Stops a sign-in that is waiting for its code, or signs out. */
+void cloud_disconnect(void);
+
+/* Starts listing the backups of `title` on Drive for `user` (the result comes in the status:
+ * "list"): `user`'s own first, then those in every other profile folder (each file says whose it
+ * is), so a profile made again after it was lost finds the old one's backups. 0, 1 another request
+ * is running, -1 bad names or not signed in. */
+int cloud_list_start(const char *user, const char *title);
+/* Starts fetching the Drive backup `file_id` (named for `stamp`) of `title`, made by profile `from`
+ * (NULL: `user`), as `user`'s local backup "<stamp>_sync" (the status's "fetch" says when it is
+ * there). A backup from another profile is refused when `user` already has one with that stamp.
+ * 0, 1 busy, -1 bad request. */
+int cloud_fetch_start(const char *user, const char *from, const char *title, const char *file_id, const char *stamp);
+
+/* Starts reading the accounts in the profiles files on Drive and this PS5's profiles (the status's
+ * "profiles"). 0, 1 busy, -1 not signed in. */
+int cloud_profiles_start(void);
+/* Gives profile `uid` (whose account slot is `slot`) the account ID `id`, which must be one the
+ * last read found on Drive: the way a lost profile, made again, gets its saves back. Quick (no
+ * network). 0, -1 refused (not one of those), -2 the console did not take it. */
+int cloud_profile_apply(int slot, const char *uid, uint64_t id);
+
+#endif
diff -ruN a/payload/include/mbedtls_ps5_config.h b/payload/include/mbedtls_ps5_config.h
--- a/payload/include/mbedtls_ps5_config.h	1969-12-31 21:00:00.000000000 -0300
+++ b/payload/include/mbedtls_ps5_config.h	2026-11-03 22:51:08.697985463 -0300
@@ -0,0 +1,72 @@
+/* The mbedTLS build the cloud save backup uses (cloud_https.c): a TLS 1.2 client that talks to
+ * Google's servers and nothing else, so only what that needs is compiled in. Selected with
+ * -DMBEDTLS_CONFIG_FILE='"mbedtls_ps5_config.h"' (payload/Makefile).
+ *
+ * Google serves ECDHE with ECDSA (P-256) or RSA certificates, AES-GCM or ChaCha20-Poly1305, under
+ * the GTS roots (RSA 4096 / ECDSA P-384): those key exchanges, ciphers, curves and hashes.
+ *
+ * Platform glue lives in cloud_https.c, not in mbedTLS's own detection: there is no platform
+ * entropy (a source is added per connection), and the monotonic clock and gmtime_r are ours
+ * (MBEDTLS_PLATFORM_MS_TIME_ALT / _GMTIME_R_ALT), so nothing depends on which unix macros the
+ * prospero toolchain defines. No MBEDTLS_THREADING_C: every connection owns all of its contexts. */
+#ifndef PS5UPLOAD_MBEDTLS_PS5_CONFIG_H
+#define PS5UPLOAD_MBEDTLS_PS5_CONFIG_H
+
+/* system */
+#define MBEDTLS_HAVE_ASM
+#define MBEDTLS_HAVE_TIME
+#define MBEDTLS_HAVE_TIME_DATE
+#define MBEDTLS_PLATFORM_C
+#define MBEDTLS_PLATFORM_MS_TIME_ALT
+#define MBEDTLS_PLATFORM_GMTIME_R_ALT
+#define MBEDTLS_NO_PLATFORM_ENTROPY
+
+/* key exchange and certificates */
+#define MBEDTLS_KEY_EXCHANGE_ECDHE_ECDSA_ENABLED
+#define MBEDTLS_KEY_EXCHANGE_ECDHE_RSA_ENABLED
+#define MBEDTLS_ECP_DP_SECP256R1_ENABLED
+#define MBEDTLS_ECP_DP_SECP384R1_ENABLED
+#define MBEDTLS_ECP_DP_CURVE25519_ENABLED
+#define MBEDTLS_ECP_NIST_OPTIM
+#define MBEDTLS_PKCS1_V15
+#define MBEDTLS_PKCS1_V21
+
+/* TLS */
+#define MBEDTLS_SSL_PROTO_TLS1_2
+#define MBEDTLS_SSL_CLI_C
+#define MBEDTLS_SSL_TLS_C
+#define MBEDTLS_SSL_SERVER_NAME_INDICATION
+#define MBEDTLS_SSL_EXTENDED_MASTER_SECRET
+
+/* modules */
+#define MBEDTLS_AES_C
+#define MBEDTLS_ASN1_PARSE_C
+#define MBEDTLS_ASN1_WRITE_C
+#define MBEDTLS_BASE64_C
+#define MBEDTLS_BIGNUM_C
+#define MBEDTLS_CHACHA20_C
+#define MBEDTLS_CHACHAPOLY_C
+#define MBEDTLS_POLY1305_C
+#define MBEDTLS_CIPHER_C
+#define MBEDTLS_CTR_DRBG_C
+#define MBEDTLS_ECDH_C
+#define MBEDTLS_ECDSA_C
+#define MBEDTLS_ECP_C
+#define MBEDTLS_ENTROPY_C
+#define MBEDTLS_ERROR_C
+#define MBEDTLS_GCM_C
+#define MBEDTLS_MD_C
+#define MBEDTLS_OID_C
+#define MBEDTLS_PEM_PARSE_C
+#define MBEDTLS_PK_C
+#define MBEDTLS_PK_PARSE_C
+#define MBEDTLS_RSA_C
+#define MBEDTLS_SHA1_C
+#define MBEDTLS_SHA224_C
+#define MBEDTLS_SHA256_C
+#define MBEDTLS_SHA384_C
+#define MBEDTLS_SHA512_C
+#define MBEDTLS_X509_USE_C
+#define MBEDTLS_X509_CRT_PARSE_C
+
+#endif
diff -ruN a/payload/include/webui_cloud.h b/payload/include/webui_cloud.h
--- a/payload/include/webui_cloud.h	1969-12-31 21:00:00.000000000 -0300
+++ b/payload/include/webui_cloud.h	2026-11-03 22:51:08.733985474 -0300
@@ -0,0 +1,47 @@
+/* The console page's routes for save backups to Google Drive (cloud_sync.h); webui_api.c's table
+ * lists them. None does network I/O itself: the slow parts run on cloud_sync.c's threads and the
+ * page polls /api/cloud/status for their outcome. Every route answers the status:
+ *
+ *   {"signed_in":bool,"email":".."|null,"client_id":".."|null,
+ *    "settings":{"enabled":bool,"interval_min":N,"keep_cloud":N,"keep_local":N},
+ *    "pass":{"running":bool,"phase":".."|null,"last_at":N,"last_ok_at":N,"next_at":N,
+ *            "looked":N,"uploaded":N,"failed":N,"error":".."|null},
+ *    "auth":{"state":"idle"|"starting"|"code"|"done"|"error","user_code":..,"url":..,"expires_at":N,"error":..},
+ *    "list":{"state":"idle"|"running"|"done"|"error","user":..,"title":..,"error":..,
+ *            "files":[{"id","name","stamp","size"}]},
+ *    "fetch":{"state":"idle"|"running"|"done"|"error","user":..,"from":..,"title":..,"stamp":..,"error":..},
+ *    "profiles":{"state":..,"error":..,"old":[{"name","uid"|null,"id":"0x..","stamp"}],
+ *                "here":[{"uid","name","slot","id":"0x.."}]},
+ *    "busy":bool}
+ * Times are Unix seconds (0: never).
+ *
+ *   /api/cloud/status {}
+ *   /api/cloud/client {client_id, client_secret?}   the OAuth client (a missing secret keeps the saved one)
+ *   /api/cloud/connect {}                            sign in: a code shows in "auth"
+ *   /api/cloud/disconnect {}                         stop a sign-in, or sign out
+ *   /api/cloud/settings {enabled?, interval_min?, keep_cloud?, keep_local?}
+ *   /api/cloud/run {}                                back up now
+ *   /api/cloud/list {user, title}                    that save's backups on Drive, into "list"
+ *   /api/cloud/fetch {user, from?, title, id, stamp} a Drive backup as the local <stamp>_sync backup
+ *   /api/cloud/profiles {}                           the accounts in PS5 Saves/perfis_*.txt, into "profiles"
+ *   /api/cloud/apply_account {slot, uid, id:"0x.."}  give a profile one of those account IDs
+ * Errors: {"error":token}: 400 bad_<field> / no_client / not_signed_in / not_allowed, 409 busy,
+ * 500 not_applied. */
+#ifndef PS5UPLOAD_WEBUI_CLOUD_H
+#define PS5UPLOAD_WEBUI_CLOUD_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+void webui_cloud_status(const char *b, size_t n, uint8_t *out, int fd);
+void webui_cloud_client(const char *b, size_t n, uint8_t *out, int fd);
+void webui_cloud_connect(const char *b, size_t n, uint8_t *out, int fd);
+void webui_cloud_disconnect(const char *b, size_t n, uint8_t *out, int fd);
+void webui_cloud_settings(const char *b, size_t n, uint8_t *out, int fd);
+void webui_cloud_run(const char *b, size_t n, uint8_t *out, int fd);
+void webui_cloud_list(const char *b, size_t n, uint8_t *out, int fd);
+void webui_cloud_fetch(const char *b, size_t n, uint8_t *out, int fd);
+void webui_cloud_profiles(const char *b, size_t n, uint8_t *out, int fd);
