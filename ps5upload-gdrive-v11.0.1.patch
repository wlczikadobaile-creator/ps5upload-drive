+
+/**
+ * Restoring a lost profile: the accounts the profiles files on Drive list, and, for one this PS5 no
+ * longer has, giving its ID to a profile made to replace it (asked first: that profile's own saves
+ * stay with its old ID). The saves then come back through "From other profiles" in a game's sheet.
+ */
+function ProfileRestore({ onClose }: { onClose: () => void }) {
+  const [data, setData] = useState<{ old: OldAccount[]; here: HereProfile[] } | null>(null);
+  const [error, setError] = useState<string | null>(null);
+  const [done, setDone] = useState<string | null>(null);
+  const [ask, setAsk] = useState<{ p: HereProfile; a: OldAccount } | null>(null);
+  const [busy, setBusy] = useState(false);
+  const live = useRef(true);
+  useEffect(() => {
+    live.current = true;
+    void loadProfiles()
+      .then((d) => live.current && setData(d))
+      .catch((e) => live.current && setError(t("cw_cloud_err", { why: cloudErrorText(e) })));
+    return () => {
+      live.current = false;
+    };
+  }, []);
+  const nameOf = (n: string) => n || t("cw_cloud_profile_unnamed");
+  const apply = async (p: HereProfile, a: OldAccount) => {
+    setBusy(true);
+    setError(null);
+    try {
+      const s = await cloudApi.applyAccount(p, a);
+      if (!live.current) return;
+      if (s.profiles) setData({ old: s.profiles.old, here: s.profiles.here });
+      setDone(t("cw_cloud_profile_done", { target: nameOf(p.name), id: a.id }));
+    } catch (e) {
+      if (live.current) setError(t("cw_cloud_err", { why: cloudErrorText(e) }));
+    }
+    if (live.current) setBusy(false);
+  };
+  const targets = data?.here.filter((h) => h.slot > 0) ?? [];
+  return (
+    <div className="cw-cloud-profiles" data-cloud-profiles="">
+      <h3 className="cw-libview-h3">
+        <UserRound aria-hidden />
+        <span>{t("cw_cloud_profile_h")}</span>
+      </h3>
+      <p className="cw-dim">{t("cw_cloud_profile_note")}</p>
+      {done ? (
+        <div className="cw-msg is-info" role="status">
+          {done}
+        </div>
+      ) : null}
+      {!data && !error ? <p className="cw-dim">{t("cw_cloud_loading")}</p> : null}
+      {data && !data.old.length ? <p className="cw-dim">{t("cw_cloud_profile_none")}</p> : null}
+      {data?.old.length ? (
+        <ul className="cw-libparts cw-saves-list">
+          {data.old.map((a) => {
+            const here = data.here.find((h) => h.id.toLowerCase() === a.id.toLowerCase());
+            return (
+              <li key={a.id} className="cw-libpart" data-old-account={a.id}>
+                <div className="cw-libpart-text">
+                  <span className="cw-libpart-name">{nameOf(a.name)}</span>
+                  {here ? <span className="cw-tag">{t("cw_cloud_profile_here", { name: nameOf(here.name) })}</span> : null}
+                  <span className="cw-libpart-meta cw-dim">
+                    {a.id}
+                    {a.uid ? ` · ${t("cw_cloud_profile_folder", { uid: a.uid })}` : ""}
+                    {Number.isFinite(stampTime(a.stamp)) ? ` · ${new Date(stampTime(a.stamp)).toLocaleString()}` : ""}
+                  </span>
+                </div>
+                {here ? null : (
+                  <span className="cw-libpart-actions">
+                    {targets.map((p) => (
+                      <button
+                        key={p.uid}
+                        type="button"
+                        className="cw-focusable cw-button"
+                        data-action="cloud-give-account"
+                        disabled={busy}
+                        onClick={() => setAsk({ p, a })}
+                      >
+                        <span>{t("cw_cloud_profile_give", { name: nameOf(p.name) })}</span>
+                      </button>
+                    ))}
+                  </span>
+                )}
+              </li>
+            );
+          })}
+        </ul>
+      ) : null}
+      {data && data.old.length && !targets.length ? <p className="cw-dim">{t("cw_cloud_profile_noslot")}</p> : null}
+      {error ? (
+        <p className="cw-field-error" role="alert">
+          {error}
+        </p>
+      ) : null}
+      <div className="cw-saves-actions">
+        <button type="button" className="cw-focusable cw-button" data-action="cloud-profiles-close" onClick={onClose}>
+          <span>{t("cw_files_close")}</span>
+        </button>
+      </div>
+      {ask ? (
+        <ConfirmDialog
+          title={t("cw_cloud_profile_confirm_title")}
+          body={t("cw_cloud_profile_confirm_body", { target: nameOf(ask.p.name), id: ask.a.id, old: nameOf(ask.a.name) })}
+          confirmLabel={t("cw_cloud_profile_give", { name: nameOf(ask.p.name) })}
+          danger
+          busy={busy}
+          onConfirm={() => {
+            const x = ask;
+            setAsk(null);
+            void apply(x.p, x.a);
+          }}
+          onCancel={() => setAsk(null)}
+        />
+      ) : null}
+    </div>
+  );
+}
+
+/**
+ * A game's backups on Google Drive, in its save sheet: listed on request, each one restored through
+ * the section (`onRestore`: it asks first, fetches the backup to the console, then restores it).
+ */
+export function CloudBackups({
+  user,
+  titleId,
+  disabled,
+  running,
+  onRestore,
+}: {
+  user: string;
+  titleId: string;
+  disabled: boolean;
+  running: boolean;
+  onRestore: (f: CloudFile) => void;
+}) {
+  const [files, setFiles] = useState<CloudFile[] | null>(null);
+  const [loading, setLoading] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+  const live = useRef(true);
+  useEffect(() => {
+    live.current = true;
+    return () => {
+      live.current = false;
+    };
+  }, []);
+  const load = async () => {
+    setLoading(true);
+    setError(null);
+    try {
+      const l = await listCloud(user, titleId);
+      if (live.current) setFiles(l);
+    } catch (e) {
+      if (live.current) setError(t("cw_cloud_err", { why: cloudErrorText(e) }));
+    }
+    if (live.current) setLoading(false);
+  };
+  const own = files?.filter((f) => !otherProfile(f, user)) ?? [];
+  const others = files?.filter((f) => otherProfile(f, user)) ?? [];
+  const row = (f: CloudFile) => {
+    const from = otherProfile(f, user);
+    return (
+      <li key={f.id} className="cw-libpart" data-cloud-backup={f.stamp} data-cloud-from={from ?? undefined}>
+        <div className="cw-libpart-text">
+          <span className="cw-libpart-name">{Number.isFinite(stampTime(f.stamp)) ? new Date(stampTime(f.stamp)).toLocaleString() : f.stamp}</span>
+          {from ? <span className="cw-tag">{t("cw_cloud_profile", { id: from })}</span> : null}
+          <span className="cw-libpart-meta cw-dim">{formatBytes(f.size)}</span>
+        </div>
+        <span className="cw-libpart-actions">
+          <button type="button" className="cw-focusable cw-button" data-action="cloud-restore" disabled={disabled || running} onClick={() => onRestore(f)}>
+            <ArchiveRestore aria-hidden />
+            <span>{t("cw_saves_restore")}</span>
+          </button>
+        </span>
+      </li>
+    );
+  };
+  return (
+    <>
+      <h3 className="cw-libview-h3">
+        <CloudDownload aria-hidden />
+        <span>{t("cw_cloud_list_h")}</span>
+      </h3>
+      {files === null ? (
+        <div className="cw-saves-actions">
+          <button type="button" className="cw-focusable cw-button" data-action="cloud-list" disabled={loading} onClick={() => void load()}>
+            <CloudDownload aria-hidden />
+            <span>{loading ? t("cw_cloud_loading") : t("cw_cloud_list")}</span>
+          </button>
+        </div>
+      ) : (
+        <>
+          {own.length ? <ul className="cw-libparts cw-saves-list">{own.map(row)}</ul> : <p className="cw-dim">{t("cw_cloud_none")}</p>}
+          {others.length ? (
+            <>
+              <h3 className="cw-libview-h3">
+                <CloudDownload aria-hidden />
+                <span>{t("cw_cloud_others_h")}</span>
+              </h3>
+              <p className="cw-dim">{t("cw_cloud_others_note")}</p>
+              <ul className="cw-libparts cw-saves-list">{others.map(row)}</ul>
+            </>
+          ) : null}
+        </>
+      )}
+      {error ? (
+        <p className="cw-field-error" role="alert">
+          {error}
+        </p>
+      ) : null}
+    </>
+  );
+}
