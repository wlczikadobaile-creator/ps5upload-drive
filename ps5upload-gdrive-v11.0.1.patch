+/** Why a Google Drive call failed, as one line. */
+export function cloudErrorText(e: unknown): string {
+  if (e instanceof ApiError) {
+    if (e.code === "busy") return t("cw_cloud_busy");
+    if (e.code === "no_client") return t("cw_cloud_setup");
+  }
+  return errorText(e) || (e instanceof ApiError ? e.code : String(e));
+}
+
+const when = (unixS: number) => new Date(unixS * 1000).toLocaleString();
+const intervalText = (m: number) => (m % 60 === 0 ? t("cw_cloud_hours", { n: m / 60 }) : t("cw_cloud_minutes", { n: m }));
+
+type Prompt = { kind: "id" } | { kind: "secret"; id: string } | null;
+
+/**
+ * Why `v` cannot be the client secret, or null: it is empty (the saved one would be kept, and a new
+ * client never matches an old secret), or it is the client ID pasted again.
+ */
+export function secretProblem(v: string): string | null {
+  const s = v.trim();
+  if (!s || /\.apps\.googleusercontent\.com$/i.test(s) || /\s/.test(s)) return t("cw_cloud_secret_hint");
+  return null;
+}
+
+/** The address a phone opens to enter `code` (Google's device page, the code filled in where it takes one). */
+export function deviceUrl(url: string, code: string): string {
+  return `${url}${url.includes("?") ? "&" : "?"}user_code=${encodeURIComponent(code)}`;
+}
+
+/** The sign-in code as a QR code of Google's page (scanned with a phone, as YouTube's TV sign-in does) and as text. */
+function SignInCode({ url, code }: { url: string; code: string }) {
+  const path = useMemo(() => {
+    try {
+      const q = encodeQr(deviceUrl(url, code), "M");
+      return { d: qrPath(q), n: q.size + 8 };
+    } catch {
+      return null;
+    }
+  }, [url, code]);
+  return (
+    <div className="cw-msg is-info" role="status">
+      <div className="cw-phone" data-cloud-qr="">
+        {path ? (
+          <svg viewBox={`0 0 ${path.n} ${path.n}`} role="img" aria-label={url} shapeRendering="crispEdges">
+            <rect width={path.n} height={path.n} fill="#fff" />
+            <path d={path.d} fill="#000" />
+          </svg>
+        ) : null}
+        <div>
+          <p>{t("cw_cloud_code", { url })}</p>
+          <p className="cw-h1 cw-mono">{code}</p>
+        </div>
+      </div>
+    </div>
+  );
+}
